@model SterlingLams.Web.Models.ViewModels.CartViewModel
@inject SterlingLams.Web.Services.ISettingsService SettingsService
@{
    ViewData["Title"] = "Shopping Bag";
    // Ordering is checkout-only. WhatsApp is for enquiries/complaints (the floating support button),
    // not for placing orders — so there's no "Order on WhatsApp" here.
}

<div class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
        <h1 class="font-cormorant text-4xl font-light">Shopping Bag</h1>
    </div>

    @if (TempData["CartMessage"] != null)
    {
        <div class="mb-8 px-4 py-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-md text-center">@TempData["CartMessage"]</div>
    }

    @if (Model.IsEmpty && !Model.SavedItems.Any())
    {
        <div class="text-center py-24">
            <p class="text-neutral-400 mb-8 font-light">Your bag is empty.</p>
            <a asp-controller="Products" asp-action="Index" class="btn-primary">Continue Shopping</a>
        </div>
    }
    else
    {
        @Html.AntiForgeryToken()
        @if (!Model.IsEmpty)
        {
        <div class="space-y-6 mb-12">
            @foreach (var item in Model.Items)
            {
                <div class="flex gap-6 py-6 border-b border-neutral-100">
                    <img src="@Img.Cld(item.ImageUrl, 224, 224)" alt="@item.ProductName"
                         loading="lazy" decoding="async" width="112" height="112"
                         class="w-28 h-28 object-cover flex-shrink-0" />
                    <div class="flex-1 min-w-0">
                        <h3 class="font-light text-neutral-800 mb-1">@item.ProductName</h3>
                        @if (!string.IsNullOrEmpty(item.VariantName))
                        {
                            <p class="text-xs text-neutral-400 mb-2">@item.VariantName</p>
                        }
                        <p class="text-sm text-neutral-600 mb-4">@item.FormattedUnitPrice</p>
                        <div class="flex items-center gap-4">
                            <div class="flex items-center border border-neutral-200">
                                <button class="qty-btn px-3 py-1 text-neutral-600 hover:bg-neutral-50"
                                        data-product-id="@item.ProductId"
                                        data-variant-id="@item.VariantId"
                                        data-delta="-1">−</button>
                                <span class="qty-display px-4 py-1 text-sm border-x border-neutral-200">@item.Quantity</span>
                                <button class="qty-btn px-3 py-1 text-neutral-600 hover:bg-neutral-50"
                                        data-product-id="@item.ProductId"
                                        data-variant-id="@item.VariantId"
                                        data-delta="1">+</button>
                            </div>
                            <form asp-controller="Cart" asp-action="SaveForLater" method="post" class="inline">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="variantId" value="@item.VariantId" />
                                <button type="submit" class="text-xs text-neutral-400 hover:text-neutral-900 transition-colors">Save for later</button>
                            </form>
                            <button class="remove-item text-xs text-neutral-400 hover:text-neutral-900 transition-colors"
                                    data-product-id="@item.ProductId"
                                    data-variant-id="@item.VariantId">
                                Remove
                            </button>
                        </div>
                    </div>
                    <div class="text-right flex-shrink-0">
                        <p class="line-total font-light text-neutral-800"
                           data-product-id="@item.ProductId" data-variant-id="@item.VariantId">@item.FormattedLineTotal</p>
                    </div>
                </div>
            }
        </div>

        <div class="border-t border-neutral-200 pt-8 flex flex-col md:flex-row justify-between gap-8">
            <div>
                <a asp-controller="Products" asp-action="Index"
                   class="text-xs tracking-widest uppercase text-brand-500 hover:text-brand-600 transition-colors">
                    ← Continue Shopping
                </a>
            </div>
            <div class="md:w-72">
                @* Discount-code entry lives on the Checkout page only (one place to apply a code,
                   no duplicate box). Any automatic promo still shows in the summary line below. *@
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-neutral-500">Subtotal</span>
                    <span id="subtotal-display" class="font-light">@Model.FormattedSubtotal</span>
                </div>
                @if (Model.HasDiscount)
                {
                    <div id="discount-line" class="flex justify-between text-sm mb-2">
                        <span class="text-emerald-600">@(Model.IsAutomaticDiscount ? "Promo" : "Discount") (@Model.DiscountDescription)</span>
                        <span id="discount-amount-display" class="text-emerald-600">@(Model.FreeShipping && Model.DiscountAmount == 0 ? "Free shipping" : Model.FormattedDiscount)</span>
                    </div>
                }
                else
                {
                    <div id="discount-line" class="hidden flex justify-between text-sm mb-2">
                        <span class="text-emerald-600">Discount (<span id="discount-code-label"></span>)</span>
                        <span id="discount-amount-display" class="text-emerald-600"></span>
                    </div>
                }
                <div class="flex justify-between text-sm font-medium border-t border-neutral-100 pt-3 mb-2">
                    <span>Total</span>
                    <span id="total-display" class="font-light">@Model.FormattedTotal</span>
                </div>
                <p class="text-xs text-neutral-400 mb-6">Shipping calculated at checkout.</p>
                <a asp-controller="Checkout" asp-action="Index"
                   class="block text-center bg-brand-500 text-white text-xs tracking-[0.2em] uppercase py-4 hover:bg-brand-600 transition-colors">
                    Proceed to Checkout
                </a>
            </div>
        </div>
        }

        @if (Model.SavedItems.Any())
        {
            <div class="@(Model.IsEmpty ? "" : "mt-16 pt-8 border-t border-neutral-200")">
                <h2 class="font-cormorant text-2xl font-light mb-6">Saved for later (@Model.SavedItems.Count)</h2>
                <div class="space-y-4">
                    @foreach (var item in Model.SavedItems)
                    {
                        <div class="flex gap-6 py-4 border-b border-neutral-100 items-center">
                            <img src="@Img.Cld(item.ImageUrl, 160, 160)" alt="@item.ProductName" loading="lazy" class="w-20 h-20 object-cover flex-shrink-0" />
                            <div class="flex-1 min-w-0">
                                <h3 class="font-light text-neutral-800">@item.ProductName</h3>
                                @if (!string.IsNullOrEmpty(item.VariantName))
                                {
                                    <p class="text-xs text-neutral-400">@item.VariantName</p>
                                }
                                <p class="text-sm text-neutral-600 mt-1">@item.FormattedUnitPrice</p>
                            </div>
                            <div class="flex items-center gap-4 flex-shrink-0">
                                <form asp-controller="Cart" asp-action="MoveToBag" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="variantId" value="@item.VariantId" />
                                    <button type="submit" class="text-xs tracking-widest uppercase text-neutral-700 hover:text-neutral-900 transition-colors">Move to bag</button>
                                </form>
                                <form asp-controller="Cart" asp-action="RemoveSaved" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="variantId" value="@item.VariantId" />
                                    <button type="submit" class="text-xs text-neutral-400 hover:text-neutral-900 transition-colors">Remove</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script nonce="@Context.Items["csp-nonce"]">
(function () {
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    // ── Quantity buttons ───────────────────────────────────────────────────
    document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const pid   = btn.dataset.productId;
            const vid   = btn.dataset.variantId ?? '';
            const delta = parseInt(btn.dataset.delta, 10);
            const display = btn.parentElement.querySelector('.qty-display');
            const newQty  = Math.max(0, parseInt(display.textContent, 10) + delta);

            const res  = await fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${pid}&variantId=${vid}&quantity=${newQty}&__RequestVerificationToken=${encodeURIComponent(token())}`
            });
            const data = await res.json();
            if (!data.success) return;
            if (newQty <= 0 || data.quantity <= 0) { location.reload(); return; }

            // Use the ACTUAL applied quantity — the server caps it to available stock, so if they
            // hit "+" past the limit the number simply holds instead of over-promising.
            display.textContent = data.quantity;
            const line = document.querySelector('.line-total[data-product-id="' + pid + '"][data-variant-id="' + vid + '"]');
            if (line) line.textContent = data.lineTotal;
            document.getElementById('subtotal-display').textContent = data.subtotal;
            document.getElementById('total-display').textContent    = data.total;
            const discAmt = document.getElementById('discount-amount-display');
            if (discAmt && data.hasDiscount) discAmt.textContent = data.discount;
            updateCartBadge(data.cartCount);
            if (data.capped && typeof showToast === 'function') {
                showToast('Only ' + data.maxQuantity + ' of this item ' + (data.maxQuantity === 1 ? 'is' : 'are') + ' available.');
            }
        });
    });

    // ── Remove item ────────────────────────────────────────────────────────
    document.querySelectorAll('.remove-item').forEach(btn => {
        btn.addEventListener('click', async () => {
            const pid = btn.dataset.productId;
            const vid = btn.dataset.variantId ?? '';
            const res = await fetch('/Cart/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `productId=${pid}&variantId=${vid}&__RequestVerificationToken=${encodeURIComponent(token())}`
            });
            const data = await res.json();
            if (data.success) location.reload();
        });
    });

    // Discount-code entry was moved to the Checkout page only — no apply/remove UI on the cart.
}());
</script>
}
