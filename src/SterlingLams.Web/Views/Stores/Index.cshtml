@model IList<SterlingLams.Web.Models.Domain.Store>
@{
    ViewData["Title"] = "Our Stores";
    // Show the minimal "Shop at Sterlin Glams / Need Help?" header on the store-locator page.
    ViewData["MinimalHeader"] = true;
    var mapStores = Model.Where(s => s.Latitude.HasValue && s.Longitude.HasValue).ToList();
    string J(object o) => System.Text.Json.JsonSerializer.Serialize(o);
    var mapData = mapStores.Select(s => new {
        name = s.Name,
        lat = s.Latitude!.Value,
        lng = s.Longitude!.Value,
        address = $"{s.Address}, {s.City}, {s.State}",
        dir = $"https://www.google.com/maps/dir/?api=1&destination={s.Latitude},{s.Longitude}"
    }).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.min.css" />
    <style>
        #stores-map { height: 420px; }
        @@media (max-width: 640px) { #stores-map { height: 300px; } }
        /* Brand teardrop pin (CSS only — no marker image needed). */
        .sg-pin { width: 26px; height: 26px; }
        .sg-pin span {
            display:block; width:22px; height:22px; margin:2px auto 0;
            background:#ed028b; border:2px solid #fff; border-radius:50% 50% 50% 0;
            transform: rotate(-45deg); box-shadow:0 2px 6px rgba(0,0,0,.3);
        }
        .leaflet-popup-content { font-family: inherit; }
        .leaflet-popup-content .sg-pop-name { font-weight:600; color:#171717; }
        .leaflet-popup-content .sg-pop-addr { color:#6b7280; font-size:12px; margin-top:2px; }
        .leaflet-popup-content a.sg-pop-dir { display:inline-block; margin-top:8px; font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:#ed028b; }
    </style>
}

<div class="max-w-5xl mx-auto px-6 py-10 md:py-14">
    <div class="text-center mb-8 md:mb-10">
        <p class="section-label">Visit us</p>
        <h1 class="font-cormorant text-5xl font-light">Our Stores</h1>
    </div>

    @if (mapStores.Count > 0)
    {
        <!-- Interactive map: pins for every store, zoom + pan, click a pin for details & directions. -->
        <div id="stores-map" class="mb-12 rounded-sm overflow-hidden border border-neutral-100" role="img" aria-label="Map of Sterlin Glams store locations"></div>
    }

    <div class="grid md:grid-cols-3 gap-8">
        @foreach (var store in Model)
        {
            <div class="border border-neutral-100 p-8 hover:border-neutral-400 transition-colors">
                <div class="w-10 h-10 rounded-full bg-neutral-100 flex items-center justify-center mb-6">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
                <h2 class="font-cormorant text-2xl font-light mb-3">@store.Name</h2>
                <p class="text-sm text-neutral-500 font-light mb-2">@store.Address</p>
                <p class="text-sm text-neutral-500 font-light mb-6">@store.City, @store.State</p>

                @if (!string.IsNullOrEmpty(store.OpeningHours))
                {
                    <p class="text-xs text-neutral-400 mb-4 tracking-wide">@store.OpeningHours</p>
                }

                @if (!string.IsNullOrEmpty(store.Phone))
                {
                    <a href="tel:@store.Phone" class="text-xs tracking-widest uppercase text-neutral-600 hover:text-neutral-900 transition-colors">
                        @store.Phone
                    </a>
                }

                @if (store.Latitude.HasValue && store.Longitude.HasValue)
                {
                    <a href="https://www.google.com/maps/dir/?api=1&destination=@store.Latitude,@store.Longitude"
                       target="_blank" rel="noopener"
                       class="mt-4 block text-xs tracking-widest uppercase border border-neutral-300 text-center py-2 hover:border-neutral-900 transition-colors">
                        Get Directions
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (mapStores.Count > 0)
    {
        <script src="~/lib/leaflet/leaflet.min.js" nonce="@Context.Items["csp-nonce"]"></script>
        <script nonce="@Context.Items["csp-nonce"]">
        (function () {
            var stores = @Html.Raw(J(mapData));
            if (!stores.length || typeof L === 'undefined') return;
            function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }

            var map = L.map('stores-map', { scrollWheelZoom: false, zoomControl: true });
            // OpenStreetMap standard tiles — free and keyless (CARTO's basemap now needs an API key).
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                subdomains: 'abc', maxZoom: 19
            }).addTo(map);

            var icon = L.divIcon({ className: 'sg-pin', html: '<span></span>', iconSize: [26, 26], iconAnchor: [13, 24], popupAnchor: [0, -22] });
            var bounds = [];
            stores.forEach(function (s) {
                L.marker([s.lat, s.lng], { icon: icon, title: s.name }).addTo(map)
                    .bindPopup('<div class="sg-pop-name">' + esc(s.name) + '</div>'
                        + '<div class="sg-pop-addr">' + esc(s.address) + '</div>'
                        + '<a class="sg-pop-dir" target="_blank" rel="noopener" href="' + esc(s.dir) + '">Get directions →</a>');
                bounds.push([s.lat, s.lng]);
            });
            if (bounds.length === 1) map.setView(bounds[0], 14);
            else map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });

            // Only zoom with the wheel once the map is focused/clicked, so page scroll isn't hijacked.
            map.on('focus', function () { map.scrollWheelZoom.enable(); });
            map.on('blur', function () { map.scrollWheelZoom.disable(); });
        }());
        </script>
    }
}
