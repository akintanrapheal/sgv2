@model IList<SterlingLams.Web.Models.Domain.Store>
@{
    ViewData["Title"] = "Our Stores";
    // Show the minimal "Shop at Sterlin Glams / Need Help?" header on the store-locator page.
    ViewData["MinimalHeader"] = true;
    var mapStores = Model.Where(s => s.Latitude.HasValue && s.Longitude.HasValue).ToList();
    var globeData = mapStores.Select(s => new { lat = s.Latitude!.Value, lng = s.Longitude!.Value }).ToList();
    string J(object o) => System.Text.Json.JsonSerializer.Serialize(o);
}

@section Styles {
    <style>
        /* Decorative globe behind the store list (Tiffany-style) — non-interactive backdrop. */
        #stores-globe-wrap { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
        #stores-globe { position: absolute; left: 50%; top: 40px; transform: translateX(-50%); opacity: .55; }
        @@media (max-width: 767px) { #stores-globe { top: 8px; opacity: .4; } }
    </style>
}

<div class="relative overflow-hidden">
    @if (globeData.Count > 0)
    {
        <div id="stores-globe-wrap" aria-hidden="true">
            <canvas id="stores-globe" data-stores="@Html.Raw(J(globeData))"></canvas>
        </div>
    }

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-10 md:py-14">
        <div class="text-center mb-8 md:mb-12">
            <p class="section-label text-brand-500">Visit us</p>
            <h1 class="font-cormorant text-5xl font-light">Our Stores</h1>
            <span class="mt-4 block mx-auto w-16 h-px bg-gradient-to-r from-transparent via-brand-400 to-transparent"></span>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var store in Model)
            {
                <div class="group relative flex flex-col rounded-lg border border-neutral-100 bg-white/85 backdrop-blur-sm p-6 transition-all duration-300 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-500/10 hover:-translate-y-1">
                    <!-- pink accent bar on hover -->
                    <span class="absolute inset-x-0 top-0 h-0.5 rounded-t-lg bg-brand-500 opacity-0 group-hover:opacity-100 transition-opacity"></span>

                    <div class="w-11 h-11 rounded-full bg-brand-50 ring-1 ring-brand-100 flex items-center justify-center mb-5 text-brand-500 group-hover:bg-brand-500 group-hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>

                    <h2 class="font-cormorant text-2xl font-light mb-2 group-hover:text-brand-600 transition-colors">@store.Name</h2>
                    <p class="text-sm text-neutral-500 font-light mb-1.5 leading-relaxed">@store.Address</p>
                    <p class="text-sm text-neutral-500 font-light mb-4">@store.City, @store.State</p>

                    @if (!string.IsNullOrEmpty(store.OpeningHours))
                    {
                        <p class="text-xs text-neutral-400 mb-3 tracking-wide">@store.OpeningHours</p>
                    }

                    @if (!string.IsNullOrEmpty(store.Phone))
                    {
                        <a href="tel:@store.Phone" class="text-xs tracking-widest uppercase text-neutral-600 hover:text-brand-500 transition-colors">
                            @store.Phone
                        </a>
                    }

                    <!-- push the button to the bottom so all cards' buttons align -->
                    @if (store.Latitude.HasValue && store.Longitude.HasValue)
                    {
                        <div class="mt-auto pt-5">
                            <a href="https://www.google.com/maps/dir/?api=1&destination=@store.Latitude,@store.Longitude"
                               target="_blank" rel="noopener"
                               class="block text-xs tracking-widest uppercase text-center font-medium rounded-sm bg-brand-500 text-white py-3 hover:bg-brand-600 transition-colors">
                                Get Directions
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @if (globeData.Count > 0)
    {
        <script src="~/lib/globe/d3-array.min.js" nonce="@Context.Items["csp-nonce"]"></script>
        <script src="~/lib/globe/d3-geo.min.js" nonce="@Context.Items["csp-nonce"]"></script>
        <script src="~/lib/globe/topojson-client.min.js" nonce="@Context.Items["csp-nonce"]"></script>
        <script nonce="@Context.Items["csp-nonce"]">
        (function () {
            var canvas = document.getElementById('stores-globe');
            if (!canvas || typeof d3 === 'undefined' || typeof topojson === 'undefined') return;
            var stores = [];
            try { stores = JSON.parse(canvas.dataset.stores || '[]'); } catch (_) {}

            var ctx = canvas.getContext('2d');
            var world = null;
            // Centre the globe on Nigeria so our locations face front.
            var centreLng = 8, centreLat = 9;

            fetch('/lib/globe/world-110m.json').then(function (r) { return r.json(); })
                .then(function (w) { world = w; draw(); })
                .catch(function () {});

            function sizeFor() {
                var wrap = canvas.parentElement;
                var w = wrap ? wrap.clientWidth : window.innerWidth;
                // A large, soft backdrop; capped so it stays tasteful.
                return Math.max(320, Math.min(w * 0.9, 760));
            }

            function draw() {
                if (!world) return;
                var size = sizeFor();
                var dpr = window.devicePixelRatio || 1;
                canvas.width = size * dpr; canvas.height = size * dpr;
                canvas.style.width = size + 'px'; canvas.style.height = size + 'px';
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                ctx.clearRect(0, 0, size, size);

                var projection = d3.geoOrthographic()
                    .scale(size / 2 - 2)
                    .translate([size / 2, size / 2])
                    .rotate([-centreLng, -centreLat]);
                var path = d3.geoPath(projection, ctx);

                // Sphere (ocean)
                ctx.beginPath(); path({ type: 'Sphere' }); ctx.fillStyle = '#f4f4f5'; ctx.fill();
                // Graticule
                ctx.beginPath(); path(d3.geoGraticule10()); ctx.strokeStyle = 'rgba(0,0,0,0.045)'; ctx.lineWidth = 0.6; ctx.stroke();
                // Land
                var land = topojson.feature(world, world.objects.countries);
                ctx.beginPath(); path(land); ctx.fillStyle = '#e2e2e5'; ctx.fill();
                // Country borders
                ctx.beginPath(); path(topojson.mesh(world, world.objects.countries, function (a, b) { return a !== b; }));
                ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 0.5; ctx.stroke();
                // Sphere outline
                ctx.beginPath(); path({ type: 'Sphere' }); ctx.strokeStyle = 'rgba(0,0,0,0.06)'; ctx.lineWidth = 1; ctx.stroke();

                // Store pins (brand pink), only when on the visible hemisphere.
                var centre = [centreLng, centreLat];
                stores.forEach(function (s) {
                    if (d3.geoDistance([s.lng, s.lat], centre) > Math.PI / 2) return; // back of globe
                    var p = projection([s.lng, s.lat]);
                    if (!p) return;
                    ctx.beginPath(); ctx.arc(p[0], p[1], 5, 0, 2 * Math.PI);
                    ctx.fillStyle = '#ed028b'; ctx.fill();
                    ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 1.5; ctx.stroke();
                });
            }

            var t;
            window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(draw, 150); });
        }());
        </script>
    }
}
