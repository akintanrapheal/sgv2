@using SterlingLams.Web.Services
@using SterlingLams.Web.Models.ViewModels
@inject ISettingsService SettingsService
@{
    // Cart / wishlist counts and signed-in state are NOT rendered here: the storefront's big
    // pages are output-cached, so per-user bits would be wrong. They're loaded client-side from
    // /site/header-state (see app.js) which fills the badges + swaps the account UI on every load.
    var announcementEnabled = await SettingsService.GetBoolAsync("announcement.enabled", true);
    var announcementText    = await SettingsService.GetAsync("announcement.text", "COMPLIMENTARY SHIPPING ON ORDERS OVER N150,000  |  IN-STORE PICKUP AVAILABLE");
    var announcementBg      = await SettingsService.GetAsync("announcement.bg_color", "bg-brand-500");
    if (string.IsNullOrWhiteSpace(announcementBg)) { announcementBg = "bg-brand-500"; }

    // Top-bar mega-menu grouping lives in StoreMenu so the shop-page sidebar accordion stays in sync.
    var megaMenu = SterlingLams.Web.Infrastructure.StoreMenu.Entries;

    // Cart icon: admin-chosen style + whether it sits in a filled pink button or stands alone.
    var cartStyle = SterlingLams.Web.Infrastructure.SettingsSelectOptions.Coerce("cart.icon_style",
        await SettingsService.GetAsync("cart.icon_style", "trolley-solid"));
    var cartPink = await SettingsService.GetBoolAsync("cart.icon_pink_button", true);
    string CartSvg(string style) => style switch
    {
        "trolley-outline" => "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-.534 1.872-1.683 1.872-2.946 0-1.66-1.34-3-3-3H6.272M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z\"/></svg>",
        "bag" => "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z\"/></svg>",
        "bag-solid" => "<svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" d=\"M7.5 6v.75H5.513c-.96 0-1.764.724-1.865 1.679l-1.263 12A1.875 1.875 0 004.25 22.5h15.5a1.875 1.875 0 001.865-2.071l-1.263-12a1.875 1.875 0 00-1.865-1.679H16.5V6a4.5 4.5 0 10-9 0zM12 3a3 3 0 00-3 3v.75h6V6a3 3 0 00-3-3zm-3 8.25a3 3 0 106 0v-.75a.75.75 0 011.5 0v.75a4.5 4.5 0 11-9 0v-.75a.75.75 0 011.5 0v.75z\" clip-rule=\"evenodd\"/></svg>",
        "basket" => "<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5.25 8.25h13.5l-1.153 9.226a2.25 2.25 0 01-2.233 1.974H8.636a2.25 2.25 0 01-2.233-1.974L5.25 8.25zM9 8.25 12 3.75l3 4.5M9.75 11.25v4.5M14.25 11.25v4.5\"/></svg>",
        _ => "<svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M2.25 2.25a.75.75 0 000 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 00-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 000-1.5H5.378A2.25 2.25 0 017.5 15h11.218a.75.75 0 00.674-.421 60.358 60.358 0 002.96-7.228.75.75 0 00-.525-.965A60.864 60.864 0 005.68 4.509l-.232-.867A1.875 1.875 0 003.636 2.25H2.25zM3.75 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM16.5 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0z\"/></svg>",
    };

    // Contact-us panel details (bell icon → slide-over).
    var contactPhone = await SettingsService.GetAsync("general.contact_phone");
    var contactEmail = await SettingsService.GetAsync("general.contact_email");
    var contactWa    = await SettingsService.GetAsync("general.whatsapp_number");
    var contactWaDigits = new string((contactWa ?? "").Where(char.IsDigit).ToArray());
}

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-100">
    <!-- Top bar -->
    @if (announcementEnabled)
    {
        <div class="@announcementBg text-white text-xs text-center py-2 tracking-widest font-light">
            @announcementText
        </div>
    }

    <!-- Row 1: hamburger + search (left) · brand (centre) · contact + cart (right) — Tiffany-style -->
    <div class="relative flex items-center px-4 sm:px-6 py-4">

        <!-- LEFT: hamburger (mobile) + search -->
        <div class="flex items-center gap-3 sm:gap-4 flex-shrink-0">
            <button id="mobile-menu-toggle" class="md:hidden text-neutral-600" aria-label="Menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
            <button id="search-toggle" aria-label="Search" class="text-neutral-600 hover:text-brand-500 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                </svg>
            </button>
            <!-- Store locator (desktop) -->
            <a asp-controller="Stores" asp-action="Index" aria-label="Find a store"
               class="hidden md:inline-flex text-neutral-600 hover:text-brand-500 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                </svg>
            </a>
        </div>

        <!-- CENTRE: brand — centred, sized to sit neatly between the icon clusters (Tiffany-style);
             large on desktop where it's absolutely centred. px keeps it off the icons on phones. -->
        <a asp-controller="Home" asp-action="Index"
           class="flex-1 min-w-0 text-center px-2 md:flex-none md:absolute md:left-1/2 md:-translate-x-1/2 md:px-0">
            <span class="font-cormorant font-semibold uppercase text-neutral-900 whitespace-nowrap text-lg sm:text-2xl md:text-5xl lg:text-6xl tracking-[0.06em] sm:tracking-[0.18em] md:tracking-[0.3em]">
                Sterlin Glams
            </span>
        </a>

        <!-- RIGHT: contact bell + account (desktop only) + cart — Tiffany-style -->
        <div class="ml-auto flex items-center gap-3 sm:gap-4 md:gap-5 flex-shrink-0">
            <!-- Contact us (concierge bell) -->
            <button id="contact-toggle" aria-label="Contact us" class="text-neutral-600 hover:text-brand-500 transition-colors">
                <!-- Concierge / service bell (like Tiffany's "Need Help?") -->
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M3 20a1 1 0 0 1-1-1v-1a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1a1 1 0 0 1-1 1Z"/>
                    <path d="M20 16a8 8 0 1 0-16 0"/>
                    <path d="M12 4v4"/>
                    <path d="M10 4h4"/>
                </svg>
            </button>

            <!-- Account (desktop only) — a person icon either way; app.js swaps the link in/out. -->
            <div class="hidden md:flex items-center">
                <a data-auth="in" asp-controller="Account" asp-action="Profile" aria-label="My account"
                   class="hidden text-neutral-600 hover:text-brand-500 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </a>
                <a data-auth="out" asp-controller="Account" asp-action="Login" aria-label="Sign in"
                   class="text-neutral-600 hover:text-brand-500 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </a>
            </div>

            <!-- Cart — style + pink-button toggle chosen in Admin → Settings → Homepage -->
            @if (cartPink)
            {
                <a id="cart-link" asp-controller="Cart" asp-action="Index" aria-label="Shopping bag"
                   class="relative inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-brand-500 text-white hover:bg-brand-600 transition-colors">
                    @Html.Raw(CartSvg(cartStyle))
                    <span id="cart-badge"
                          class="hidden absolute -top-1.5 -right-1.5 bg-white text-brand-600 ring-1 ring-brand-200 text-[10px] font-semibold w-4 h-4 rounded-full flex items-center justify-center shadow-sm"></span>
                </a>
            }
            else
            {
                <a id="cart-link" asp-controller="Cart" asp-action="Index" aria-label="Shopping bag"
                   class="relative text-neutral-600 hover:text-brand-500 transition-colors">
                    @Html.Raw(CartSvg(cartStyle))
                    <span id="cart-badge"
                          class="hidden absolute -top-1.5 -right-1.5 bg-brand-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center"></span>
                </a>
            }
        </div>
    </div>

    <!-- Row 2: Mega-menu category nav (desktop only) -->
    <nav class="hidden md:flex items-center justify-center gap-7 lg:gap-9 border-t border-neutral-100 py-3">
        @foreach (var m in megaMenu)
        {
            if (m.Items.Count == 0)
            {
                <a href="@m.Href" class="relative text-xs tracking-widest uppercase text-neutral-600 hover:text-brand-500 transition-colors">
                    @if (m.Label == "New In")
                    {
                        <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-green-500 text-white text-[8px] leading-none px-1.5 py-0.5 rounded tracking-wider">LATEST</span>
                    }
                    @m.Label
                </a>
            }
            else
            {
                <div class="relative group">
                    @* The group label is itself a link to the combined listing (ExpandSlug rolls the
                       group parent slug up to every sub-category), while hover still opens the panel. *@
                    <a asp-controller="Products" asp-action="Index" asp-route-category="@m.Label.ToLowerInvariant()"
                       class="flex items-center gap-1 text-xs tracking-widest uppercase text-neutral-600 group-hover:text-brand-500 transition-colors">
                        @m.Label
                        <svg class="w-3 h-3 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                    <!-- pt-3 forms a hover bridge so the panel stays open between button and list -->
                    <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 hidden group-hover:block z-50">
                        <div class="bg-neutral-900 min-w-[230px] py-2 shadow-xl">
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@m.Label.ToLowerInvariant()"
                               class="block px-5 py-2.5 text-sm text-brand-400 hover:bg-neutral-800 hover:text-brand-300 transition-colors whitespace-nowrap">All @m.Label</a>
                            @foreach (var (label, slug) in m.Items)
                            {
                                <a asp-controller="Products" asp-action="Index" asp-route-category="@slug"
                                   class="block px-5 py-2.5 text-sm text-neutral-200 hover:bg-neutral-800 hover:text-white transition-colors whitespace-nowrap">@label</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </nav>

    <!-- Mobile menu (accordion) -->
    <div id="mobile-menu" class="md:hidden hidden border-t border-neutral-100 bg-white px-6 py-2 flex flex-col max-h-[70vh] overflow-y-auto">
        @foreach (var m in megaMenu)
        {
            if (m.Items.Count == 0)
            {
                <a href="@m.Href" class="py-3.5 text-sm tracking-[0.15em] uppercase text-neutral-700 border-b border-neutral-100">@m.Label</a>
            }
            else
            {
                <details class="border-b border-neutral-100 group">
                    <summary class="cursor-pointer list-none py-3.5 flex items-center justify-between text-sm tracking-[0.15em] uppercase text-neutral-700">
                        @m.Label
                        <svg class="w-4 h-4 text-neutral-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/></svg>
                    </summary>
                    <div class="pb-3 pl-3 flex flex-col">
                        <a asp-controller="Products" asp-action="Index" asp-route-category="@m.Label.ToLowerInvariant()" class="py-2 text-sm text-brand-500">All @m.Label</a>
                        @foreach (var (label, slug) in m.Items)
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@slug" class="py-2 text-sm text-neutral-500">@label</a>
                        }
                    </div>
                </details>
            }
        }
        <a asp-controller="Stores" asp-action="Index" class="py-3.5 text-sm tracking-[0.15em] uppercase text-neutral-700 border-b border-neutral-100">Our Stores</a>
        <a asp-controller="Wishlist" asp-action="Index" class="py-3.5 text-sm tracking-[0.15em] uppercase text-neutral-700 border-b border-neutral-100">Wishlist</a>
        <a data-auth="in" asp-controller="Account" asp-action="Profile" class="hidden py-3.5 text-sm tracking-[0.15em] uppercase text-neutral-700">My Account</a>
        <a data-auth="out" asp-controller="Account" asp-action="Login" class="py-3.5 text-sm tracking-[0.15em] uppercase text-neutral-700">Sign In</a>
    </div>

    <!-- ─── Contact Us panel (bell icon) — slide-over from the right ──────────── -->
    <div id="contact-panel" class="hidden fixed inset-0 z-[220]" role="dialog" aria-modal="true" aria-label="Contact us">
        <div id="contact-backdrop" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300"></div>
        <div id="contact-panel-inner"
             class="absolute top-0 right-0 h-full w-[88vw] max-w-sm bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300">
            <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-100 flex-shrink-0">
                <h2 class="font-cormorant text-2xl font-light text-neutral-900">Contact Us</h2>
                <button type="button" id="contact-close" aria-label="Close"
                        class="text-neutral-400 hover:text-neutral-800 text-2xl leading-none">&times;</button>
            </div>
            <div class="flex-1 overflow-y-auto divide-y divide-neutral-100">
                @if (!string.IsNullOrWhiteSpace(contactWaDigits))
                {
                    <a href="https://wa.me/@contactWaDigits" target="_blank" rel="noopener"
                       class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                        <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                        <span class="flex-1 text-sm tracking-[0.12em] uppercase text-neutral-800">Chat on WhatsApp</span>
                        <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(contactPhone))
                {
                    <a href="tel:@contactPhone.Replace(" ", "")"
                       class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                        <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                        <span class="flex-1">
                            <span class="block text-sm tracking-[0.12em] uppercase text-neutral-800">Call us</span>
                            <span class="block text-xs text-neutral-400 mt-0.5">@contactPhone</span>
                        </span>
                        <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(contactEmail))
                {
                    <a href="mailto:@contactEmail"
                       class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                        <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                        <span class="flex-1">
                            <span class="block text-sm tracking-[0.12em] uppercase text-neutral-800">Email us</span>
                            <span class="block text-xs text-neutral-400 mt-0.5 normal-case tracking-normal">@contactEmail</span>
                        </span>
                        <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                }
                <a asp-controller="Stores" asp-action="Index"
                   class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                    <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                    <span class="flex-1 text-sm tracking-[0.12em] uppercase text-neutral-800">Visit a store</span>
                    <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </div>
</header>

<!-- Search Overlay -->
<div id="search-overlay" class="hidden fixed inset-0 z-[200]" role="dialog" aria-modal="true" aria-label="Search">
    <!-- Backdrop -->
    <div id="search-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <!-- Panel -->
    <div class="relative bg-white w-full shadow-xl px-6 py-8">
        <form id="search-form" action="/Products" method="get" class="max-w-2xl mx-auto">
            <div class="flex items-center border-b-2 border-brand-500 gap-4">
                <svg class="w-5 h-5 text-neutral-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                </svg>
                <input id="search-input" name="search" type="search" autocomplete="off"
                       placeholder="Search rings, necklaces, diamonds…"
                       class="flex-1 py-3 text-lg text-neutral-900 placeholder-neutral-400 bg-transparent outline-none font-light tracking-wide"/>
                <button type="button" id="search-close"
                        class="text-neutral-400 hover:text-neutral-900 transition-colors p-1" aria-label="Close search">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div id="search-suggestions" class="mt-3 text-sm text-neutral-500 font-light tracking-wide max-h-[60vh] overflow-y-auto"></div>
        </form>
        <!-- Quick links -->
        <div class="max-w-2xl mx-auto mt-6">
            <p class="text-xs tracking-[0.25em] uppercase text-neutral-400 mb-3">Popular</p>
            <div class="flex flex-wrap gap-2">
