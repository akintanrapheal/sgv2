@inject SterlingLams.Web.Services.ISettingsService SettingsService
@{
    // Concierge Help widget with a real two-way LIVE CHAT. A floating bubble opens a panel that auto-greets
    // the shopper and offers quick replies; the text box is an in-page live chat — messages go to the admin
    // inbox (Admin → Chat Messages) and staff replies come back here by polling, so a shopper with no
    // WhatsApp can still talk to the team. "Chat on WhatsApp" stays as an option. Storefront-only; no
    // third-party script (CSP-clean: nonce'd inline script, scoped sgc- CSS). See storefront ChatController.
    var chatEnabled = await SettingsService.GetAsync("chat.enabled", "true");
    var greeting    = await SettingsService.GetAsync("chat.greeting",
        "Hi 👋 Welcome to Sterlin Glams! Got a question about an order, delivery, sizing or a piece you love? We're here to help.");
    var siteName    = await SettingsService.GetAsync("general.site_name", "Sterlin Glams");
    var waRaw       = await SettingsService.GetAsync("general.whatsapp_number");
    var waDigits    = new string((waRaw ?? "").Where(char.IsDigit).ToArray());
    var email       = await SettingsService.GetAsync("general.contact_email");

    var show = !string.Equals(chatEnabled, "false", StringComparison.OrdinalIgnoreCase);
    var waBase = string.IsNullOrWhiteSpace(waDigits) ? "" : $"https://wa.me/{waDigits}";
}
@if (show)
{
<style>
    .sgc-launch { position:fixed; bottom:24px; right:24px; z-index:120; display:inline-flex; align-items:center; gap:8px;
        padding:12px 18px 12px 14px; border:0; border-radius:9999px; cursor:pointer; color:#fff; background:#ed028b;
        box-shadow:0 8px 24px rgba(237,2,139,.35); font:600 14px/1 ui-sans-serif,system-ui,sans-serif; letter-spacing:.02em; }
    .sgc-launch:hover { background:#c70175; }
    .sgc-launch svg { width:22px; height:22px; display:block; }
    .sgc-launch .sgc-dot { position:absolute; top:-2px; right:-2px; width:12px; height:12px; border-radius:9999px;
        background:#25D366; border:2px solid #fff; }
    .sgc-unread { position:absolute; top:-6px; right:-6px; min-width:18px; height:18px; padding:0 4px; border-radius:9999px;
        background:#dc2626; color:#fff; font:700 11px/18px ui-sans-serif,system-ui,sans-serif; text-align:center; display:none; }
    .sgc-panel { position:fixed; bottom:92px; right:24px; z-index:121; width:min(92vw,23rem); height:min(72vh,34rem);
        display:none; flex-direction:column; background:#fff; border-radius:18px; overflow:hidden;
        box-shadow:0 18px 60px rgba(0,0,0,.28); opacity:0; transform:translateY(12px) scale(.98);
        transition:opacity .22s ease, transform .22s ease; }
    .sgc-panel.sgc-open { display:flex; }
    .sgc-panel.sgc-in { opacity:1; transform:translateY(0) scale(1); }
    .sgc-head { background:#ed028b; color:#fff; padding:16px 18px; display:flex; align-items:center; gap:12px; flex-shrink:0; }
    .sgc-head .sgc-ava { width:40px; height:40px; border-radius:9999px; background:rgba(255,255,255,.18);
        display:flex; align-items:center; justify-content:center; flex-shrink:0; font-weight:700; }
    .sgc-head h3 { margin:0; font:600 16px/1.1 ui-sans-serif,system-ui,sans-serif; }
    .sgc-head p { margin:2px 0 0; font-size:11.5px; opacity:.9; display:flex; align-items:center; gap:6px; }
    .sgc-head .sgc-live { width:7px; height:7px; border-radius:9999px; background:#5bffa5; display:inline-block; }
    .sgc-min { margin-left:auto; background:transparent; border:0; color:#fff; cursor:pointer; font-size:26px; line-height:1;
        opacity:.85; padding:0 2px; }
    .sgc-min:hover { opacity:1; }
    .sgc-body { flex:1; overflow-y:auto; padding:16px; background:#f7f7f8; display:flex; flex-direction:column; gap:10px; }
    .sgc-row { display:flex; gap:8px; align-items:flex-end; }
    .sgc-row.sgc-me { justify-content:flex-end; }
    /* Wrapper caps width against the row (a definite width); the bubble itself has NO % width, so it
       hugs its text and never collapses a short word like "hello" into "hel/lo". */
    .sgc-msg { max-width:84%; min-width:0; }
    .sgc-me .sgc-msg { margin-left:auto; text-align:right; }
    .sgc-bubble { display:inline-block; text-align:left; padding:10px 13px; border-radius:14px; font-size:13.5px; line-height:1.5;
        color:#1f1f23; background:#fff; box-shadow:0 1px 2px rgba(0,0,0,.06); border-top-left-radius:4px;
        white-space:pre-wrap; overflow-wrap:break-word; }
    .sgc-me .sgc-bubble { background:#ed028b; color:#fff; border-top-left-radius:14px; border-top-right-radius:4px; }
    .sgc-bubble a.sgc-inline { color:inherit; text-decoration:underline; }
    .sgc-meta { font-size:10px; color:#9a9aa2; margin:2px 4px 0; }
    .sgc-quick { display:flex; flex-direction:column; gap:8px; margin-top:2px; }
    .sgc-chip { text-align:left; background:#fff; border:1px solid #f3d6e8; color:#b10f73; cursor:pointer;
        padding:10px 13px; border-radius:12px; font:600 13px/1.3 ui-sans-serif,system-ui,sans-serif; display:flex;
        align-items:center; gap:9px; transition:background .15s, border-color .15s; }
    .sgc-chip:hover { background:#fff0f8; border-color:#ed028b; }
    .sgc-chip svg { width:17px; height:17px; flex-shrink:0; }
    .sgc-chip.sgc-wa { color:#148a43; border-color:#cdeedd; }
    .sgc-chip.sgc-wa:hover { background:#edfbf3; border-color:#25D366; }
    .sgc-cta { display:inline-flex; align-items:center; gap:6px; margin-top:6px; background:#ed028b; color:#fff;
        text-decoration:none; padding:8px 12px; border-radius:10px; font:600 12.5px/1 ui-sans-serif,system-ui,sans-serif; border:0; cursor:pointer; }
    .sgc-cta:hover { background:#c70175; }
    .sgc-stars { display:flex; gap:4px; font-size:22px; margin:4px 0 2px; }
    .sgc-stars button { background:none; border:0; cursor:pointer; color:#f5b301; line-height:1; padding:0; }
    .sgc-review-comment { margin-top:8px; width:100%; box-sizing:border-box; border:1px solid #e2e2e8; border-radius:8px; padding:7px 10px; font-size:12.5px; outline:none; }
    .sgc-review-comment:focus { border-color:#ed028b; }
    .sgc-det { flex-shrink:0; background:#fff; border-top:1px solid #ececf0; padding:0 10px; }
    .sgc-det summary { list-style:none; cursor:pointer; font-size:11.5px; color:#8a8a92; padding:8px 2px; }
    .sgc-det summary::-webkit-details-marker { display:none; }
    .sgc-det[open] summary { color:#b10f73; }
    .sgc-det .sgc-fields { display:flex; gap:6px; padding:0 0 8px; }
    .sgc-det input { flex:1; min-width:0; border:1px solid #e2e2e8; border-radius:8px; padding:7px 10px; font-size:12.5px; outline:none; }
    .sgc-det input:focus { border-color:#ed028b; }
    .sgc-endedbar { flex-shrink:0; border-top:1px solid #ececf0; background:#fff; padding:12px; text-align:center;
        font-size:12.5px; color:#6b6b73; display:none; }
    .sgc-endedbar.sgc-on { display:block; }
    .sgc-endedbar .sgc-cta { margin:8px auto 0; }
    .sgc-foot.sgc-disabled { opacity:.5; pointer-events:none; }
    .sgc-foot { flex-shrink:0; border-top:1px solid #ececf0; background:#fff; padding:10px; display:flex; gap:8px; align-items:center; }
    .sgc-foot input { flex:1; border:1px solid #e2e2e8; border-radius:9999px; padding:10px 14px; font-size:13.5px; outline:none; }
    .sgc-foot input:focus { border-color:#ed028b; }
    .sgc-send { flex-shrink:0; width:38px; height:38px; border-radius:9999px; border:0; background:#ed028b; color:#fff;
        cursor:pointer; display:flex; align-items:center; justify-content:center; }
    .sgc-send:hover { background:#c70175; }
    .sgc-send svg { width:18px; height:18px; }
    .sgc-attach { flex-shrink:0; width:36px; height:36px; border-radius:9999px; border:0; background:#f1f1f4; color:#6b6b73;
        cursor:pointer; display:flex; align-items:center; justify-content:center; }
    .sgc-attach:hover { background:#e7e7ec; }
    .sgc-attach svg { width:18px; height:18px; }
    .sgc-bubble img { max-width:200px; max-height:220px; border-radius:10px; display:block; cursor:pointer; }
    @@media (max-width:420px){ .sgc-panel{ right:3vw; bottom:86px; width:94vw; height:72vh; } .sgc-launch{ right:16px; } }
    @@media (prefers-reduced-motion: reduce){ .sgc-panel{ transition:none; } }
</style>

<button type="button" class="sgc-launch" id="sgc-launch" aria-expanded="false" aria-controls="sgc-panel" aria-label="Open help chat">
    <span style="position:relative;display:inline-flex">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5M21 12a8 8 0 01-8 8H7l-4 3v-6.5A8 8 0 1121 12z"/>
        </svg>
        <span class="sgc-dot"></span>
        <span class="sgc-unread" id="sgc-unread"></span>
    </span>
    Chat
</button>

<div class="sgc-panel" id="sgc-panel" role="dialog" aria-modal="false" aria-label="Help chat with @siteName"
     data-wa="@waBase" data-track="/track" data-returns="@Url.Action("PaymentReturns", "Home")">
    <div class="sgc-head">
        <div class="sgc-ava">@(string.IsNullOrWhiteSpace(siteName) ? "SG" : siteName.Substring(0,1))</div>
        <div>
            <h3>@siteName</h3>
            <p><span class="sgc-live"></span> We usually reply within minutes</p>
        </div>
        <button type="button" class="sgc-min" id="sgc-min" aria-label="Minimise chat">&times;</button>
    </div>
    <div class="sgc-body" id="sgc-body">
        <div class="sgc-row">
            <div class="sgc-msg"><div class="sgc-bubble">@greeting</div></div>
        </div>
        <div class="sgc-row">
            <div class="sgc-msg"><div class="sgc-bubble" style="background:transparent;box-shadow:none;padding:4px 2px;color:#6b6b73;font-size:12px">
                Pick a topic below, or type your question — a real person will reply here.
            </div></div>
        </div>
        <div class="sgc-quick" id="sgc-quick">
            <button type="button" class="sgc-chip" data-sgc="track">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0zM3 4h2l2 11h10l2-7H6"/></svg>
                Track my order
            </button>
            <button type="button" class="sgc-chip" data-sgc="returns">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h13l-3-3m3 3l-3 3M21 17H8l3 3m-3-3l3-3"/></svg>
                Delivery &amp; returns
            </button>
            <button type="button" class="sgc-chip" data-sgc="sizing">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7l4-4 14 14-4 4L3 7zm4 0l2 2m2-2l2 2m2 2l2 2"/></svg>
                Sizing help
            </button>
            @if (!string.IsNullOrWhiteSpace(waBase))
            {
                <button type="button" class="sgc-chip sgc-wa" data-sgc="whatsapp">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
                    Chat on WhatsApp
                </button>
            }
        </div>
        <div id="sgc-thread"></div>
    </div>
    <details class="sgc-det" id="sgc-det">
        <summary>＋ Add your name &amp; email (so we can follow up)</summary>
        <div class="sgc-fields">
            <input type="text" id="sgc-name" placeholder="Your name" autocomplete="name" />
            <input type="email" id="sgc-email" placeholder="Email" autocomplete="email" />
        </div>
    </details>
    <div class="sgc-endedbar" id="sgc-ended-bar">
        This chat has ended.
        <button type="button" class="sgc-cta" id="sgc-newchat">Start a new chat</button>
    </div>
    <div class="sgc-foot">
        <input type="file" id="sgc-file" accept="image/jpeg,image/png,image/gif,image/webp" style="display:none" />
        <button type="button" class="sgc-attach" id="sgc-attach" aria-label="Attach a photo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <input type="text" id="sgc-input" placeholder="Type your message here" aria-label="Type your message" autocomplete="off" />
        <button type="button" class="sgc-send" id="sgc-send" aria-label="Send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
    </div>
</div>

<script nonce="@Context.Items["csp-nonce"]">
(function () {
    var launch = document.getElementById('sgc-launch');
    var panel  = document.getElementById('sgc-panel');
    if (!launch || !panel) return;
    var body = document.getElementById('sgc-body');
    var thread = document.getElementById('sgc-thread');
    var input = document.getElementById('sgc-input');
    var unreadEl = document.getElementById('sgc-unread');
    var foot = panel.querySelector('.sgc-foot');
    var endedBar = document.getElementById('sgc-ended-bar');
    var waBase = panel.getAttribute('data-wa') || '';
    var trackUrl = panel.getAttribute('data-track') || '/track';
    var returnsUrl = panel.getAttribute('data-returns') || '/';
    var siteName = (panel.querySelector('h3') && panel.querySelector('h3').textContent.trim()) || 'us';

    var lastId = 0, sending = false, polling = null, unread = 0, started = false,
        ended = false, reviewShown = false, reviewed = false, endedShown = false, paused = false;

    function esc(s){ var d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
    function wa(text){ return waBase ? (waBase + '?text=' + encodeURIComponent(text)) : ''; }
    function nowHM(){ var d=new Date(); return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2); }

    // A canned / informational bot bubble (self-service answers, not stored)
    function botRow(html){
        var r = document.createElement('div'); r.className = 'sgc-row';
        r.innerHTML = '<div class="sgc-msg"><div class="sgc-bubble">' + html + '</div><div class="sgc-meta">' + siteName + ' · ' + nowHM() + '</div></div>';
        thread.appendChild(r); body.scrollTop = body.scrollHeight;
    }
    // A real chat message bubble (mine = right, staff = left). May carry an image, text, or both.
    function msgRow(m){
        var r = document.createElement('div');
        r.className = 'sgc-row' + (m.fromStaff ? '' : ' sgc-me');
        var meta = m.fromStaff ? ((m.name || siteName) + (m.at ? ' · ' + m.at : '')) : (m.at || '');
        var inner = '';
        if (m.imageUrl) inner += '<a href="' + encodeURI(m.imageUrl) + '" target="_blank" rel="noopener"><img src="' + encodeURI(m.imageUrl) + '" alt="shared photo" loading="lazy"></a>';
        if (m.body) inner += (m.imageUrl ? '<div style="margin-top:6px">' : '') + esc(m.body) + (m.imageUrl ? '</div>' : '');
        if (!inner) inner = esc(m.body || '');
        r.innerHTML = '<div class="sgc-msg"><div class="sgc-bubble">' + inner + '</div>'
            + (meta ? '<div class="sgc-meta">' + esc(meta) + '</div>' : '')
            + '</div>';
        thread.appendChild(r); body.scrollTop = body.scrollHeight;
    }

    var opened = false;
    function open(){
        panel.classList.add('sgc-open');
        requestAnimationFrame(function(){ panel.classList.add('sgc-in'); });
        launch.setAttribute('aria-expanded','true');
        opened = true; clearUnread();
        startChat();
        setTimeout(function(){ if (input) input.focus(); body.scrollTop = body.scrollHeight; }, 180);
    }
    function close(){
        panel.classList.remove('sgc-in');
        launch.setAttribute('aria-expanded','false');
        setTimeout(function(){ panel.classList.remove('sgc-open'); }, 200);
    }
    launch.addEventListener('click', function(){ panel.classList.contains('sgc-open') ? close() : open(); });
    document.getElementById('sgc-min').addEventListener('click', close);
    document.addEventListener('keydown', function(e){ if (e.key==='Escape' && panel.classList.contains('sgc-open')) close(); });

    function clearUnread(){ unread = 0; if (unreadEl){ unreadEl.style.display='none'; unreadEl.textContent=''; } }
    function bumpUnread(){ unread++; if (unreadEl){ unreadEl.textContent = unread; unreadEl.style.display='block'; } }

    // ── Quick replies (self-service) ─────────────────────────────────────────
    var replies = {
        track: { say:'Track my order',
            bot:'You can check your order status any time with your order number and email:' +
                '<br><a class="sgc-cta" href="' + trackUrl + '">Track my order →</a>' },
        returns: { say:'Delivery & returns',
            bot:'We deliver nationwide, with same-day and express options at checkout. Items can be returned within our policy window if unworn.' +
                '<br><a class="sgc-cta" href="' + returnsUrl + '">Read delivery & returns →</a>' },
        sizing: { say:'Sizing help',
            bot: (document.getElementById('size-guide-overlay')
                    ? 'Happy to help you find the right fit. Here\'s our full size &amp; length guide:' +
                      '<br><button type="button" class="sgc-cta" data-sgc-open-size="1">Open size guide →</button>'
                    : 'Happy to help you find the right fit — tell me the piece and I\'ll check it for you below.') }
    };
    document.getElementById('sgc-quick').addEventListener('click', function(e){
        var btn = e.target.closest('[data-sgc]'); if (!btn) return;
        var key = btn.getAttribute('data-sgc');
        if (key === 'whatsapp'){
            var href = wa('Hi ' + siteName + ', I have a question.');
            if (href) window.open(href, '_blank', 'noopener');
            return;
        }
        var r = replies[key]; if (!r) return;
        msgRow({ body:r.say, fromStaff:false, at:nowHM() });
        setTimeout(function(){ botRow(r.bot); }, 200);
    });
    body.addEventListener('click', function(e){
        var o = e.target.closest('[data-sgc-open-size]'); if (!o) return;
        var opener = document.querySelector('[data-size-guide-open]');
        if (opener) opener.click();
        else { var ov = document.getElementById('size-guide-overlay'); if (ov) ov.classList.remove('hidden'); }
    });

    // ── Live chat (two-way) ──────────────────────────────────────────────────
    function startChat(){
        if (started) return; started = true;
        poll();                          // rebuild transcript (after=0) for a returning shopper
        polling = setInterval(poll, 5000);
    }
    async function poll(){
        if (sending || paused) return;
        try {
            var r = await fetch('/chat/thread?after=' + lastId, { headers:{ 'Accept':'application/json' } });
            if (!r.ok) return;
            var d = await r.json();
            (d.messages || []).forEach(function(m){
                if (m.id <= lastId) return;
                msgRow(m); lastId = m.id;
                if (m.fromStaff && !panel.classList.contains('sgc-open')) bumpUnread();
            });
            if (d.reviewed) reviewed = true;
            ended = !!d.ended;
            if (ended) enterEndedState();
        } catch (e) {}
    }

    // Chat ended (30-min inactivity or a review): lock the composer, invite a star review once, and show a
    // clear "Start a new chat" so the next message begins a fresh conversation instead of reopening a rated one.
    function enterEndedState(){
        if (endedShown) return; endedShown = true;
        if (!reviewed && !reviewShown) showReview();
        if (foot) foot.classList.add('sgc-disabled');
        if (input) input.disabled = true;
        if (endedBar) endedBar.classList.add('sgc-on');
        body.scrollTop = body.scrollHeight;
    }
    function resetChat(){
        thread.innerHTML = '';
        lastId = 0; ended = false; endedShown = false; reviewShown = false; reviewed = false; paused = true;
        if (endedBar) endedBar.classList.remove('sgc-on');
        if (foot) foot.classList.remove('sgc-disabled');
        if (input) { input.disabled = false; input.focus(); }
    }
    if (document.getElementById('sgc-newchat'))
        document.getElementById('sgc-newchat').addEventListener('click', resetChat);

    // After the chat ends, invite a quick star review.
    function showReview(){
        reviewShown = true;
        var box = document.createElement('div'); box.className = 'sgc-row';
        box.innerHTML = '<div class="sgc-msg" style="max-width:94%"><div class="sgc-bubble">' +
            '<div style="font-weight:600;margin-bottom:2px">This chat has ended.</div>' +
            '<div style="color:#6b6b73;font-size:12.5px">How did we do?</div>' +
            '<div class="sgc-stars" id="sgc-stars">' +
            [1,2,3,4,5].map(function(n){ return '<button type="button" data-star="' + n + '" aria-label="' + n + ' star">☆</button>'; }).join('') +
            '</div>' +
            '<input type="text" class="sgc-review-comment" id="sgc-review-comment" placeholder="Add a comment (optional)" />' +
            '<button type="button" class="sgc-cta" id="sgc-review-send">Send feedback</button>' +
            '</div><div class="sgc-meta">' + siteName + ' · ' + nowHM() + '</div></div>';
        thread.appendChild(box); body.scrollTop = body.scrollHeight;

        var rating = 0;
        var stars = box.querySelectorAll('[data-star]');
        stars.forEach(function(s){ s.addEventListener('click', function(){
            rating = +s.getAttribute('data-star');
            stars.forEach(function(x, i){ x.textContent = (i < rating) ? '★' : '☆'; });
        }); });
        box.querySelector('#sgc-review-send').addEventListener('click', function(){
            if (!rating) { var st = box.querySelector('#sgc-stars'); st.style.transform = 'scale(1.08)'; setTimeout(function(){ st.style.transform=''; }, 150); return; }
            var comment = (box.querySelector('#sgc-review-comment').value || '').trim();
            try { if (window.postWithFreshToken) window.postWithFreshToken('/chat/review', { rating: rating, comment: comment }).catch(function(){}); } catch (e) {}
            reviewed = true;
            box.innerHTML = '<div class="sgc-msg"><div class="sgc-bubble">Thank you for your feedback 💛</div><div class="sgc-meta">' + siteName + ' · ' + nowHM() + '</div></div>';
        });
    }

    function send(){
        var text = (input.value || '').trim(); if (!text) return;
        sending = true;
        msgRow({ body:text, fromStaff:false, at:nowHM() });
        input.value = '';
        var fields = { body:text, channel:'inapp' };
        var nm = (document.getElementById('sgc-name')||{}).value, em = (document.getElementById('sgc-email')||{}).value;
        if (nm && nm.trim()) fields.name = nm.trim();
        if (em && em.trim()) fields.email = em.trim();
        var done = function(d){ if (d && d.id && d.id > lastId) lastId = d.id; sending = false; paused = false; };
        try {
            if (window.postWithFreshToken) {
                window.postWithFreshToken('/chat/message', fields)
                    .then(function(r){ return r.json(); }).then(done).catch(function(){ sending = false; });
            } else { sending = false; }
        } catch (e) { sending = false; }
    }
    document.getElementById('sgc-send').addEventListener('click', send);
    input.addEventListener('keydown', function(e){ if (e.key==='Enter'){ e.preventDefault(); send(); } });

    // ── Share a photo ────────────────────────────────────────────────────────
    var fileInput = document.getElementById('sgc-file');
    async function uploadFile(file){
        if (!file) return;
        if (file.size > 5 * 1024 * 1024){ botRow('That image is too large — please send one under 5 MB.'); return; }
        sending = true;
        try {
            var fd = new FormData();
            fd.append('file', file);
            var nm = (document.getElementById('sgc-name')||{}).value, em = (document.getElementById('sgc-email')||{}).value;
            if (nm && nm.trim()) fd.append('name', nm.trim());
            if (em && em.trim()) fd.append('email', em.trim());
            fd.append('__RequestVerificationToken', window.SiteHeader ? await SiteHeader.ensureToken() : '');
            var res = await fetch('/chat/upload', { method:'POST', body: fd });
            if (res.status === 400 && window.SiteHeader){
                await SiteHeader.reload();
                fd.set('__RequestVerificationToken', await SiteHeader.ensureToken());
                res = await fetch('/chat/upload', { method:'POST', body: fd, headers:{ 'X-AF-Retry':'1' } });
            }
            var d = await res.json().catch(function(){ return null; });
            if (d && d.ok){ msgRow({ imageUrl:d.url, fromStaff:false, at:nowHM() }); if (d.id && d.id > lastId) lastId = d.id; paused = false; }
            else { botRow((d && d.error) || 'Sorry, that image couldn’t be sent.'); }
        } catch (e) {} finally { sending = false; }
    }
    document.getElementById('sgc-attach').addEventListener('click', function(){ if (!started) startChat(); fileInput.click(); });
    fileInput.addEventListener('change', function(){ if (fileInput.files && fileInput.files[0]){ uploadFile(fileInput.files[0]); fileInput.value=''; } });
})();
</script>
}
