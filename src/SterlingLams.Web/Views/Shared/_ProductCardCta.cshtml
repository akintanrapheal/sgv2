@model SterlingLams.Web.Models.ViewModels.ProductCardViewModel
@* Card call-to-action: "Add to Cart" (simple) / "Select Options" (variants) / "Sold Out".
   The cart icon slides in on hover (see .cta-cart-icon in input.css). Wired in app.js. *@
@{
    var cartIcon = "<svg class=\"cta-cart-icon w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M2.25 2.25a.75.75 0 000 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 00-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 000-1.5H5.378A2.25 2.25 0 017.5 15h11.218a.75.75 0 00.674-.421 60.358 60.358 0 002.96-7.228.75.75 0 00-.525-.965A60.864 60.864 0 005.68 4.509l-.232-.867A1.875 1.875 0 003.636 2.25H2.25zM3.75 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM16.5 20.25a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0z\"/></svg>";
}
@if (!Model.IsAvailable)
{
    <button type="button" disabled
            class="mt-3 w-full bg-neutral-100 text-neutral-400 font-lato text-[13px] font-semibold tracking-[0.15em] uppercase py-3 rounded-md cursor-not-allowed">
        Sold Out
    </button>
}
else if (Model.HasVariants)
{
    <button type="button"
            class="cta-btn select-options-btn mt-3 w-full bg-brand-500 text-white text-[13px] font-semibold tracking-[0.15em] uppercase py-3 rounded-md hover:bg-brand-600 transition-colors flex items-center justify-center"
            data-product-slug="@Model.Slug">
        <span class="cta-label-default">Select Options</span>@Html.Raw(cartIcon)
    </button>
}
else
{
    <button type="button"
            class="cta-btn add-to-cart-btn mt-3 w-full bg-brand-500 text-white text-[13px] font-semibold tracking-[0.15em] uppercase py-3 rounded-md hover:bg-brand-600 transition-colors flex items-center justify-center"
            data-product-id="@Model.Id">
        <span class="cta-label-default">Add to Cart</span>@Html.Raw(cartIcon)
    </button>
}
