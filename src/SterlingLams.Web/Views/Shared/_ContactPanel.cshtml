@inject SterlingLams.Web.Services.ISettingsService SettingsService
@{
    var contactPhone = await SettingsService.GetAsync("general.contact_phone");
    var contactEmail = await SettingsService.GetAsync("general.contact_email");
    var contactWa    = await SettingsService.GetAsync("general.whatsapp_number");
    var contactWaDigits = new string((contactWa ?? "").Where(char.IsDigit).ToArray());
}
@* Contact Us / Need Help slide-over. Toggled by any #contact-toggle button (see app.js). Shared by
   the full storefront header and the minimal store-locator header. *@
<div id="contact-panel" class="hidden fixed inset-0 z-[220]" role="dialog" aria-modal="true" aria-label="Contact us">
    <div id="contact-backdrop" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300"></div>
    <div id="contact-panel-inner"
         class="absolute top-0 right-0 h-full w-[88vw] max-w-sm bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300">
        <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-100 flex-shrink-0">
            <h2 class="font-cormorant text-2xl font-light text-neutral-900">Need Help?</h2>
            <button type="button" id="contact-close" aria-label="Close"
                    class="text-neutral-400 hover:text-neutral-800 text-2xl leading-none">&times;</button>
        </div>
        <div class="flex-1 overflow-y-auto divide-y divide-neutral-100">
            @if (!string.IsNullOrWhiteSpace(contactWaDigits))
            {
                <a href="https://wa.me/@contactWaDigits" target="_blank" rel="noopener"
                   class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                    <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    <span class="flex-1 text-sm tracking-[0.12em] uppercase text-neutral-800">Chat on WhatsApp</span>
                    <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(contactPhone))
            {
                <a href="tel:@contactPhone.Replace(" ", "")"
                   class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                    <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                    <span class="flex-1">
                        <span class="block text-sm tracking-[0.12em] uppercase text-neutral-800">Call us</span>
                        <span class="block text-xs text-neutral-400 mt-0.5">@contactPhone</span>
                    </span>
                    <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(contactEmail))
            {
                <a href="mailto:@contactEmail"
                   class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                    <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                    <span class="flex-1">
                        <span class="block text-sm tracking-[0.12em] uppercase text-neutral-800">Email us</span>
                        <span class="block text-xs text-neutral-400 mt-0.5 normal-case tracking-normal">@contactEmail</span>
                    </span>
                    <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            }
            <a asp-controller="Stores" asp-action="Index"
               class="flex items-center gap-4 px-6 py-5 hover:bg-neutral-50 transition-colors group">
                <svg class="w-6 h-6 text-neutral-700 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                <span class="flex-1 text-sm tracking-[0.12em] uppercase text-neutral-800">Visit a store</span>
                <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
        </div>
    </div>
</div>
