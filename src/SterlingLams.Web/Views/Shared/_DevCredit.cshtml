@inject SterlingLams.Web.Services.ISettingsService Settings
@*
    Back-office credit line — shown on every staff/admin surface (Admin, Inventory, EPOS,
    staff sign-in). Muted neutral tones read fine on both light and dark layouts.
    The credit text is editable in Admin → Settings → General ("Back-office credit").
*@
@{
    var devCredit = await Settings.GetAsync("general.dev_credit", "Developed by Rapheal");
}
<div class="text-center py-4 mt-6 border-t border-neutral-200/60">
    @if (!string.IsNullOrWhiteSpace(devCredit))
    {
        <p class="text-[10px] tracking-[0.28em] uppercase text-neutral-400">@devCredit</p>
    }
    <p class="text-[10px] text-neutral-400/80 mt-0.5">&copy; @DateTime.UtcNow.Year</p>
</div>
