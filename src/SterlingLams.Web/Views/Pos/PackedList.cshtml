@model SterlingLams.Web.Controllers.PosController.PackedListVm
@using SterlingLams.Web.Services
@inject ISettingsService Settings
@{
    Layout = null;
    var siteName = await Settings.GetAsync("general.site_name", "Sterlin Glams");
    var logoUrl  = await Settings.GetAsync("pos.receipt_logo_url", "");
    if (string.IsNullOrWhiteSpace(logoUrl)) logoUrl = await Settings.GetAsync("general.logo_url", "");
    if (string.IsNullOrWhiteSpace(logoUrl)) logoUrl = "/images/sg-logo.png";
    var showLogo = await Settings.GetBoolAsync("pos.receipt_show_logo", true);
    var logoWidthMm = Math.Clamp(await Settings.GetIntAsync("pos.receipt_logo_height", 45), 20, 76);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Packed orders @Model.Day.ToString("dd/MM/yyyy")</title>
    <style>
        /* 8cm thermal roll: fixed width, length grows with the list, no page margins so the browser
           never adds its own header/footer. Pure black on white for thermal printers. */
        @@page { size: 80mm auto; margin: 0; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body { font-family: Arial, Helvetica, sans-serif; color:#000; font-size:12px; line-height:1.4; font-weight:600; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        .r { width:80mm; margin:0 auto; padding:4mm 3mm; }
        .c { text-align:center; }
        .logo { display:block; margin:0 auto 6px; max-width:100%; max-height:28mm; height:auto; object-fit:contain; }
        .biz { text-align:center; font-size:18px; font-weight:800; letter-spacing:.3px; margin:0 0 2px; }
        .sub { text-align:center; font-size:11px; font-weight:600; line-height:1.35; }
        hr { border:none; border-top:1px solid #000; margin:6px 0; }
        .dash { border-top:1px dashed #000; margin:6px 0; }
        .row { display:flex; justify-content:space-between; gap:8px; margin:1px 0; }
        .row span:last-child { text-align:right; }
        .b { font-weight:800; }
        .ordno { font-size:13px; font-weight:800; }
        .meta { font-size:11px; font-weight:600; }
        .item { font-size:12px; font-weight:700; margin:1px 0 1px 6px; overflow-wrap:break-word; word-break:break-word; }
        .totbox { font-size:13px; font-weight:800; }
        .btns { width:80mm; margin:12px auto 0; display:flex; gap:8px; }
        .btns button, .btns a { flex:1; padding:9px; font-size:12px; text-align:center; border:1px solid #ccc; background:#fff; cursor:pointer; text-decoration:none; color:#111; border-radius:4px; font-weight:600; }
        @@media print { .btns { display:none; } }
    </style>
</head>
<body onload="window.print()">
    <div class="r">
        @if (showLogo)
        {
            <img src="@logoUrl" alt="" class="logo" style="width:@(logoWidthMm)mm" onerror="this.style.display='none'" />
        }
        <div class="biz">@siteName</div>
        <div class="sub">
            <div>PACKED ORDERS</div>
            @if (!string.IsNullOrWhiteSpace(Model.StoreName)) { <div>@Model.StoreName@(string.IsNullOrWhiteSpace(Model.RegisterName) ? "" : " · " + Model.RegisterName)</div> }
            <div>@Model.Day.ToString("dddd, dd MMM yyyy")</div>
            <div>Cashier: @(string.IsNullOrWhiteSpace(Model.CashierName) ? "—" : Model.CashierName)</div>
            <div>Printed @DateTime.UtcNow.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <hr />

        @if (!Model.Orders.Any())
        {
            <p class="c" style="font-size:12px;">No orders packed today.</p>
        }
        else
        {
            var n = 0;
            foreach (var o in Model.Orders)
            {
                n++;
                var isPickup = o.FulfillmentType == SterlingLams.Web.Models.Domain.FulfillmentType.StorePickup;
                var when = (o.PackedAt ?? o.UpdatedAt).ToLocalTime().ToString("HH:mm");
                var who = o.User?.FullName;
                <div class="row">
                    <span class="ordno">@n. @o.OrderNumber</span>
                    <span class="meta">@when · @(isPickup ? "PICKUP" : "DELIVERY")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(who) || !string.IsNullOrWhiteSpace(o.User?.PhoneNumber))
                {
                    <div class="meta">@who@(string.IsNullOrWhiteSpace(o.User?.PhoneNumber) ? "" : " · " + o.User!.PhoneNumber)</div>
                }
                @foreach (var i in o.Items)
                {
                    <div class="item">• @i.ProductName@(string.IsNullOrWhiteSpace(i.VariantName) ? "" : " (" + i.VariantName + ")") &times; @i.Quantity</div>
                }
                <div class="dash"></div>
            }
            <div class="row totbox"><span>TOTAL ORDERS</span><span>@Model.Orders.Count</span></div>
            <div class="row totbox"><span>TOTAL ITEMS</span><span>@Model.ItemCount</span></div>
        }
        <hr />
        <div class="c" style="font-size:11px;">— End of packed list —</div>
    </div>

    <div class="btns">
        <button onclick="window.print()">Print</button>
        <a href="#" onclick="window.close();return false;">Close</a>
    </div>
</body>
</html>
