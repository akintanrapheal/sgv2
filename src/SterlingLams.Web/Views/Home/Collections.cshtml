@using SterlingLams.Web.Services
@using SterlingLams.Web.Models.ViewModels
@using SterlingLams.Web.Models.Domain
@using System.Globalization
@inject ISettingsService SettingsService
@{
    ViewData["Title"] = "The Lookbook";
    ViewData["Description"] = "The Sterlin Glams lookbook — a curated edit of our finest rings, necklaces, bracelets and earrings, styled for the discerning woman.";
    Layout = "_Layout";
    ViewData["CardLowThreshold"] = 0;
    var lookbook = ViewBag.LookbookProducts as List<ProductCardViewModel> ?? new List<ProductCardViewModel>();
    var campaigns = ViewBag.LookbookCampaigns as List<LookbookCampaign> ?? new List<LookbookCampaign>();
    var pmap = ViewBag.LookbookProductMap as Dictionary<int, ProductCardViewModel.LookbookHotspotProduct> ?? new();
    string Pct(double v) => v.ToString(CultureInfo.InvariantCulture);
    var liveCampaigns = campaigns.Where(c => !string.IsNullOrWhiteSpace(c.Image)).ToList();

    // Category feature images are admin-editable in Settings → Collections.
    var collectionCards = new[]
    {
        ("Rings", "rings", await SettingsService.GetAsync("collections.image_rings", "")),
        ("Necklaces", "necklaces", await SettingsService.GetAsync("collections.image_necklaces", "")),
        ("Bracelets", "bracelets", await SettingsService.GetAsync("collections.image_bracelets", "")),
        ("Earrings", "earrings", await SettingsService.GetAsync("collections.image_earrings", "")),
    };
}

<partial name="_QuickViewModal" />

<!-- ─── Editorial hero ───────────────────────────────────────────────────────── -->
<section class="relative bg-stone-50 text-center overflow-hidden py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6">
        <p class="text-xs tracking-[0.4em] uppercase text-brand-500 mb-5">The Sterlin Glams Edit</p>
        <h1 class="font-cormorant text-6xl md:text-7xl font-light text-neutral-900 leading-none">The Lookbook</h1>
        <span class="mt-6 block mx-auto w-20 h-px bg-gradient-to-r from-transparent via-brand-400 to-transparent"></span>
        <p class="mt-6 text-neutral-500 font-light leading-relaxed">
            A curated edit of our season's finest — timeless pieces styled to be worn, layered and loved.
            Explore the collection and shop the look.
        </p>
    </div>
</section>

<!-- ─── Magazine campaigns with shop-the-look hotspots ──────────────────────── -->
@if (liveCampaigns.Any())
{
    <section class="bg-white">
        @foreach (var c in liveCampaigns)
        {
            var spots = c.Hotspots.Where(h => pmap.ContainsKey(h.ProductId)).ToList();
            <figure class="relative w-full m-0">
                <img src="@Img.Cld(c.Image, 1920)" alt="@(c.Heading ?? "Campaign")" loading="lazy" class="block w-full h-auto" />

                @if (!string.IsNullOrWhiteSpace(c.Heading) || !string.IsNullOrWhiteSpace(c.Subtext))
                {
                    <figcaption class="absolute left-0 bottom-0 p-6 md:p-12 max-w-xl">
                        @if (!string.IsNullOrWhiteSpace(c.Heading))
                        {
                            <h2 class="font-cormorant text-3xl md:text-5xl font-light text-white drop-shadow">@c.Heading</h2>
                        }
                        @if (!string.IsNullOrWhiteSpace(c.Subtext))
                        {
                            <p class="mt-2 text-sm md:text-base text-white/90 font-light drop-shadow">@c.Subtext</p>
                        }
                    </figcaption>
                }

                @foreach (var h in spots)
                {
                    var p = pmap[h.ProductId];
                    <div class="lb-spot group absolute -translate-x-1/2 -translate-y-1/2" style="left:@Pct(h.X)%;top:@Pct(h.Y)%">
                        <button type="button" class="lb-dot relative flex items-center justify-center w-6 h-6 rounded-full bg-white shadow-lg ring-1 ring-black/10" aria-label="Shop @p.Name">
                            <span class="absolute inline-flex w-6 h-6 rounded-full bg-brand-400 opacity-60 animate-ping"></span>
                            <span class="relative w-2.5 h-2.5 rounded-full bg-brand-500"></span>
                        </button>
                        <div class="lb-pop absolute bottom-full mb-3 left-1/2 -translate-x-1/2 w-56 bg-white rounded-lg shadow-xl p-3 opacity-0 pointer-events-none transition-opacity duration-200 group-hover:opacity-100 group-hover:pointer-events-auto group-[.open]:opacity-100 group-[.open]:pointer-events-auto">
                            <a href="/Products/@p.Slug" class="flex items-center gap-3">
                                <img src="@p.Image" alt="@p.Name" class="w-14 h-14 object-cover rounded shrink-0" />
                                <span class="min-w-0">
                                    <span class="block text-sm text-neutral-800 leading-snug line-clamp-2">@p.Name</span>
                                    <span class="block text-sm text-brand-600 font-medium mt-0.5">@p.PriceText</span>
                                    <span class="block text-[10px] tracking-widest uppercase text-neutral-400 mt-1">Shop →</span>
                                </span>
                            </a>
                        </div>
                    </div>
                }
            </figure>
        }
    </section>
}

<!-- ─── This season's edit (real products) ──────────────────────────────────── -->
@if (lookbook.Any())
{
    <section class="py-14 md:py-20 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-10 md:mb-14">
                <p class="text-xs tracking-[0.35em] uppercase text-neutral-400 mb-3">Shop the edit</p>
                <h2 class="font-cormorant text-4xl font-light text-neutral-900">This Season's Pieces</h2>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-10 md:gap-x-6 md:gap-y-14">
                @foreach (var p in lookbook)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>

            <div class="text-center mt-12">
                <a asp-controller="Products" asp-action="Index"
                   class="inline-block border border-neutral-900 text-neutral-900 text-xs tracking-[0.2em] uppercase px-10 py-4 hover:bg-brand-500 hover:border-brand-500 hover:text-white transition-colors duration-300">
                    View All Jewellery
                </a>
            </div>
        </div>
    </section>
}

<!-- ─── Shop by collection (category cards) ─────────────────────────────────── -->
<section class="py-14 md:py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-10 md:mb-14">
            <p class="text-xs tracking-[0.35em] uppercase text-brand-500 mb-3">Explore</p>
            <h2 class="font-cormorant text-4xl font-light text-neutral-900">Shop by Collection</h2>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            @foreach (var (title, cat, img) in collectionCards)
            {
                var hasImg = !string.IsNullOrWhiteSpace(img);
                <a asp-controller="Products" asp-action="Index" asp-route-category="@cat"
                   class="group relative overflow-hidden rounded-lg @(hasImg ? "bg-neutral-200" : "bg-white") aspect-[3/4] flex items-end">
                    @if (hasImg)
                    {
                        <img src="@Img.Cld(img, 700)" alt="@title" loading="lazy"
                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/75 via-neutral-900/15 to-transparent"></div>
                    }
                    else
                    {
                        <div class="absolute inset-0 bg-gradient-to-br from-brand-50 to-stone-100"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    }
                    <!-- pink accent line on hover -->
                    <span class="absolute inset-x-0 bottom-0 h-1 bg-brand-500 scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-500"></span>
                    <div class="relative z-10 p-6 md:p-7 w-full">
                        <h3 class="font-cormorant text-2xl md:text-3xl font-light mb-1 transition-colors duration-300 @(hasImg ? "text-white" : "text-neutral-900")">@title</h3>
                        <p class="text-xs tracking-widest uppercase transition-colors duration-300 @(hasImg ? "text-neutral-200 group-hover:text-brand-200" : "text-neutral-500 group-hover:text-brand-500")">
                            Shop @title →
                        </p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- ─── New Arrivals CTA ─────────────────────────────────────────────────────── -->
<section class="py-20 bg-neutral-900 text-white text-center">
    <p class="text-xs tracking-[0.4em] uppercase text-brand-400 mb-4">Just In</p>
    <h2 class="font-cormorant text-4xl font-light mb-6">New Arrivals</h2>
    <p class="text-neutral-400 font-light text-sm max-w-md mx-auto mb-8">
        Discover our latest pieces, crafted with the finest materials and timeless elegance.
    </p>
    <a asp-controller="Products" asp-action="Index" asp-route-isNewArrival="true"
       class="inline-block bg-brand-500 text-white text-xs tracking-[0.2em] uppercase px-12 py-4 hover:bg-brand-600 transition-colors duration-300">
        View New Arrivals
    </a>
</section>

@section Scripts {
    @if (liveCampaigns.Any())
    {
        <script nonce="@Context.Items["csp-nonce"]">
        // Tap a hotspot to open its product card on touch devices (desktop uses hover). Only one open.
        (function () {
            var spots = document.querySelectorAll('.lb-spot');
            spots.forEach(function (spot) {
                var dot = spot.querySelector('.lb-dot');
                if (!dot) return;
                dot.addEventListener('click', function (e) {
                    e.preventDefault();
                    var wasOpen = spot.classList.contains('open');
                    spots.forEach(function (s) { s.classList.remove('open'); });
                    if (!wasOpen) spot.classList.add('open');
                });
            });
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.lb-spot')) spots.forEach(function (s) { s.classList.remove('open'); });
            });
        }());
        </script>
    }
}
