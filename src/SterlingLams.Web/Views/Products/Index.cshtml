@model SterlingLams.Web.Models.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = Model.PageTitle ?? "Collections";
    Layout = "_Layout";

    // Base URL (current filters, minus page) for the "View more" progressive-load button.
    var qsParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Filters.Category)) { qsParts.Add("category=" + Uri.EscapeDataString(Model.Filters.Category)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.SortBy)) { qsParts.Add("sortBy=" + Uri.EscapeDataString(Model.Filters.SortBy)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.Search)) { qsParts.Add("search=" + Uri.EscapeDataString(Model.Filters.Search)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.Metal)) { qsParts.Add("metal=" + Uri.EscapeDataString(Model.Filters.Metal)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.Color)) { qsParts.Add("color=" + Uri.EscapeDataString(Model.Filters.Color)); }
    if (Model.Filters.MinPrice.HasValue) { qsParts.Add("minPrice=" + Model.Filters.MinPrice.Value); }
    if (Model.Filters.MaxPrice.HasValue) { qsParts.Add("maxPrice=" + Model.Filters.MaxPrice.Value); }
    if (Model.Filters.InStockOnly == true) { qsParts.Add("inStockOnly=true"); }
    if (Model.PageSize != 24) { qsParts.Add("pageSize=" + Model.PageSize); }
    var loadMoreBaseUrl = "/products" + (qsParts.Count > 0 ? "?" + string.Join("&", qsParts) : "");
    // Build a listing URL for a given page size, preserving all the other active filters/sort.
    Func<int, string> sizeUrl = size =>
    {
        var parts = qsParts.Where(p => !p.StartsWith("pageSize=")).ToList();
        if (size != 24) { parts.Add("pageSize=" + size); }
        return "/products" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    };
    var shownNow = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    // Grouped "Shop Categories" tree (old-site style), built from the categories that have products.
    var sidebarNodes = SterlingLams.Web.Infrastructure.StoreMenu.BuildSidebar(
        Model.Filters.Categories.Select(c => (c.Slug, c.Name)));

    // Self-canonical that keeps the category but drops page/sort/filter noise (avoids duplicates).
    var canonBase = $"{Context.Request.Scheme}://{Context.Request.Host}/products";
    ViewData["Canonical"] = string.IsNullOrWhiteSpace(Model.Filters.Category)
        ? canonBase
        : $"{canonBase}?category={Model.Filters.Category}";

    // BreadcrumbList structured data (OP-39): Home > Collections, or Home > <Category> on a filtered view.
    var sdBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var hasCategory = !string.IsNullOrWhiteSpace(Model.Filters.Category);
    var crumbLeafName = hasCategory ? (Model.PageTitle ?? "Collections") : "Collections";
    var crumbLeafUrl = hasCategory ? $"{sdBase}/products?category={Model.Filters.Category}" : $"{sdBase}/products";
    var breadcrumbLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = sdBase },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = crumbLeafName, ["item"] = crumbLeafUrl },
        },
    });
}

@section Head {
    <script type="application/ld+json" nonce="@Context.Items["csp-nonce"]">@Html.Raw(breadcrumbLd)</script>
}

<div class="max-w-7xl mx-auto px-6 py-12">
    @* Antiforgery token comes from _QuickViewModal's placeholder (filled by /site/header-state)
       so this page stays output-cacheable — no server-rendered token / Set-Cookie. *@
    <partial name="_QuickViewModal" />

    <!-- Page Header -->
    <div class="text-center mb-12">
        <h1 class="font-cormorant text-5xl font-light text-neutral-900">
            @(Model.PageTitle ?? "Our Collections")
        </h1>
        @if (Model.TotalCount > 0)
        {
            <p class="text-sm text-neutral-400 mt-3">@Model.TotalCount pieces</p>
        }
    </div>

    <div class="flex gap-8 lg:gap-12">

        <!-- ─── Sidebar Filters ────────────────────────────────────────────── -->
        <aside class="hidden lg:block w-56 flex-shrink-0">
            <form method="get" id="filter-form">
                @* Preserve the chosen page size across sort/filter submits (only when not the default). *@
                @if (Model.PageSize != 24)
                {
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                }
                <!-- Shop Categories (grouped accordion) -->
                @if (sidebarNodes.Count > 0)
                {
                    <div class="mb-8">
                        <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Shop Categories</h3>
                        <partial name="_CategorySidebar" model="@((sidebarNodes, Model.Filters.Category))" />
                    </div>
                }

                <!-- Metal -->
                @if (Model.Filters.AvailableMetals.Any())
                {
                    <div class="mb-8">
                        <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Metal</h3>
                        <ul class="space-y-2">
                            @foreach (var metal in Model.Filters.AvailableMetals)
                            {
                                <li>
                                    <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer hover:text-neutral-900 transition-colors">
                                        <input type="checkbox" name="metal" value="@metal"
                                               @(Model.Filters.Metal == metal ? "checked" : "")
                                               class="rounded-none border-neutral-300 text-neutral-900" />
                                        @metal
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <!-- Filter by price (0 → highest catalogue price) -->
                @{
                    long sliderMax = (long)Math.Max(1000m, Math.Ceiling(Model.Filters.MaxCatalogPrice / 1000m) * 1000m);
                    long curMin = (long)(Model.Filters.MinPrice ?? 0m);
                    long curMax = (long)(Model.Filters.MaxPrice ?? sliderMax);
                    if (curMax > sliderMax || curMax <= 0) { curMax = sliderMax; }
                    if (curMin < 0 || curMin > curMax) { curMin = 0; }
                }
                <div class="mb-8">
                    <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Filter by price</h3>
                    <div id="price-slider" data-max="@sliderMax">
                        <div class="ps-track">
                            <div class="ps-fill"></div>
                            <input type="range" class="ps-min" min="0" max="@sliderMax" step="500" value="@curMin" aria-label="Minimum price" />
                            <input type="range" class="ps-max" min="0" max="@sliderMax" step="500" value="@curMax" aria-label="Maximum price" />
                        </div>
                        <p class="mt-4 text-sm text-neutral-600">Price: <span class="ps-out font-medium text-neutral-900"></span></p>
                        <input type="hidden" name="minPrice" class="ps-min-input" value="@Model.Filters.MinPrice" />
                        <input type="hidden" name="maxPrice" class="ps-max-input" value="@Model.Filters.MaxPrice" />
                        <button type="submit" class="mt-3 w-full bg-brand-500 text-white text-xs tracking-[0.2em] uppercase py-2.5 hover:bg-brand-600 transition-colors">
                            Filter
                        </button>
                    </div>
                </div>

                <!-- Filter by colour (from the variants' colour attribute) -->
                @if (Model.Filters.AvailableColors.Any())
                {
                    <div class="mb-8">
                        <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Filter by colour</h3>
                        <ul class="space-y-1.5 max-h-64 overflow-y-auto pr-1">
                            <li>
                                <label class="flex items-center gap-2 text-sm cursor-pointer @(string.IsNullOrEmpty(Model.Filters.Color) ? "text-brand-600 font-medium" : "text-neutral-500 hover:text-neutral-900")">
                                    <input type="radio" name="color" value="" data-autosubmit class="accent-brand-500" @(string.IsNullOrEmpty(Model.Filters.Color) ? "checked" : "") />
                                    All colours
                                </label>
                            </li>
                            @foreach (var c in Model.Filters.AvailableColors)
                            {
                                var active = string.Equals(Model.Filters.Color, c.Value, StringComparison.OrdinalIgnoreCase);
                                <li>
                                    <label class="flex items-center justify-between gap-2 text-sm cursor-pointer @(active ? "text-brand-600 font-medium" : "text-neutral-600 hover:text-neutral-900")">
                                        <span class="flex items-center gap-2 min-w-0">
                                            <input type="radio" name="color" value="@c.Value" data-autosubmit class="accent-brand-500" @(active ? "checked" : "") />
                                            @if (!string.IsNullOrWhiteSpace(c.Hex))
                                            {
                                                <span class="inline-block w-3 h-3 rounded-full border border-neutral-300 shrink-0" style="background:@c.Hex"></span>
                                            }
                                            <span class="truncate">@c.Value</span>
                                        </span>
                                        <span class="text-[11px] text-neutral-400 border border-neutral-200 rounded-full px-2 leading-5 shrink-0">@c.Count</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <!-- Availability -->
                <div class="mb-8">
                    <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer">
                        <input type="checkbox" name="inStockOnly" value="true"
                               @(Model.Filters.InStockOnly == true ? "checked" : "") />
                        In stock only
                    </label>
                </div>

                <button type="submit"
                        class="w-full bg-brand-500 text-white text-xs tracking-[0.2em] uppercase py-3 hover:bg-brand-600 transition-colors">
                    Apply Filters
                </button>

                @if (!string.IsNullOrEmpty(Model.Filters.Category) || !string.IsNullOrEmpty(Model.Filters.Metal) || !string.IsNullOrEmpty(Model.Filters.Color) || Model.Filters.MinPrice.HasValue || Model.Filters.MaxPrice.HasValue)
                {
                    <a asp-action="Index" class="block text-center mt-3 text-xs text-neutral-400 hover:text-brand-500 transition-colors">
                        Clear all
                    </a>
                }
            </form>
        </aside>

        <!-- ─── Product Grid ───────────────────────────────────────────────── -->
        <div class="flex-1 min-w-0">

            <!-- Mobile category nav (the sidebar is hidden on phones/tablets) -->
            @if (sidebarNodes.Count > 0)
            {
                @* Collapsed by default on mobile — taps to open the grouped "Shop Categories" list. *@
                <details class="lg:hidden mb-6 border border-neutral-200 rounded-sm group">
                    <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between">
                        <span class="text-xs tracking-[0.2em] uppercase text-neutral-500">
                            @(string.IsNullOrEmpty(Model.Filters.Category) ? "Shop Categories" : (Model.Filters.Categories.FirstOrDefault(c => c.Slug == Model.Filters.Category)?.Name ?? "Shop Categories"))
                        </span>
                        <svg class="accordion-chevron w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>
                    <div class="px-4 pb-3 pt-1 max-h-80 overflow-y-auto border-t border-neutral-100">
                        <partial name="_CategorySidebar" model="@((sidebarNodes, Model.Filters.Category))" />
                    </div>
                </details>
            }

            <!-- Sort bar -->
            <div class="flex items-center justify-between gap-4 mb-8 pb-4 border-b border-neutral-100 flex-wrap">
                <p class="text-xs text-neutral-400">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                </p>
                <div class="flex items-center gap-4 flex-wrap">
                    <!-- Grid density (client-side, remembered per browser) -->
                    <div id="grid-density" class="hidden sm:flex items-center gap-1" role="group" aria-label="Grid density">
                        @foreach (var cols in new[] { 2, 3, 4 })
                        {
                            <button type="button" class="gd-btn p-1.5 text-neutral-300 hover:text-neutral-700 transition-colors" data-cols="@cols" title="@cols per row" aria-label="@cols per row">
                                <span class="grid gap-0.5" style="grid-template-columns:repeat(@cols,1fr);width:@(cols * 5)px;">
                                    @for (var i = 0; i < cols * 2; i++)
                                    {
                                        <span class="block w-1 h-1 bg-current rounded-[1px]"></span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                    <!-- Show N per page -->
                    <div class="flex items-center gap-2 text-xs text-neutral-400">
                        <span class="uppercase tracking-wider">Show</span>
                        @foreach (var s in new[] { 9, 24, 36 })
                        {
                            <a href="@sizeUrl(s)" class="@(Model.PageSize == s ? "text-neutral-900 font-semibold" : "text-neutral-400 hover:text-neutral-700") transition-colors">@s</a>
                        }
                    </div>
                    <select name="sortBy" form="filter-form" data-autosubmit
                            class="text-xs border border-neutral-200 px-3 py-2 text-neutral-600 focus:outline-none focus:border-neutral-900 bg-white">
                        <option value="name" selected="@(Model.Filters.SortBy == "name")">Name (A–Z)</option>
                        <option value="popularity" selected="@(Model.Filters.SortBy == "popularity")">Popularity</option>
                        <option value="rating" selected="@(Model.Filters.SortBy == "rating")">Average rating</option>
                        <option value="newest" selected="@(Model.Filters.SortBy == "newest" || Model.Filters.SortBy == "newness")">Newest</option>
                        <option value="price_asc" selected="@(Model.Filters.SortBy == "price_asc")">Price: Low to High</option>
                        <option value="price_desc" selected="@(Model.Filters.SortBy == "price_desc")">Price: High to Low</option>
                    </select>
                </div>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="text-center py-24">
                    <p class="font-cormorant text-2xl font-light text-neutral-400">No pieces found</p>
                    <p class="text-sm text-neutral-400 mt-2">Try adjusting your filters.</p>
                </div>
            }
            else
            {
                <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    <partial name="_ProductCards" model="Model.Products" />
                </div>

                <!-- Progressive "View more" (appends the next page in place) + Back to top -->
                <div class="mt-16 flex flex-col items-center gap-8">
                    <p class="text-sm text-neutral-500">
                        Showing 1–<span id="shown-count">@shownNow</span> of @Model.TotalCount
                    </p>
                    @if (Model.Page < Model.TotalPages)
                    {
                        <div id="load-more-wrap" class="w-full max-w-xl">
                            <button type="button" id="load-more-btn"
                                    data-url="@loadMoreBaseUrl" data-next="@(Model.Page + 1)" data-total="@Model.TotalPages"
                                    data-count="@Model.TotalCount" data-size="@Model.PageSize"
                                    class="w-full border border-neutral-300 py-4 text-xs tracking-[0.2em] uppercase text-neutral-800 hover:bg-brand-500 hover:border-brand-500 hover:text-white transition-colors">
                                <span data-label>View more</span>
                            </button>
                        </div>
                    }
                    <button type="button" id="back-to-top"
                            class="flex items-center gap-2 text-xs tracking-[0.2em] uppercase text-neutral-700 hover:text-neutral-900 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7" />
                        </svg>
                        Back to top
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Dual-handle price slider. Two range inputs share one track; only the thumbs capture pointer
       events so both handles stay grabbable even when their ranges overlap. */
    #price-slider .ps-track { position: relative; height: 2px; background: #e5e5e5; margin: 20px 8px; }
    #price-slider .ps-fill { position: absolute; height: 2px; background: #ed028b; left: 0; right: 0; }
    #price-slider input[type=range] { position: absolute; top: -9px; left: 0; width: 100%; height: 20px;
        -webkit-appearance: none; appearance: none; background: transparent; pointer-events: none; margin: 0; }
    #price-slider input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none;
        width: 16px; height: 16px; border-radius: 9999px; background: #ed028b; border: 2px solid #fff;
        box-shadow: 0 0 0 1px #cfcfcf; cursor: pointer; pointer-events: auto; }
    #price-slider input[type=range]::-moz-range-thumb { width: 16px; height: 16px; border-radius: 9999px;
        background: #ed028b; border: 2px solid #fff; box-shadow: 0 0 0 1px #cfcfcf; cursor: pointer; pointer-events: auto; }
    #price-slider input[type=range]::-moz-range-track { background: transparent; }

    /* Grid density (data-cols overrides the Tailwind column classes; real CSS so it survives purge).
       Phones always stay 2-up regardless of the chosen desktop density. */
    #product-grid[data-cols="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @@media (min-width: 640px) {
        #product-grid[data-cols="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        #product-grid[data-cols="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        #product-grid[data-cols="4"] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    #grid-density .gd-btn.active { color: #1c1917; }
</style>
<script nonce="@Context.Items["csp-nonce"]">
(function () {
    var root = document.getElementById('price-slider');
    if (!root) return;
    var max = parseInt(root.dataset.max, 10) || 0;
    var lo = root.querySelector('.ps-min'), hi = root.querySelector('.ps-max');
    var fill = root.querySelector('.ps-fill'), out = root.querySelector('.ps-out');
    var loIn = root.querySelector('.ps-min-input'), hiIn = root.querySelector('.ps-max-input');
    function fmt(n) { return '₦' + Number(n).toLocaleString('en-NG'); }
    function draw() {
        var a = parseInt(lo.value, 10), b = parseInt(hi.value, 10);
        if (a > b) { var t = a; a = b; b = t; }
        var pa = max ? (a / max * 100) : 0, pb = max ? (b / max * 100) : 100;
        fill.style.left = pa + '%';
        fill.style.right = (100 - pb) + '%';
        out.textContent = fmt(a) + ' — ' + fmt(b);
        // Only send a bound when it actually narrows the range (else leave blank = no filter).
        loIn.value = a > 0 ? a : '';
        hiIn.value = b < max ? b : '';
    }
    lo.addEventListener('input', function () { if (parseInt(lo.value, 10) > parseInt(hi.value, 10)) lo.value = hi.value; draw(); });
    hi.addEventListener('input', function () { if (parseInt(hi.value, 10) < parseInt(lo.value, 10)) hi.value = lo.value; draw(); });
    draw();
})();

// ── Grid density (2 / 3 / 4 per row) — remembered per browser ───────────────
(function () {
    var grid = document.getElementById('product-grid');
    var wrap = document.getElementById('grid-density');
    if (!grid || !wrap) return;
    var btns = [].slice.call(wrap.querySelectorAll('.gd-btn'));
    var KEY = 'sg.gridCols';
    function apply(cols, save) {
        grid.setAttribute('data-cols', cols);
        btns.forEach(function (b) { b.classList.toggle('active', b.dataset.cols === String(cols)); });
        if (save) { try { localStorage.setItem(KEY, cols); } catch (e) {} }
    }
    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) {}
    apply(stored || '3', false);   // 3-up default on desktop; phones stay 2-up via CSS
    btns.forEach(function (b) { b.addEventListener('click', function () { apply(b.dataset.cols, true); }); });
})();
</script>
