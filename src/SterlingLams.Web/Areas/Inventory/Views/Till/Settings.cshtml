@{
    ViewData["Title"] = "POS Settings";
    var header = ViewBag.ReceiptHeader as string ?? "";
    var footer = ViewBag.ReceiptFooter as string ?? "";
    var apprRefunds = ViewBag.ApprovalRefunds as bool? ?? false;
    var apprDiscounts = ViewBag.ApprovalDiscounts as bool? ?? false;
    var apprPct = ViewBag.ApprovalDiscountMinPct as int? ?? 0;
    var bizName = ViewBag.ReceiptBusinessName as string ?? "";
    var rcAddress = ViewBag.ReceiptAddress as string ?? "";
    var rcPhone = ViewBag.ReceiptPhone as string ?? "";
    var rcWebsite = ViewBag.ReceiptWebsite as string ?? "";
    var rcThanks = ViewBag.ReceiptThanks as string ?? "";
    var showLogo = ViewBag.ReceiptShowLogo as bool? ?? true;
    var showPoints = ViewBag.ReceiptShowPoints as bool? ?? true;
    var showBarcode = ViewBag.ReceiptShowBarcode as bool? ?? true;
    var siteName = ViewBag.SiteName as string ?? "Sterlin Glams";
}

<div class="mb-5">
    <h1 class="text-lg font-medium text-neutral-800">POS settings</h1>
    <p class="text-xs text-neutral-400">Customise what prints on POS receipts. The address, phone and store name come from each selling branch unless you set an override below.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 text-sm text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-lg px-4 py-2.5">@TempData["Success"]</div>
}

<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-6 items-start">
    <div class="bg-white rounded-xl border border-neutral-200 p-6">
        <form asp-action="SaveSettings" method="post" class="space-y-5" id="pos-settings-form">
            @Html.AntiForgeryToken()

            <div>
                <h2 class="text-sm font-semibold text-neutral-800 mb-3">Receipt customizer</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 mb-1">Business name</label>
                        <input type="text" name="receiptBusinessName" id="f-biz" value="@bizName" placeholder="@(siteName) Ltd"
                               class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500" />
                        <p class="text-[11px] text-neutral-400 mt-1">Blank = "@(siteName) Ltd".</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 mb-1">Address (override)</label>
                        <textarea name="receiptAddress" id="f-address" rows="3" placeholder="Blank = each store prints its own address"
                                  class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500 resize-none">@rcAddress</textarea>
                        <p class="text-[11px] text-neutral-400 mt-1">One line per row. Blank = the selling branch's own address (Abuja prints Abuja's, etc.).</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-neutral-700 mb-1">Phone (override)</label>
                            <input type="text" name="receiptPhone" id="f-phone" value="@rcPhone" placeholder="Store phone"
                                   class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-neutral-700 mb-1">Website / email line</label>
                            <input type="text" name="receiptWebsite" id="f-website" value="@rcWebsite" placeholder="www.sterlinglams.com"
                                   class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 mb-1">Receipt Header Line</label>
                        <input type="text" name="receiptHeader" id="f-header" value="@header" placeholder="Optional slogan / note under the address"
                               class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 mb-1">"Thanks" line</label>
                        <input type="text" name="receiptThanks" id="f-thanks" value="@rcThanks" placeholder="Thanks for shopping with @siteName"
                               class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-700 mb-1">Footer / policy line</label>
                        <textarea name="receiptFooter" id="f-footer" rows="2"
                                  class="w-full border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500 resize-none">@footer</textarea>
                    </div>
                </div>
            </div>

            <div class="border-t border-neutral-100 pt-5">
                <h2 class="text-sm font-semibold text-neutral-800 mb-3">Show on receipt</h2>
                <label class="flex items-center gap-2.5 cursor-pointer mb-2.5">
                    <input type="checkbox" name="receiptShowLogo" value="true" id="f-logo" @(showLogo ? "checked" : "") class="rounded border-neutral-300 accent-emerald-600 w-4 h-4" />
                    <span class="text-sm text-neutral-800">Logo</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer mb-2.5">
                    <input type="checkbox" name="receiptShowPoints" value="true" id="f-points" @(showPoints ? "checked" : "") class="rounded border-neutral-300 accent-emerald-600 w-4 h-4" />
                    <span class="text-sm text-neutral-800">Loyalty points <span class="text-[11px] text-neutral-400">(when a customer is attached)</span></span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="checkbox" name="receiptShowBarcode" value="true" id="f-barcode" @(showBarcode ? "checked" : "") class="rounded border-neutral-300 accent-emerald-600 w-4 h-4" />
                    <span class="text-sm text-neutral-800">Order barcode</span>
                </label>
            </div>

            <div class="border-t border-neutral-100 pt-5">
                <h2 class="text-sm font-semibold text-neutral-800 mb-1">Manager approval</h2>
                <p class="text-[11px] text-neutral-400 mb-3">Require a manager's PIN (any Admin with a PIN set) before sensitive actions. Off by default.</p>
                <label class="flex items-start gap-2.5 cursor-pointer mb-3">
                    <input type="checkbox" name="approvalRefunds" value="true" @(apprRefunds ? "checked" : "") class="mt-0.5 rounded border-neutral-300 accent-neutral-900 w-4 h-4" />
                    <span>
                        <span class="block text-sm text-neutral-800">Require approval for refunds</span>
                        <span class="block text-[11px] text-neutral-400">A refund needs a manager PIN before it's processed.</span>
                    </span>
                </label>
                <label class="flex items-start gap-2.5 cursor-pointer mb-3">
                    <input type="checkbox" name="approvalDiscounts" value="true" @(apprDiscounts ? "checked" : "") class="mt-0.5 rounded border-neutral-300 accent-neutral-900 w-4 h-4" />
                    <span>
                        <span class="block text-sm text-neutral-800">Require approval for discounts</span>
                        <span class="block text-[11px] text-neutral-400">A sale whose line discounts meet the threshold needs a manager PIN at payment.</span>
                    </span>
                </label>
                <div>
                    <label class="block text-xs font-medium text-neutral-700 mb-1">Discount approval threshold (%)</label>
                    <input type="number" name="approvalDiscountMinPct" value="@apprPct" min="0" max="100"
                           class="w-32 border border-neutral-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-emerald-500" />
                    <p class="text-[11px] text-neutral-400 mt-1">Line discounts at or above this % of the sale need approval. 0 = every discount.</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button type="submit" class="px-6 py-2.5 bg-emerald-600 text-white text-sm rounded-lg hover:bg-emerald-700 transition-colors">Save settings</button>
                <p class="text-xs text-neutral-400">Changes take effect immediately.</p>
            </div>
        </form>
    </div>

    <!-- Live preview -->
    <div class="lg:sticky lg:top-4">
        <p class="text-[11px] uppercase tracking-wide text-neutral-400 mb-2">Live preview</p>
        <div class="bg-neutral-100 rounded-xl p-4 flex justify-center">
            <div id="rc-preview" style="width:300px;background:#fff;color:#000;padding:14px 12px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.4;box-shadow:0 4px 18px rgba(0,0,0,.12);">
                <img id="pv-logo" src="/images/sg-logo.png" style="display:block;margin:0 auto 6px;max-width:150px;max-height:56px;object-fit:contain" onerror="this.style.display='none'" />
                <div id="pv-biz" style="text-align:center;font-weight:800;font-size:15px;margin-bottom:3px"></div>
                <div id="pv-addr" style="text-align:center;font-size:11px"></div>
                <div id="pv-header" style="text-align:center;font-size:11px;margin-top:4px"></div>
                <hr style="border:none;border-top:1px solid #000;margin:8px 0" />
                <div style="display:flex;justify-content:space-between;font-weight:700"><span>Receipt of Purchase</span><span>11/09/2026 14:01</span></div>
                <div style="display:flex;justify-content:space-between"><span>Staff</span><span>JUDITH</span></div>
                <div style="display:flex;justify-content:space-between"><span>Device</span><span>Ajah Till 1</span></div>
                <div style="display:flex;justify-content:space-between"><span>Customer</span><span>Mrs Okafor</span></div>
                <hr style="border:none;border-top:1px solid #000;margin:8px 0" />
                <div style="display:flex;justify-content:space-between;font-weight:700;font-size:11px"><span>PRODUCT</span><span>TOTAL</span></div>
                <div style="display:flex;justify-content:space-between;font-weight:700"><span>4Piece Flame Set ×1</span><span>&#8358;84,950</span></div>
                <div style="display:flex;justify-content:space-between;font-weight:700"><span>Gold Twisted Studs ×1</span><span>&#8358;5,950</span></div>
                <hr style="border:none;border-top:1px solid #000;margin:8px 0" />
                <div style="display:flex;justify-content:space-between"><span>Sub Total</span><span>&#8358;90,900</span></div>
                <div style="display:flex;justify-content:space-between;font-weight:800;font-size:17px"><span>Total</span><span>&#8358;90,900</span></div>
                <hr style="border:none;border-top:1px solid #000;margin:8px 0" />
                <div style="display:flex;justify-content:space-between;font-weight:700;font-size:11px"><span>PAYMENT BY TENDER</span><span>AMOUNT</span></div>
                <div style="display:flex;justify-content:space-between;font-weight:700"><span>CARD</span><span>&#8358;90,900</span></div>
                <div id="pv-points">
                    <hr style="border:none;border-top:1px solid #000;margin:8px 0" />
                    <div style="display:flex;justify-content:space-between;font-size:11px"><span>Previous points</span><span>254</span></div>
                    <div style="display:flex;justify-content:space-between;font-size:11px"><span>Points gained</span><span>595</span></div>
                    <div style="display:flex;justify-content:space-between;font-weight:700;font-size:11px"><span>Current points</span><span>16,567</span></div>
                    <div style="display:flex;justify-content:space-between;font-size:11px"><span>Points value</span><span>&#8358;41,417.50</span></div>
                </div>
                <hr style="border:none;border-top:1px solid #000;margin:8px 0" />
                <div id="pv-thanks" style="text-align:center;font-weight:700;margin:3px 0"></div>
                <div id="pv-footer" style="text-align:center;font-weight:800;margin:3px 0;white-space:pre-line"></div>
                <div id="pv-barcode" style="text-align:center;margin-top:8px;font-family:monospace;letter-spacing:1px">‖‖│‖│‖‖│‖│‖‖<br><span style="font-size:10px">RECB00027…</span></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var siteName = @Html.Raw(Json.Serialize(siteName));
    function val(id) { var e = document.getElementById(id); return e ? e.value.trim() : ''; }
    function checked(id) { var e = document.getElementById(id); return e ? e.checked : true; }
    function esc(s) { return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function render() {
        document.getElementById('pv-biz').textContent = val('f-biz') || (siteName + ' Ltd');
        var addr = val('f-address');
        var addrHtml = addr
            ? addr.split(/\n/).map(function (l) { return esc(l.trim()); }).filter(Boolean).join('<br>')
            : '<span style="color:#999">Sterlin Glams Ajah</span><br><span style="color:#999">(this branch’s own address)</span>';
        var phone = val('f-phone') || '<span style="color:#999">(store phone)</span>';
        var web = val('f-website');
        document.getElementById('pv-addr').innerHTML = addrHtml + '<br>Tel : ' + phone + (web ? '<br>' + esc(web) : '');
        var hdr = val('f-header');
        document.getElementById('pv-header').innerHTML = hdr ? esc(hdr) : '';
        document.getElementById('pv-thanks').textContent = val('f-thanks') || ('Thanks for shopping with ' + siteName);
        document.getElementById('pv-footer').innerHTML = esc(val('f-footer')).replace(/\n/g, '<br>');
        document.getElementById('pv-logo').style.display = checked('f-logo') ? '' : 'none';
        document.getElementById('pv-points').style.display = checked('f-points') ? '' : 'none';
        document.getElementById('pv-barcode').style.display = checked('f-barcode') ? '' : 'none';
    }
    ['f-biz','f-address','f-phone','f-website','f-header','f-thanks','f-footer'].forEach(function (id) {
        var e = document.getElementById(id); if (e) e.addEventListener('input', render);
    });
    ['f-logo','f-points','f-barcode'].forEach(function (id) {
        var e = document.getElementById(id); if (e) e.addEventListener('change', render);
    });
    render();
}());
</script>
}
