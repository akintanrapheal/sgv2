@model List<SterlingLams.Web.Areas.Inventory.Controllers.ReportsController.ItemSaleRow>
@{
    var productName = (string)ViewBag.ProductName;
    var sku = ViewBag.Sku as string;
    int productId = ViewBag.ProductId;
    DateTime from = ViewBag.From; DateTime to = ViewBag.To;
    int totalUnits = ViewBag.TotalUnits; decimal totalRevenue = ViewBag.TotalRevenue;
    var inCls = "border border-neutral-200 rounded-sm px-3 py-2 text-sm bg-white focus:outline-none focus:border-emerald-400";
}

@await Html.PartialAsync("_ReportTabs", "SalesByItem")

<div class="flex items-center gap-2 mb-1">
    <a asp-action="SalesByItem" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")"
       class="text-xs text-neutral-400 hover:text-neutral-700">← Sales by item</a>
</div>
<h1 class="font-cormorant text-2xl font-light text-neutral-900">@productName</h1>
<p class="text-xs text-neutral-400 mb-4">@(string.IsNullOrWhiteSpace(sku) ? "" : $"SKU {sku} · ")@from.ToString("dd MMM") – @to.ToString("dd MMM yyyy")</p>

<div class="grid grid-cols-3 gap-3 mb-4">
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <div class="text-[10px] text-neutral-400 uppercase tracking-widest mb-1">Orders</div>
        <div class="text-2xl font-light text-neutral-900">@Model.Count.ToString("N0")</div>
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <div class="text-[10px] text-neutral-400 uppercase tracking-widest mb-1">Units sold</div>
        <div class="text-2xl font-light text-neutral-900">@totalUnits.ToString("N0")</div>
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <div class="text-[10px] text-neutral-400 uppercase tracking-widest mb-1">Revenue</div>
        <div class="text-2xl font-light text-emerald-700">₦@totalRevenue.ToString("N0")</div>
    </div>
</div>

<form method="get" class="flex flex-wrap items-end gap-2 mb-4">
    <input type="hidden" name="productId" value="@productId" />
    <div><label class="block text-[10px] text-neutral-400 uppercase tracking-widest mb-1">From</label>
        <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="@inCls" /></div>
    <div><label class="block text-[10px] text-neutral-400 uppercase tracking-widest mb-1">To</label>
        <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="@inCls" /></div>
    <button type="submit" class="px-4 py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-neutral-700">Filter</button>
</form>

<div class="bg-white border border-neutral-100 rounded-sm overflow-x-auto">
    <table class="w-full text-sm min-w-[860px]">
        <thead>
            <tr class="bg-neutral-50 border-b border-neutral-100 text-xs text-neutral-400">
                <th class="text-left px-4 py-3 font-medium">Order</th>
                <th class="text-left px-4 py-3 font-medium">Date</th>
                <th class="text-left px-4 py-3 font-medium">Channel</th>
                <th class="text-left px-4 py-3 font-medium">Store</th>
                <th class="text-left px-4 py-3 font-medium">Customer</th>
                <th class="text-left px-4 py-3 font-medium">Sold by (staff)</th>
                <th class="text-left px-4 py-3 font-medium">Packed by</th>
                <th class="text-right px-4 py-3 font-medium">Qty</th>
                <th class="text-right px-4 py-3 font-medium">Total</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-neutral-50">
            @if (!Model.Any()) { <tr><td colspan="9" class="px-4 py-12 text-center text-neutral-400">No sales of this item in the selected period.</td></tr> }
            @foreach (var r in Model)
            {
                <tr class="hover:bg-neutral-50">
                    <td class="px-4 py-2.5 text-xs font-medium text-neutral-800 whitespace-nowrap">@r.OrderNumber</td>
                    <td class="px-4 py-2.5 text-xs text-neutral-500 whitespace-nowrap">@r.When.ToString("dd MMM yy HH:mm")</td>
                    <td class="px-4 py-2.5 text-xs">
                        <span class="text-[10px] px-2 py-0.5 rounded-full @(r.Channel == "In-store" ? "bg-indigo-50 text-indigo-700" : "bg-blue-50 text-blue-700")">@r.Channel</span>
                    </td>
                    <td class="px-4 py-2.5 text-xs text-neutral-600 whitespace-nowrap">@r.Store</td>
                    <td class="px-4 py-2.5 text-xs">
                        @if (!string.IsNullOrEmpty(r.BuyerId))
                        {
                            <a asp-action="CustomerSales" asp-route-userId="@r.BuyerId"
                               asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")"
                               class="text-emerald-700 hover:underline">@r.Buyer</a>
                        }
                        else
                        {
                            <span class="text-neutral-600">@r.Buyer</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.BuyerEmail))
                        {
                            <span class="block text-[10px] text-neutral-400">@r.BuyerEmail</span>
                        }
                    </td>
                    <td class="px-4 py-2.5 text-xs text-neutral-600 whitespace-nowrap">@r.Staff</td>
                    <td class="px-4 py-2.5 text-xs text-neutral-600 whitespace-nowrap">@r.Packer</td>
                    <td class="px-4 py-2.5 text-right text-xs text-neutral-700">@r.Qty</td>
                    <td class="px-4 py-2.5 text-right text-xs font-medium text-neutral-800 whitespace-nowrap">₦@r.LineTotal.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
