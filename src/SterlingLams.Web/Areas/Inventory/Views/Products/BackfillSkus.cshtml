@model SterlingLams.Web.Areas.Inventory.Controllers.ProductsController.SkuBackfillPreview
@{
    ViewData["Title"] = "Fill SKUs";
}

<div class="mb-5">
    <h1 class="text-2xl font-semibold text-neutral-900">Fill SKUs</h1>
    <p class="text-sm text-neutral-500 mt-1 max-w-3xl">
        Each product shows its code (e.g. <code class="text-neutral-600">5012287</code>) at the start of its name in the
        list. This copies that code onto the product's <strong>SKU</strong> and every one of its <strong>variants</strong>
        wherever the SKU is blank. The code is taken from the product's own SKU, else its import code, else a leading
        number in the name. Preview first; nothing is written until you click <strong>Apply</strong>.
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@TempData["Success"]</div>
}

<!-- Summary -->
<div class="rounded-md border border-blue-200 bg-blue-50 px-5 py-4 max-w-5xl">
    <div class="text-sm font-semibold text-blue-800">Preview <span class="font-normal text-blue-700/70">— nothing has been written yet.</span></div>
    <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-center">
        <div><div class="text-xl font-semibold text-neutral-900">@Model.Matched</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">products with a code</div></div>
        <div><div class="text-xl font-semibold text-emerald-700">@Model.ProductFill</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">product SKUs to fill</div></div>
        <div><div class="text-xl font-semibold text-emerald-700">@Model.VariantFill</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">variant SKUs to fill</div></div>
        <div><div class="text-xl font-semibold text-amber-600">@Model.ProductChange</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">product SKUs differ</div></div>
        <div><div class="text-xl font-semibold text-amber-600">@Model.VariantChange</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">variant SKUs differ</div></div>
        <div><div class="text-xl font-semibold text-neutral-400">@Model.NoLeadingSku</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">no code (skipped)</div></div>
    </div>
</div>

<!-- Apply -->
<form asp-action="BackfillSkusApply" method="post" class="mt-5 max-w-5xl rounded-md border border-neutral-200 bg-white p-4"
      onsubmit="var b=this.querySelector('button[type=submit]');b.disabled=true;b.textContent='Applying…';">
    @Html.AntiForgeryToken()
    <label class="flex items-start gap-2 text-sm text-neutral-700 mb-3">
        <input type="checkbox" name="overwrite" value="true" class="mt-0.5" />
        <span>
            <strong>Also overwrite existing SKUs</strong> that don't match the name
            (@Model.ProductChange product@(Model.ProductChange == 1 ? "" : "s") · @Model.VariantChange variant@(Model.VariantChange == 1 ? "" : "s") would change).
            <span class="block text-xs text-neutral-400">Leave unticked to only fill blank SKUs — the safe default.</span>
        </span>
    </label>
    <button type="submit" class="rounded-md bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-emerald-700">
        Apply — fill @( Model.ProductFill + Model.VariantFill ) blank SKU(s)
    </button>
</form>

<!-- What it will write -->
@if (Model.Samples.Any())
{
    <div class="mt-6 max-w-5xl overflow-x-auto rounded-md border border-neutral-200">
        <table class="min-w-full text-sm">
            <thead class="bg-neutral-50 text-neutral-500 text-xs uppercase tracking-wide">
                <tr>
                    <th class="text-left font-medium px-3 py-2">Product name</th>
                    <th class="text-left font-medium px-3 py-2">→ SKU</th>
                    <th class="text-left font-medium px-3 py-2">Current SKU</th>
                    <th class="text-right font-medium px-3 py-2">Variants</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
                @foreach (var r in Model.Samples)
                {
                    <tr>
                        <td class="px-3 py-2 text-neutral-700">@r.Name</td>
                        <td class="px-3 py-2 font-mono text-emerald-700">@r.Extracted</td>
                        <td class="px-3 py-2 font-mono text-neutral-400">@(string.IsNullOrWhiteSpace(r.CurrentSku) ? "—" : r.CurrentSku)</td>
                        <td class="px-3 py-2 text-right text-neutral-500">@r.Variants</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="px-3 py-2 text-xs text-neutral-400">Showing @Model.Samples.Count of @Model.Matched matched products.</p>
    </div>
}

@if (Model.Unmatched.Any())
{
    <div class="mt-4 rounded-md border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-600 max-w-5xl">
        <span class="font-medium text-neutral-700">@Model.NoLeadingSku products have no code anywhere</span> — left untouched.
        <span class="text-neutral-500">e.g. @string.Join(" · ", Model.Unmatched.Take(10))</span>
    </div>
}
