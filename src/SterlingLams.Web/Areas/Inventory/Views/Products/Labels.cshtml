@model List<SterlingLams.Web.Areas.Inventory.Controllers.LabelRow>
@{
    Layout = null;
    bool showName = ViewBag.ShowName ?? true;
    bool showPrice = ViewBag.ShowPrice ?? true;
    bool showBarcode = ViewBag.ShowBarcode ?? true;
    bool showCategory = ViewBag.ShowCategory ?? false;
    bool showDescription = ViewBag.ShowDescription ?? false;
    bool showQr = ViewBag.ShowQr ?? false;
    bool showSku = ViewBag.ShowSku ?? false;
    bool showBarcodeNumber = ViewBag.ShowBarcodeNumber ?? false;
    string? customText = ViewBag.CustomText;
    string preset = ViewBag.Preset ?? "barcode";
    string printer = ViewBag.Printer ?? "a4";
    string font = ViewBag.Font ?? "Arial, Helvetica, sans-serif";   // validated server-side
    int fontSize = ViewBag.FontSize ?? 9;                            // base label font size (px)
    var json = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(p => new { name = p.Name, code = p.Code, price = p.Price, category = p.Category, description = p.Description ?? "", sku = p.Sku ?? "" }));
    var flags = System.Text.Json.JsonSerializer.Serialize(new { showName, showPrice, showBarcode, showCategory, showDescription, showQr, showSku, showBarcodeNumber, customText = customText ?? "", preset, printer, font, fontSize });
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Barcode labels</title>
    <script src="~/js/jsbarcode.min.js" asp-append-version="true"></script>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: #f5f5f4; color: #1c1917; }
        .toolbar { position: sticky; top: 0; background: #0a0a0a; color: #fff; padding: 12px 20px; display: flex; align-items: center; gap: 14px; font-size: 13px; z-index: 5; }
        .toolbar input { width: 60px; padding: 5px; border: 1px solid #555; border-radius: 3px; background: #fff; }
        .toolbar button { padding: 7px 16px; border: 0; border-radius: 3px; cursor: pointer; font-size: 13px; }
        .btn-print { background: #059669; color: #fff; }
        .btn-gen { background: #ffffff22; color: #fff; border: 1px solid #ffffff44 !important; }
        .sheet { padding: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
        /* --lbl-ff (font family) and --lbl-fs (base size) are set per-label from the chosen font/size,
           so name, SKU, barcode number and price all share ONE small, consistent look that fits small
           stock. Weights/casing still vary a touch so the name and price stay legible. */
        .label { position: relative; border: 1px solid #d6d3d1; border-radius: 4px; padding: 8px; text-align: center; background: #fff; page-break-inside: avoid;
                 font-family: var(--lbl-ff, Arial, Helvetica, sans-serif); font-size: var(--lbl-fs, 9px); }
        .label.shelf { width: 280px; }
        .label.barcode { width: 200px; }
        .label.butterfly { width: 150px; }
        .label.custom { width: 230px; }
        .label.unchecked { opacity: .35; }
        .lcat { font-size: var(--lbl-fs, 9px); text-transform: uppercase; letter-spacing: .5px; color: #78716c; margin-bottom: 2px; }
        .lname { font-size: var(--lbl-fs, 9px); line-height: 1.25; margin-bottom: 2px; font-weight: 600; }
        .ldesc { font-size: var(--lbl-fs, 9px); color: #57534e; line-height: 1.2; margin-bottom: 2px; max-height: 24px; overflow: hidden; }
        .lprice { font-size: var(--lbl-fs, 9px); font-weight: bold; margin-top: 2px; }
        .lcustom { font-size: var(--lbl-fs, 9px); color: #57534e; margin-top: 3px; }
        .lsku { font-size: var(--lbl-fs, 9px); color: #57534e; margin-bottom: 2px; letter-spacing: .5px; }
        .lcode { font-size: var(--lbl-fs, 9px); color: #1c1917; margin-top: 1px; letter-spacing: .5px; }
        /* image-rendering keeps QR modules crisp when the printer scales the PNG (no grey anti-alias
           edges that a thermal head can't reproduce) — critical for scannability on a 203dpi Zebra. */
        .qr { width: 46px; height: 46px; margin: 3px auto 0; display: block; image-rendering: pixelated; image-rendering: crisp-edges; }
        .butterfly .qr { width: 34px; height: 34px; }
        .lpick { position: absolute; top: 4px; right: 4px; width: 16px; height: 16px; cursor: pointer; }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .sheet { padding: 0; gap: 4px; }
            .label { border: 1px dashed #bbb; }
            .label.unchecked { display: none !important; }
        }
    </style>
    @* Printer / label-stock specific page + label sizing. A4 = a grid on a sheet; thermal &
       butterfly = one label per page sized to the physical stock (roll / dumbbell labels). *@
    @if (printer == "thermal")
    {
        <style>
            @@page { size: 50mm 30mm; margin: 1mm; }
            .pr-thermal .sheet { display: block; padding: 0; gap: 0; }
            .pr-thermal .label { width: 50mm; min-height: 28mm; border-radius: 0; display: flex;
                flex-direction: column; align-items: center; justify-content: center; }
            @@media print { .pr-thermal .label { border: 0; page-break-after: always; } }
        </style>
    }
    else if (printer == "tag30x15")
    {
        <style>
            @@page { size: 30mm 15mm; margin: 0; }
            .pr-tag30x15 .sheet { display: block; padding: 0; gap: 0; }
            /* 3×1.5cm tag laid out HORIZONTALLY — QR on the left, text on the right — so the full
               product name has room (up to 3 lines) and the barcode number + price never clip it. */
            .pr-tag30x15 .label { width: 30mm; height: 15mm; border-radius: 0; padding: 0.8mm; overflow: hidden; }
            .pr-tag30x15 .tagrow { display: flex; align-items: center; gap: 1mm; height: 100%; }
            .pr-tag30x15 .qr { width: 11mm; height: 11mm; flex: 0 0 auto; }
            .pr-tag30x15 .tagtext { flex: 1 1 auto; min-width: 0; text-align: left; overflow: hidden; }
            .pr-tag30x15 .lname { font-size: 6px; line-height: 1.1; margin: 0 0 0.3mm 0; overflow: hidden;
                display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
            .pr-tag30x15 .lsku { font-size: 6px; line-height: 1.1; margin: 0; letter-spacing: .3px; }
            .pr-tag30x15 .lcode { font-size: 6px; line-height: 1.1; margin: 0; }
            .pr-tag30x15 .lprice { font-size: 7px; font-weight: bold; line-height: 1.1; margin: 0.2mm 0 0 0; }
            @@media print { .pr-tag30x15 .label { border: 0; page-break-after: always; } }
        </style>
    }
    else if (printer == "butterfly")
    {
        <style>
            @@page { size: 56mm 13mm; margin: 0; }
            .pr-butterfly .sheet { display: block; padding: 0; gap: 0; }
            /* Dumbbell jewellery label: barcode sits on the tail that wraps the item. */
            .pr-butterfly .label { width: 56mm; height: 13mm; border-radius: 0; padding: 1mm 2mm;
                display: flex; flex-direction: column; align-items: center; justify-content: center; }
            .pr-butterfly .lname { font-size: 8px; min-height: 0; margin: 0; }
            .pr-butterfly .lprice { font-size: 9px; margin: 0; }
            @@media print { .pr-butterfly .label { border: 0; page-break-after: always; } }
        </style>
    }
    else
    {
        <style>@@page { size: A4; margin: 8mm; }</style>
    }
</head>
<body class="pr-@printer">
    <div class="toolbar no-print">
        <span>Copies each:</span>
        <input id="copies" type="number" value="1" min="1" max="50" />
        <button class="btn-gen" onclick="render()">Apply</button>
        <button class="btn-gen" onclick="selectAll(true)">Select all</button>
        <button class="btn-gen" onclick="selectAll(false)">Select none</button>
        <button class="btn-print" onclick="window.print()">🖨 Print</button>
        <span id="info" style="opacity:.6"></span>
        <span style="opacity:.5; margin-left: auto;">Untick a label to skip it when printing</span>
    </div>
    <div id="sheet" class="sheet"></div>

    <script id="data" type="application/json">@Html.Raw(json)</script>
    <script id="flags" type="application/json">@Html.Raw(flags)</script>
    <script>
        const products = JSON.parse(document.getElementById('data').textContent);
        const F = JSON.parse(document.getElementById('flags').textContent);
        function esc(s) { return String(s).replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m])); }
        function render() {
            const copies = Math.min(50, Math.max(1, parseInt(document.getElementById('copies').value) || 1));
            const sheet = document.getElementById('sheet'); sheet.innerHTML = '';
            products.forEach(p => {
                for (let i = 0; i < copies; i++) {
                    const el = document.createElement('div'); el.className = 'label ' + (F.preset || 'barcode');
                    if (F.font) el.style.setProperty('--lbl-ff', F.font);
                    if (F.fontSize) el.style.setProperty('--lbl-fs', F.fontSize + 'px');
                    let html = '<input type="checkbox" class="lpick no-print" checked title="Print this label" />';
                    if (F.printer === 'tag30x15') {
                        // Tiny 30×15mm tag: horizontal — QR left, name/number/price stacked on the right so
                        // the full name fits alongside (not squeezed above) the QR and nothing clips.
                        const qr = F.showQr ? `<img class="qr" alt="QR" src="Qr?text=${encodeURIComponent(p.code)}" />` : '';
                        let txt = '';
                        if (F.showName) txt += `<div class="lname">${esc(p.name)}</div>`;
                        if (F.showSku && p.sku) txt += `<div class="lsku">${esc(p.sku)}</div>`;
                        if (F.showBarcodeNumber && p.code) txt += `<div class="lcode">${esc(p.code)}</div>`;
                        if (F.showPrice) txt += `<div class="lprice">₦${(+p.price).toLocaleString()}</div>`;
                        if (F.customText) txt += `<div class="lcustom">${esc(F.customText)}</div>`;
                        html += '<div class="tagrow">' + qr + '<div class="tagtext">' + txt + '</div></div>';
                    } else {
                        // Order: name · SKU (above QR) · QR · barcode number (below QR) · price.
                        if (F.showCategory && p.category) html += `<div class="lcat">${esc(p.category)}</div>`;
                        if (F.showName) html += `<div class="lname">${esc(p.name)}</div>`;
                        if (F.showDescription && p.description) html += `<div class="ldesc">${esc(p.description)}</div>`;
                        if (F.showBarcode) html += `<svg class="bc"></svg>`;
                        if (F.showSku && p.sku) html += `<div class="lsku">${esc(p.sku)}</div>`;
                        if (F.showQr) html += `<img class="qr" alt="QR" src="Qr?text=${encodeURIComponent(p.code)}" />`;
                        if (F.showBarcodeNumber && p.code) html += `<div class="lcode">${esc(p.code)}</div>`;
                        if (F.showPrice) html += `<div class="lprice">₦${(+p.price).toLocaleString()}</div>`;
                        if (F.customText) html += `<div class="lcustom">${esc(F.customText)}</div>`;
                    }
                    el.innerHTML = html;
                    sheet.appendChild(el);
                    if (F.showBarcode) { try { JsBarcode(el.querySelector('.bc'), p.code, { format: 'CODE39', width: 1.0, height: 38, displayValue: false, margin: 2 }); } catch (e) { } }
                    el.querySelector('.lpick').addEventListener('change', e => el.classList.toggle('unchecked', !e.target.checked));
                }
            });
            document.getElementById('info').textContent = (products.length * copies) + ' label(s)';
        }
        function selectAll(state) {
            document.querySelectorAll('.lpick').forEach(c => { c.checked = state; c.dispatchEvent(new Event('change')); });
        }
        render();
    </script>
</body>
</html>
