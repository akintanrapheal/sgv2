@model SterlingLams.Web.Services.DedupeResult
@{
    ViewData["Title"] = "Clean up duplicate variants";
    var applied = ViewData["Applied"] as bool? ?? false;
}

<div class="mb-5">
    <h1 class="text-2xl font-semibold text-neutral-900">Clean up duplicate variants</h1>
    <p class="text-sm text-neutral-500 mt-1 max-w-3xl">
        Finds variants of the same product that mean the <strong>same colour &amp; size</strong> written two ways
        (e.g. <code class="text-neutral-600">9 / Silver</code> and <code class="text-neutral-600">Silver / 9</code>) — the
        cause of “ambiguous” barcode skips. It keeps the copy that carries <strong>stock, sales, or a barcode</strong> and
        removes the empty duplicates. Any product where two copies both hold stock/sales is left for you to review.
    </p>
</div>

@if (applied)
{
    <div class="mb-5 rounded-md border border-emerald-300 bg-emerald-50 px-5 py-3 text-sm text-emerald-800">
        ✓ Done — @Model.Summary
    </div>
}

@if (Model.Errors.Any())
{
    <div class="mb-4 rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 max-w-4xl">
        @foreach (var e in Model.Errors) { <div>@e</div> }
    </div>
}

<!-- Summary + action -->
<div class="rounded-md border @(applied ? "border-emerald-200 bg-emerald-50/40" : "border-blue-200 bg-blue-50") px-5 py-4 max-w-4xl">
    <div class="text-sm font-semibold @(applied ? "text-emerald-800" : "text-blue-800")">
        @if (applied) { <span>Applied</span> } else { <span>Preview</span> <span class="font-normal text-blue-700/70">— nothing removed yet.</span> }
    </div>
    <div class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        <div><div class="text-xl font-semibold text-neutral-900">@Model.Merges.Count</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">duplicate sets · @Model.ProductCount products</div></div>
        <div><div class="text-xl font-semibold text-rose-600">@Model.Merges.Sum(m => m.Delete.Count)</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">duplicates @(applied ? "removed" : "to remove")</div></div>
        <div><div class="text-xl font-semibold text-emerald-700">@Model.BarcodesMoved</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">barcodes moved</div></div>
        <div><div class="text-xl font-semibold text-amber-600">@Model.Skipped.Count</div><div class="text-[11px] uppercase tracking-wide text-neutral-500">skipped for review</div></div>
    </div>

    @if (!applied && Model.Merges.Count > 0)
    {
        <form asp-action="DedupeVariants" method="post" class="mt-4"
              onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Removing…';">
            @Html.AntiForgeryToken()
            <button type="submit" class="rounded-md bg-emerald-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-emerald-700">
                Remove @Model.Merges.Sum(m => m.Delete.Count) duplicate variants
            </button>
            <span class="ml-3 text-xs text-neutral-500">Permanent — only empty duplicates are deleted, inside one transaction.</span>
        </form>
    }
    else if (!applied && Model.Merges.Count == 0)
    {
        <p class="mt-3 text-sm text-neutral-500">No removable duplicates found. 🎉</p>
    }
</div>

<!-- Merges -->
@if (Model.Merges.Any())
{
    <h2 class="mt-8 mb-2 text-sm font-semibold text-neutral-700">@(applied ? "Cleaned" : "Will clean")</h2>
    <div class="max-w-4xl overflow-x-auto rounded-md border border-neutral-200">
        <table class="min-w-full text-sm">
            <thead class="bg-neutral-50 text-neutral-500 text-xs uppercase tracking-wide">
                <tr>
                    <th class="text-left font-medium px-3 py-2">Product</th>
                    <th class="text-left font-medium px-3 py-2">Keep</th>
                    <th class="text-left font-medium px-3 py-2">Remove (empty)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
                @foreach (var g in Model.Merges)
                {
                    <tr>
                        <td class="px-3 py-2"><span class="font-mono text-neutral-700">@g.Sku</span><div class="text-neutral-500">@g.Product</div></td>
                        <td class="px-3 py-2">
                            <span class="inline-block rounded border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-emerald-700">@g.Keep?.Name</span>
                            @if (!string.IsNullOrWhiteSpace(g.Keep?.Barcode)) { <span class="ml-1 text-[11px] font-mono text-neutral-400">@g.Keep!.Barcode</span> }
                            @if (g.Keep?.Stock > 0) { <span class="ml-1 text-[11px] text-neutral-400">· @g.Keep.Stock in stock</span> }
                            @if (g.BarcodeMove != null) { <div class="text-[11px] text-emerald-600 mt-0.5">↳ barcode @g.BarcodeMove</div> }
                        </td>
                        <td class="px-3 py-2 text-neutral-600">
                            @string.Join(", ", g.Delete.Select(d => d.Name))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Skipped -->
@if (Model.Skipped.Any())
{
    <h2 class="mt-8 mb-2 text-sm font-semibold text-neutral-700">Skipped — needs your review</h2>
    <div class="max-w-4xl overflow-x-auto rounded-md border border-amber-200">
        <table class="min-w-full text-sm">
            <thead class="bg-amber-50 text-amber-700 text-xs uppercase tracking-wide">
                <tr>
                    <th class="text-left font-medium px-3 py-2">Product</th>
                    <th class="text-left font-medium px-3 py-2">Variants (same colour/size)</th>
                    <th class="text-left font-medium px-3 py-2">Why skipped</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-amber-100">
                @foreach (var g in Model.Skipped)
                {
                    <tr class="bg-amber-50/30">
                        <td class="px-3 py-2"><span class="font-mono text-neutral-700">@g.Sku</span><div class="text-neutral-500">@g.Product</div></td>
                        <td class="px-3 py-2 text-neutral-600">
                            @foreach (var d in g.Delete)
                            {
                                <span class="inline-block mr-2">@d.Name@(d.Stock > 0 ? $" ({d.Stock})" : "")</span>
                            }
                        </td>
                        <td class="px-3 py-2 text-amber-700">@g.SkipReason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
