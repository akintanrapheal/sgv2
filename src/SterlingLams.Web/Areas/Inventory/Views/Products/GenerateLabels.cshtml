@{
    ViewData["Title"] = "Generate Labels";
    var categories = ViewBag.Categories as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var stores = ViewBag.Stores as List<SterlingLams.Web.Models.Domain.Store> ?? new();
}

<div class="mb-5">
    <h1 class="text-2xl font-semibold text-neutral-900">Generate Labels</h1>
    <p class="text-sm text-neutral-500 mt-1">Search or scan products (or pick a whole location / category), choose what to print, then generate the label sheet.</p>
</div>

<style>
    /* Single-label live preview — mirrors the printed label (Labels.cshtml). Width follows the preset. */
    /* Font family (--lbl-ff) + base size (--lbl-fs) are set per preview render, so name/SKU/number/price
       share one small consistent look — exactly what prints (Labels.cshtml). */
    #lbl-preview-box .label { position: relative; border: 1px solid #d6d3d1; border-radius: 4px; padding: 8px; text-align: center; background: #fff; color: #1c1917;
        font-family: var(--lbl-ff, Arial, Helvetica, sans-serif); font-size: var(--lbl-fs, 9px); }
    #lbl-preview-box .label.shelf { width: 280px; }
    #lbl-preview-box .label.barcode { width: 200px; }
    #lbl-preview-box .label.butterfly { width: 150px; }
    #lbl-preview-box .label.custom { width: 230px; }
    /* Printer/label-stock sizes (mm to px at 96dpi) — the preview matches the physical label. */
    #lbl-preview-box .label.pr-thermal { width: 189px; min-height: 113px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    #lbl-preview-box .label.pr-butterfly { width: 212px; min-height: 49px; padding: 3px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    #lbl-preview-box .label.pr-butterfly .qr { width: 30px; height: 30px; }
    /* 30x15mm tag (about 113x57px at 96dpi) — force everything tiny so name + QR + number fit. */
    #lbl-preview-box .label.pr-tag30x15 { width: 113px; height: 57px; padding: 3px; overflow: hidden; }
    #lbl-preview-box .label.pr-tag30x15 .tagrow { display: flex; align-items: center; gap: 4px; height: 100%; }
    #lbl-preview-box .label.pr-tag30x15 .qr { width: 42px; height: 42px; margin: 0; flex: 0 0 auto; }
    #lbl-preview-box .label.pr-tag30x15 .tagtext { flex: 1 1 auto; min-width: 0; text-align: left; overflow: hidden; }
    #lbl-preview-box .label.pr-tag30x15 .lname { font-size: 6px; line-height: 1.1; margin: 0 0 1px 0; overflow: hidden;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
    #lbl-preview-box .label.pr-tag30x15 .lsku { font-size: 6px; line-height: 1.1; margin: 0; letter-spacing: .3px; }
    #lbl-preview-box .label.pr-tag30x15 .lcode { font-size: 6px; line-height: 1.1; margin: 0; }
    #lbl-preview-box .label.pr-tag30x15 .lprice { font-size: 7px; font-weight: bold; line-height: 1.1; margin: 1px 0 0 0; }
    #lbl-preview-box .lcat { font-size: var(--lbl-fs, 9px); text-transform: uppercase; letter-spacing: .5px; color: #78716c; margin-bottom: 2px; }
    #lbl-preview-box .lname { font-size: var(--lbl-fs, 9px); line-height: 1.25; margin-bottom: 2px; font-weight: 600; }
    #lbl-preview-box .ldesc { font-size: var(--lbl-fs, 9px); color: #57534e; line-height: 1.2; margin-bottom: 2px; }
    #lbl-preview-box .lprice { font-size: var(--lbl-fs, 9px); font-weight: bold; margin-top: 2px; }
    #lbl-preview-box .lcustom { font-size: var(--lbl-fs, 9px); color: #57534e; margin-top: 3px; }
    #lbl-preview-box .lsku { font-size: var(--lbl-fs, 9px); color: #57534e; margin-bottom: 2px; letter-spacing: .5px; }
    #lbl-preview-box .lcode { font-size: var(--lbl-fs, 9px); color: #1c1917; margin-top: 1px; letter-spacing: .5px; }
    #lbl-preview-box svg.bc { max-width: 100%; }
    #lbl-preview-box .qr { width: 46px; height: 46px; margin: 3px auto 0; display: block; image-rendering: pixelated; image-rendering: crisp-edges; }
</style>

<div class="bg-white border border-neutral-200 rounded-md p-6 space-y-6 max-w-4xl">
    <!-- Search -->
    <div class="relative">
        <label class="block text-xs text-neutral-500 mb-1">Search for product by name or barcode</label>
        <input id="lbl-search" type="text" autocomplete="off" placeholder="Start typing or scan…"
               class="w-full border border-neutral-200 rounded-md px-3 py-2.5 text-sm focus:outline-none focus:border-blue-400" />
        <div id="lbl-suggest" class="hidden absolute z-20 left-0 right-0 mt-1 bg-white border border-neutral-200 rounded-md shadow-lg max-h-64 overflow-y-auto"></div>
    </div>

    <div class="flex items-end gap-3">
        <div>
            <label class="block text-xs text-neutral-500 mb-1">Quantity to print</label>
            <div class="inline-flex items-center border border-neutral-200 rounded-md overflow-hidden">
                <button type="button" id="qty-minus" class="px-3 py-2 text-neutral-500 hover:bg-neutral-100">−</button>
                <input id="lbl-qty" type="number" min="1" value="1" class="w-16 text-center text-sm py-2 focus:outline-none" />
                <button type="button" id="qty-plus" class="px-3 py-2 text-neutral-500 hover:bg-neutral-100">+</button>
            </div>
        </div>
    </div>

    <div class="text-center text-xs text-neutral-400 font-medium">— OR —</div>

    <!-- Bulk -->
    <div class="grid grid-cols-2 gap-4">
        <div>
            <label class="block text-xs text-neutral-500 mb-1">For all stock at</label>
            <select id="lbl-store" class="w-full border border-neutral-200 rounded-md px-3 py-2.5 text-sm bg-white">
                <option value="">Select location…</option>
                @foreach (var s in stores) { <option value="@s.Id">@s.Name</option> }
            </select>
        </div>
        <div>
            <label class="block text-xs text-neutral-500 mb-1">For all products of</label>
            <select id="lbl-category" class="w-full border border-neutral-200 rounded-md px-3 py-2.5 text-sm bg-white">
                <option value="">Select category…</option>
                @foreach (var c in categories) { <option value="@c.Value">@c.Text</option> }
            </select>
        </div>
    </div>

    <!-- Preset -->
    <div class="border-t border-neutral-100 pt-5">
        <h3 class="text-sm font-medium text-neutral-800 mb-2">Preset</h3>
        <div class="flex flex-wrap gap-4 text-sm text-neutral-700">
            @foreach (var p in new[] { ("shelf", "Shelf Edge"), ("barcode", "Barcode"), ("butterfly", "Butterfly"), ("custom", "Custom") })
            {
                <label class="flex items-center gap-2"><input type="radio" name="preset" value="@p.Item1" @(p.Item1 == "barcode" ? "checked" : "") class="accent-blue-600" /> @p.Item2</label>
            }
        </div>
    </div>

    <!-- Details to print -->
    <div class="border-t border-neutral-100 pt-5">
        <h3 class="text-sm font-medium text-neutral-800 mb-2">Details to print</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm text-neutral-700">
            <label class="flex items-center gap-2"><input type="checkbox" id="d-name" checked class="accent-blue-600" /> Name</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-price" checked class="accent-blue-600" /> Price</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-barcode" checked class="accent-blue-600" /> Barcode</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-barcodenum" class="accent-blue-600" /> Barcode number</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-qr" class="accent-blue-600" /> QR code</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-sku" class="accent-blue-600" /> SKU</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-category" class="accent-blue-600" /> Category</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-description" class="accent-blue-600" /> Description</label>
            <label class="flex items-center gap-2"><input type="checkbox" id="d-customtext-on" class="accent-blue-600" /> Custom text</label>
        </div>
        <input id="d-customtext" type="text" placeholder="Custom text to print on each label…" class="mt-2 w-full border border-neutral-200 rounded-md px-3 py-2 text-sm hidden focus:outline-none focus:border-blue-400" />
    </div>

    <!-- Printer + live preview -->
    <div class="border-t border-neutral-100 pt-5">
        <div class="grid sm:grid-cols-2 gap-5 items-start">
            <div>
                <h3 class="text-sm font-medium text-neutral-800 mb-2">Printer / label size</h3>
                <select id="lbl-printer" class="w-full border border-neutral-200 rounded-md px-3 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-400">
                    <option value="tag30x15" selected>Tag — 3×1.5cm (30×15mm)</option>
                    <option value="a4">A4 label sheet — many per page (Avery-style)</option>
                    <option value="thermal">Barcode / thermal printer — label roll (50×30mm)</option>
                    <option value="butterfly">Butterfly labels — jewellery tags (56×13mm)</option>
                </select>
                <p class="text-[11px] text-neutral-400 mt-1">Sets the page size when you print. A4 tiles many labels on a sheet; thermal &amp; butterfly print one label per page for a roll printer.</p>

                <div class="mt-4 grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-neutral-500 mb-1">Font</label>
                        <select id="lbl-font" class="w-full border border-neutral-200 rounded-md px-3 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-400">
                            <option value="arial">Arial</option>
                            <option value="verdana">Verdana</option>
                            <option value="tahoma">Tahoma</option>
                            <option value="trebuchet">Trebuchet MS</option>
                            <option value="georgia">Georgia</option>
                            <option value="times">Times New Roman</option>
                            <option value="courier">Courier New</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-neutral-500 mb-1">Font size (px)</label>
                        <div class="inline-flex items-center border border-neutral-200 rounded-md overflow-hidden w-full">
                            <button type="button" id="fs-minus" class="px-3 py-2 text-neutral-500 hover:bg-neutral-100">−</button>
                            <input id="lbl-fontsize" type="number" min="6" max="24" value="9" class="flex-1 w-full text-center text-sm py-2 focus:outline-none" />
                            <button type="button" id="fs-plus" class="px-3 py-2 text-neutral-500 hover:bg-neutral-100">+</button>
                        </div>
                    </div>
                </div>
                <p class="text-[11px] text-neutral-400 mt-1">Name, SKU, number &amp; price all print in this font &amp; size so everything fits small stock.</p>
            </div>
            <div>
                <h3 class="text-sm font-medium text-neutral-800 mb-2">Live preview</h3>
                <div id="lbl-preview-box" class="flex items-center justify-center bg-neutral-50 border border-neutral-200 rounded-md p-4 min-h-[130px]"></div>
                <p id="lbl-preview-note" class="text-[11px] text-neutral-400 mt-1 text-center">Sample — reflects your choices above.</p>
            </div>
        </div>
    </div>

    <!-- Picked products -->
    <div class="border-t border-neutral-100 pt-5">
        <h3 class="text-sm font-medium text-neutral-800 mb-2">Products to print</h3>
        <table class="w-full text-sm">
            <thead>
                <tr class="text-xs text-neutral-400 border-b border-neutral-100">
                    <th class="text-left py-2 font-medium">Product</th>
                    <th class="text-center py-2 font-medium w-32">Quantity</th>
                    <th class="w-10"></th>
                </tr>
            </thead>
            <tbody id="lbl-rows">
                <tr id="lbl-empty"><td colspan="3" class="py-4 text-center text-neutral-400 text-xs">Scan or search an item above to add it, or use a location / category for bulk.</td></tr>
            </tbody>
        </table>
    </div>

    <div class="flex items-center justify-end gap-3 border-t border-neutral-100 pt-5">
        <button type="button" id="lbl-preview" class="px-5 py-2.5 border border-blue-300 text-blue-700 text-sm rounded-md hover:bg-blue-50">Preview</button>
        <button type="button" id="lbl-generate" class="px-6 py-2.5 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700">Generate Labels</button>
    </div>
</div>

@section Scripts {
<script src="~/js/jsbarcode.min.js" asp-append-version="true"></script>
<script>
(function () {
    var picks = {};   // id → { name, qty }
    var el = function (id) { return document.getElementById(id); };
    function esc(s) { return String(s).replace(/[&<>]/g, function (m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m]; }); }

    // ── Quantity stepper ──
    el('qty-minus').addEventListener('click', function () { el('lbl-qty').value = Math.max(1, (parseInt(el('lbl-qty').value, 10) || 1) - 1); });
    el('qty-plus').addEventListener('click', function () { el('lbl-qty').value = (parseInt(el('lbl-qty').value, 10) || 1) + 1; });

    // ── Custom text toggle ──
    el('d-customtext-on').addEventListener('change', function () { el('d-customtext').classList.toggle('hidden', !this.checked); });

    // ── Picked products table ──
    function renderRows() {
        var rows = el('lbl-rows'); var ids = Object.keys(picks);
        if (!ids.length) { rows.innerHTML = '<tr id="lbl-empty"><td colspan="3" class="py-4 text-center text-neutral-400 text-xs">Scan or search an item above to add it, or use a location / category for bulk.</td></tr>'; return; }
        rows.innerHTML = ids.map(function (id) {
            var p = picks[id];
            return '<tr class="border-b border-neutral-50" data-id="' + id + '">'
                + '<td class="py-2 text-neutral-700">' + p.name + '</td>'
                + '<td class="py-2 text-center"><input type="number" min="1" value="' + p.qty + '" data-qty="' + id + '" class="w-20 text-center border border-neutral-200 rounded px-2 py-1 text-sm" /></td>'
                + '<td class="py-2 text-right"><button type="button" data-rm="' + id + '" class="text-red-400 hover:text-red-600 px-1">✕</button></td></tr>';
        }).join('');
    }
    el('lbl-rows').addEventListener('input', function (e) {
        var id = e.target.getAttribute('data-qty'); if (id && picks[id]) picks[id].qty = Math.max(1, parseInt(e.target.value, 10) || 1);
    });
    el('lbl-rows').addEventListener('click', function (e) {
        var rm = e.target.getAttribute('data-rm'); if (rm) { delete picks[rm]; renderRows(); updatePreview(); }
    });
    function addPick(id, nm) { if (!picks[id]) picks[id] = { name: nm, qty: parseInt(el('lbl-qty').value, 10) || 1 }; renderRows(); updatePreview(); }

    // ── Search typeahead ──
    var sug = el('lbl-suggest'); var t;
    el('lbl-search').addEventListener('input', function () {
        var q = this.value.trim(); clearTimeout(t);
        if (q.length < 2) { sug.classList.add('hidden'); return; }
        t = setTimeout(function () {
            fetch(__invBase + '/Products/LabelSearch?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (list) {
                    if (!list.length) { sug.classList.add('hidden'); return; }
                    sug.innerHTML = list.map(function (p) {
                        return '<button type="button" data-id="' + p.id + '" data-name="' + (p.name.replace(/"/g, '&quot;')) + '" class="block w-full text-left px-3 py-2 text-sm hover:bg-neutral-50">' + p.name + (p.sku ? ' <span class="text-neutral-400 font-mono text-xs">' + p.sku + '</span>' : '') + '</button>';
                    }).join('');
                    sug.classList.remove('hidden');
                });
        }, 200);
    });
    sug.addEventListener('click', function (e) {
        var b = e.target.closest('[data-id]'); if (!b) return;
        addPick(b.getAttribute('data-id'), b.getAttribute('data-name'));
        el('lbl-search').value = ''; sug.classList.add('hidden');
    });
    // Enter → exact barcode/SKU lookup (scanner-friendly). A scanned VARIANT barcode adds just that
    // variant (key "pid.vid"); a product barcode/SKU adds the whole product (all its variants).
    el('lbl-search').addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return; e.preventDefault();
        var code = this.value.trim(); if (!code) return;
        fetch(__invBase + '/Products/Lookup?barcode=' + encodeURIComponent(code))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.found) { return; }
                var key = (d.variantId != null) ? (d.id + '.' + d.variantId) : ('' + d.id);
                addPick(key, d.name);
                el('lbl-search').value = ''; sug.classList.add('hidden');
            });
    });
    document.addEventListener('click', function (e) { if (!sug.contains(e.target) && e.target !== el('lbl-search')) sug.classList.add('hidden'); });

    // ── Build the Labels URL ──
    function buildUrl() {
        var params = new URLSearchParams();
        var ids = Object.keys(picks).map(function (id) { return id + ':' + picks[id].qty; });
        if (ids.length) params.set('ids', ids.join(','));
        if (el('lbl-store').value) params.set('storeId', el('lbl-store').value);
        if (el('lbl-category').value) params.set('categoryId', el('lbl-category').value);
        params.set('qty', el('lbl-qty').value || '1');
        params.set('name', el('d-name').checked); params.set('price', el('d-price').checked);
        params.set('barcode', el('d-barcode').checked); params.set('category', el('d-category').checked);
        params.set('sku', el('d-sku').checked); params.set('barcodeNumber', el('d-barcodenum').checked);
        params.set('description', el('d-description').checked);
        params.set('qr', el('d-qr').checked);
        if (el('d-customtext-on').checked && el('d-customtext').value) params.set('customText', el('d-customtext').value);
        var preset = document.querySelector('input[name="preset"]:checked'); params.set('preset', preset ? preset.value : 'barcode');
        params.set('printer', el('lbl-printer').value || 'tag30x15');
        params.set('font', el('lbl-font').value || 'arial');
        params.set('fontSize', el('lbl-fontsize').value || '9');
        return __invBase + '/Products/Labels?' + params.toString();
    }

    // ── Live single-label preview (mirrors Labels.cshtml) ──
    // Font keys → CSS stacks. Keep in sync with ProductsController.LabelFonts.
    var LBL_FONTS = {
        arial: 'Arial, Helvetica, sans-serif', verdana: 'Verdana, Geneva, sans-serif',
        tahoma: 'Tahoma, Geneva, sans-serif', trebuchet: "'Trebuchet MS', Helvetica, sans-serif",
        georgia: "Georgia, 'Times New Roman', serif", times: "'Times New Roman', Times, serif",
        courier: "'Courier New', Courier, monospace"
    };
    function currentPreset() { var p = document.querySelector('input[name="preset"]:checked'); return p ? p.value : 'barcode'; }
    function updatePreview() {
        var box = el('lbl-preview-box'); if (!box) return;
        var ids = Object.keys(picks);
        var fp = ids.length ? picks[ids[0]] : null;
        var name = fp ? fp.name : 'Product Name';
        var code = '12345678';   // sample — each real product prints its own barcode/SKU
        var sku = '6012298';     // sample SKU number (no "SKU:" prefix on the label)
        var printer = el('lbl-printer').value || 'tag30x15';
        var lab = document.createElement('div');
        // A4 uses the preset's label width; thermal/butterfly show the physical label size instead.
        lab.className = 'label ' + (printer === 'a4' ? currentPreset() : 'pr-' + printer);
        lab.style.setProperty('--lbl-ff', LBL_FONTS[el('lbl-font').value] || LBL_FONTS.arial);
        lab.style.setProperty('--lbl-fs', (parseInt(el('lbl-fontsize').value, 10) || 9) + 'px');
        var html = '';
        if (printer === 'tag30x15') {
            // Horizontal tag preview — mirrors the print output (QR left, text right).
            var qr = el('d-qr').checked ? '<img class="qr" alt="QR" src="' + __invBase + '/Products/Qr?text=' + encodeURIComponent(code) + '" />' : '';
            var txt = '';
            if (el('d-name').checked) txt += '<div class="lname">' + esc(name) + '</div>';
            if (el('d-sku').checked) txt += '<div class="lsku">' + esc(sku) + '</div>';
            if (el('d-barcodenum').checked) txt += '<div class="lcode">' + code + '</div>';
            if (el('d-price').checked) txt += '<div class="lprice">₦100.58</div>';
            if (el('d-customtext-on').checked && el('d-customtext').value) txt += '<div class="lcustom">' + esc(el('d-customtext').value) + '</div>';
            html = '<div class="tagrow">' + qr + '<div class="tagtext">' + txt + '</div></div>';
        } else {
            // Order: name · SKU (above QR) · QR · barcode number (below QR) · price.
            if (el('d-category').checked) html += '<div class="lcat">Category</div>';
            if (el('d-name').checked) html += '<div class="lname">' + esc(name) + '</div>';
            if (el('d-description').checked) html += '<div class="ldesc">Sample description</div>';
            if (el('d-barcode').checked) html += '<svg class="bc"></svg>';
            if (el('d-sku').checked) html += '<div class="lsku">' + esc(sku) + '</div>';
            if (el('d-qr').checked) html += '<img class="qr" alt="QR" src="' + __invBase + '/Products/Qr?text=' + encodeURIComponent(code) + '" />';
            if (el('d-barcodenum').checked) html += '<div class="lcode">' + code + '</div>';
            if (el('d-price').checked) html += '<div class="lprice">₦100.58</div>';
            if (el('d-customtext-on').checked && el('d-customtext').value) html += '<div class="lcustom">' + esc(el('d-customtext').value) + '</div>';
        }
        lab.innerHTML = html || '<span style="color:#a3a3a3;font-size:12px;">Nothing selected to print</span>';
        box.innerHTML = ''; box.appendChild(lab);
        if (el('d-barcode').checked && window.JsBarcode) {
            try { JsBarcode(lab.querySelector('.bc'), code, { format: 'CODE39', width: 1.0, height: 38, displayValue: false, margin: 2 }); } catch (e) { }
        }
        var note = el('lbl-preview-note');
        if (note) note.textContent = fp ? ('Preview of "' + fp.name + '" — barcode/QR shown are samples.') : 'Sample — reflects your choices above.';
    }
    // ── Remember the last "Details to print" (and printer / font / preset) choice ──
    var PREFS_KEY = 'sg-label-prefs';
    var CHECK_IDS = ['d-name', 'd-price', 'd-barcode', 'd-barcodenum', 'd-qr', 'd-sku', 'd-category', 'd-description', 'd-customtext-on'];
    var VAL_IDS = ['lbl-printer', 'lbl-font', 'lbl-fontsize', 'd-customtext'];
    function savePrefs() {
        try {
            var s = {};
            CHECK_IDS.forEach(function (id) { var n = el(id); if (n) s[id] = n.checked; });
            VAL_IDS.forEach(function (id) { var n = el(id); if (n) s[id] = n.value; });
            var pr = document.querySelector('input[name="preset"]:checked'); if (pr) s.preset = pr.value;
            localStorage.setItem(PREFS_KEY, JSON.stringify(s));
        } catch (e) { }
    }
    function restorePrefs() {
        try {
            var s = JSON.parse(localStorage.getItem(PREFS_KEY) || 'null'); if (!s) return;
            CHECK_IDS.forEach(function (id) { var n = el(id); if (n && typeof s[id] === 'boolean') n.checked = s[id]; });
            VAL_IDS.forEach(function (id) { var n = el(id); if (n && s[id] != null && s[id] !== '') n.value = s[id]; });
            if (s.preset) { var pr = document.querySelector('input[name="preset"][value="' + s.preset + '"]'); if (pr) pr.checked = true; }
        } catch (e) { }
    }
    function onOptChange() { updatePreview(); savePrefs(); }

    // Font-size steppers.
    el('fs-minus').addEventListener('click', function () { el('lbl-fontsize').value = Math.max(6, (parseInt(el('lbl-fontsize').value, 10) || 9) - 1); onOptChange(); });
    el('fs-plus').addEventListener('click', function () { el('lbl-fontsize').value = Math.min(24, (parseInt(el('lbl-fontsize').value, 10) || 9) + 1); onOptChange(); });

    // Re-render the preview + remember the choice whenever any option changes.
    ['d-name', 'd-price', 'd-barcode', 'd-barcodenum', 'd-qr', 'd-sku', 'd-category', 'd-description', 'd-customtext-on', 'd-customtext', 'lbl-printer', 'lbl-font', 'lbl-fontsize']
        .forEach(function (id) { var n = el(id); if (n) { n.addEventListener('change', onOptChange); n.addEventListener('input', onOptChange); } });
    document.querySelectorAll('input[name="preset"]').forEach(function (r) { r.addEventListener('change', onOptChange); });
    function go() {
        if (!Object.keys(picks).length && !el('lbl-store').value && !el('lbl-category').value) {
            alert('Add at least one product, or choose a location / category.'); return;
        }
        window.open(buildUrl(), '_blank');
    }
    el('lbl-preview').addEventListener('click', go);
    el('lbl-generate').addEventListener('click', go);

    restorePrefs();    // apply the last-used details/printer/preset
    updatePreview();   // initial render
})();
</script>
}
