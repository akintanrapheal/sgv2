@{
    ViewData["Title"] = "Stock Take";
    var stores = ViewBag.Stores as List<SterlingLams.Web.Models.Domain.Store> ?? new();
    var staff = (ViewBag.Staff as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var reasons = ViewBag.Reasons as string[] ?? System.Array.Empty<string>();
    int? storeId = ViewBag.StoreId;
    string? staffId = ViewBag.StaffId;
    string storeName = ViewBag.StoreName ?? "";
    bool started = storeId != null;
    int? draftId = ViewBag.DraftId;
    string draftJson = ViewBag.DraftJson ?? "[]";
    string? draftNote = ViewBag.DraftNote;
    var drafts = (ViewBag.Drafts as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
}
@Html.AntiForgeryToken()

@if (!started)
{
    <div class="bg-white border border-neutral-200 rounded-md p-6 max-w-3xl">
        <h2 class="text-sm font-semibold text-neutral-800 mb-4">Select staff and location of the stock take</h2>
        <form asp-area="Inventory" asp-controller="Stocktake" asp-action="Index" method="get" class="space-y-4">
            <div class="grid grid-cols-[140px_1fr] items-center gap-4">
                <label class="text-sm text-neutral-600">Staff Member:</label>
                <select name="staffId" required class="border border-neutral-200 rounded-md px-3 py-2.5 text-sm bg-white">
                    <option value="">No staff member selected</option>
                    @foreach (var s in staff) { <option value="@s.id">@s.name</option> }
                </select>
                <label class="text-sm text-neutral-600">Location:</label>
                <select name="storeId" required class="border border-neutral-200 rounded-md px-3 py-2.5 text-sm bg-white">
                    <option value="">No location selected</option>
                    @foreach (var s in stores) { <option value="@s.Id">@s.Name</option> }
                </select>
            </div>
            @if (ViewData["CanManageInventory"] as bool? ?? true)
            {
                <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700">Start Stock Take</button>
            }
        </form>
    </div>

    @* Unfinished counts — resume exactly where it was left, or discard. *@
    @if (drafts.Any())
    {
        <div class="bg-white border border-neutral-200 rounded-md p-6 max-w-3xl mt-6">
            <h2 class="text-sm font-semibold text-neutral-800 mb-1">Resume previous</h2>
            <p class="text-xs text-neutral-500 mb-4">Unfinished stock takes — pick up where you left off, then complete them.</p>
            <div class="divide-y divide-neutral-100 border-t border-neutral-100">
                @foreach (var d in drafts)
                {
                    <div class="flex items-center justify-between gap-3 py-3">
                        <div class="min-w-0">
                            <p class="text-sm text-neutral-800 font-medium">@(((string)d.storeName).Replace("Sterlin Glams ", "")) · @d.itemCount item(s)</p>
                            <p class="text-xs text-neutral-500">@d.staffName · saved @(((DateTime)d.updatedAt).ToLocalTime().ToString("dd MMM, HH:mm"))</p>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <a asp-area="Inventory" asp-controller="Stocktake" asp-action="Index" asp-route-draftId="@d.id"
                               class="px-4 py-2 bg-sky-500 text-white text-xs font-medium rounded-md hover:bg-sky-600">Resume Previous</a>
                            <form asp-area="Inventory" asp-controller="Stocktake" asp-action="DiscardDraft" method="post" class="inline"
                                  onsubmit="return confirm('Discard this unfinished stock take?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.id" />
                                <button type="submit" class="px-3 py-2 border border-neutral-200 text-neutral-500 text-xs rounded-md hover:border-red-300 hover:text-red-600">Discard</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <style>
        .st-grid { display:grid; grid-template-columns: 34px minmax(200px,1.7fr) 96px 96px 110px 90px 190px 200px; align-items:center; gap:10px; }
        .st-box { border:1px solid #d4d4d8; border-radius:8px; padding:10px 12px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
        .st-box.exp { color:#2563eb; }
        .st-box input { width:100%; border:0; outline:0; font-size:14px; text-align:left; color:#111827; background:transparent; }
        .st-arrow { color:#2563eb; cursor:pointer; font-size:16px; line-height:1; }
        @@media print { .st-noprint { display:none !important; } }
    </style>

    <div id="st-app">
        <!-- Header -->
        <div class="flex items-center justify-between gap-3 mb-5 flex-wrap">
            <div>
                <h1 class="text-2xl font-semibold text-neutral-900">Stocktake</h1>
                <p class="text-xs text-neutral-500 mt-0.5">@storeName.Replace("Sterlin Glams ", "")</p>
            </div>
            <div class="flex items-center gap-2 st-noprint">
                <button type="button" id="st-notes-btn" class="px-4 py-2 bg-sky-500 text-white text-xs font-semibold uppercase tracking-wide rounded hover:bg-sky-600">Stocktake Notes</button>
                <button type="button" id="st-review-btn" class="px-4 py-2 bg-emerald-600 text-white text-xs font-semibold uppercase tracking-wide rounded hover:bg-emerald-700">Review Stocktake</button>
                <button type="button" id="st-back-btn" class="hidden px-4 py-2 border border-neutral-300 text-neutral-600 text-xs font-semibold uppercase tracking-wide rounded hover:bg-neutral-50">Back to Stocktake</button>
            </div>
        </div>

        <div id="st-notes" class="hidden mb-4 st-noprint">
            <textarea id="st-note" rows="2" placeholder="Stocktake notes…" class="w-full border border-neutral-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-400"></textarea>
        </div>

        <!-- ═══════════ COUNT VIEW ═══════════ -->
        <div id="st-count-view">
            <!-- Search + toggles -->
            <div class="flex items-center gap-5 mb-4 flex-wrap st-noprint">
                <div class="relative flex-1 min-w-[280px]">
                    <input id="st-search" type="text" autocomplete="off" placeholder="Uncheck quick scan to search manually for products"
                           class="w-full border border-neutral-300 rounded-md px-4 py-3 text-sm focus:outline-none focus:border-blue-400" />
                    <div id="st-suggest" class="hidden absolute z-30 left-0 right-0 mt-1 bg-white border border-neutral-200 rounded-md shadow-lg max-h-72 overflow-y-auto"></div>
                </div>
                <label class="flex items-center gap-2 text-sm text-neutral-700 whitespace-nowrap cursor-pointer select-none">
                    <input type="checkbox" id="st-quick" checked class="w-4 h-4 rounded accent-blue-600" /> Quick scan
                </label>
                <label class="flex items-center gap-2 text-sm text-neutral-700 whitespace-nowrap cursor-pointer select-none">
                    <input type="checkbox" id="st-decimal" class="w-4 h-4 rounded accent-blue-600" /> Show as Decimal
                </label>
            </div>

            <!-- Reason apply-all + list actions -->
            <div class="flex items-center gap-2 mb-4 flex-wrap st-noprint">
                <select id="st-reason-all" class="border border-neutral-200 rounded-md px-3 py-2 text-sm bg-white min-w-[180px]">
                    <option value="">Reason (required)</option>
                    @foreach (var r in reasons) { <option value="@r">@r</option> }
                </select>
                <button type="button" id="st-apply-all" class="px-4 py-2 bg-sky-500 text-white text-xs font-semibold uppercase tracking-wide rounded hover:bg-sky-600">Apply to all</button>
                <div class="ml-auto flex items-center gap-2">
                    <button type="button" id="st-print" class="px-4 py-2 border border-sky-400 text-sky-600 text-xs font-semibold uppercase tracking-wide rounded hover:bg-sky-50">Print</button>
                    <button type="button" id="st-clear" class="px-4 py-2 border border-sky-400 text-sky-600 text-xs font-semibold uppercase tracking-wide rounded hover:bg-sky-50">Clear list</button>
                    <button type="button" id="st-add" class="px-4 py-2 bg-sky-500 text-white text-xs font-semibold uppercase tracking-wide rounded hover:bg-sky-600">Add to list</button>
                </div>
            </div>

            <!-- Table -->
            <div class="bg-white border border-neutral-200 rounded-md overflow-x-auto">
                <div style="min-width:1000px">
                    <div class="st-grid px-4 py-3 border-b border-neutral-100 text-[11px] font-semibold uppercase tracking-wide text-sky-600">
                        <div></div><div>Product</div><div>Barcode</div><div>Supplier</div><div>Category</div><div>Brand</div>
                        <div>Expected stock and remaining volume</div><div>Actual stock and remaining volume</div>
                    </div>
                    <div id="st-rows">
                        <div id="st-empty" class="px-4 py-16 text-center text-neutral-400 text-sm">Search or scan a product to add it to the count.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════ REVIEW VIEW ═══════════ -->
        <div id="st-review-view" class="hidden">
            <p class="text-sm text-neutral-500 mb-4">Review the count below, set a reason for every difference, then complete the stock take.</p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
                <button type="button" data-filter="all" class="st-card rounded-md bg-blue-500 text-white text-center py-3"><div class="text-[10px] uppercase tracking-wide">Showing</div><div class="text-2xl font-semibold" id="c-all">0</div><div class="text-[11px]">All items</div></button>
                <button type="button" data-filter="disc" class="st-card rounded-md border-2 border-red-300 text-center py-3"><div class="text-[10px] uppercase tracking-wide text-red-400">Show</div><div class="text-2xl font-semibold text-red-500" id="c-disc">0</div><div class="text-[11px] text-red-500">Discrepancies</div></button>
                <button type="button" data-filter="correct" class="st-card rounded-md border-2 border-emerald-300 text-center py-3"><div class="text-[10px] uppercase tracking-wide text-emerald-500">Show</div><div class="text-2xl font-semibold text-emerald-600" id="c-correct">0</div><div class="text-[11px] text-emerald-600">Correct</div></button>
                <button type="button" data-filter="unc" class="st-card rounded-md border-2 border-neutral-300 text-center py-3"><div class="text-[10px] uppercase tracking-wide text-neutral-400">Show</div><div class="text-2xl font-semibold text-neutral-600" id="c-unc">0</div><div class="text-[11px] text-neutral-600">Uncounted</div></button>
            </div>

            <div class="bg-white border border-neutral-200 rounded-md overflow-x-auto">
                <table class="w-full text-sm min-w-[820px]">
                    <thead class="bg-neutral-50 text-[11px] font-semibold uppercase tracking-wide text-sky-600">
                        <tr>
                            <th class="text-left px-4 py-3">Product</th>
                            <th class="text-left px-4 py-3">Barcode</th>
                            <th class="text-left px-4 py-3">Category</th>
                            <th class="text-center px-4 py-3">Expected</th>
                            <th class="text-center px-4 py-3">Actual</th>
                            <th class="text-center px-4 py-3">Difference</th>
                            <th class="text-left px-4 py-3">Reason</th>
                        </tr>
                    </thead>
                    <tbody id="st-review-rows" class="divide-y divide-neutral-100"></tbody>
                </table>
            </div>

            <div class="flex items-center justify-end gap-2 mt-5 st-noprint">
                <button type="button" id="st-review-print" class="px-4 py-2 border border-sky-400 text-sky-600 text-xs font-semibold uppercase tracking-wide rounded hover:bg-sky-50">Print</button>
                <button type="button" id="st-back-btn2" class="px-4 py-2 border border-neutral-300 text-neutral-600 text-xs font-semibold uppercase tracking-wide rounded hover:bg-neutral-50">Back to Stocktake</button>
                <button type="button" id="st-complete" class="px-5 py-2 bg-emerald-600 text-white text-xs font-semibold uppercase tracking-wide rounded hover:bg-emerald-700">Complete Stocktake</button>
            </div>
        </div>
    </div>

    <!-- Overwrite prompt (positioned near the clicked expected arrow) -->
    <div id="st-overwrite" class="hidden fixed z-50 w-64 bg-white border border-neutral-200 rounded-lg shadow-xl p-4 text-center st-noprint">
        <p class="text-sm font-semibold text-neutral-800 mb-1">Overwrite actual value</p>
        <p class="text-xs text-neutral-500 mb-3">Transferring the expected value over will overwrite the existing actual value.</p>
        <div class="flex items-center justify-center gap-2">
            <button type="button" id="st-ow-cancel" class="px-4 py-1.5 border border-neutral-300 text-neutral-600 text-xs rounded hover:bg-neutral-50">Cancel</button>
            <button type="button" id="st-ow-ok" class="px-4 py-1.5 bg-sky-500 text-white text-xs font-semibold rounded hover:bg-sky-600">Overwrite</button>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    @if (!started) { <text>return;</text> }
    var storeId = @(storeId ?? 0);
    var staffId = '@(staffId ?? "")';
    var reasons = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reasons));
    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    var el = function (id) { return document.getElementById(id); };
    var lines = {};   // "productId:variantId" → { id, variantId, name, barcode, supplier, category, brand, expected, counted, reason }
    var quickScan = el('st-quick') ? el('st-quick').checked : true;
    var decimalMode = false;
    var reviewFilter = 'all';
    function refocusScan() { var s = el('st-search'); if (s) s.focus(); }
    function keyOf(id, variantId) { return id + ':' + (variantId != null && variantId !== '' ? variantId : ''); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (m) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]); }); }
    function num(v) { var n = decimalMode ? parseFloat(v) : parseInt(v, 10); return isNaN(n) ? null : n; }
    function isCounted(l) { return l.counted !== '' && l.counted != null; }
    function isDiff(l) { return isCounted(l) && num(l.counted) !== l.expected; }

    // ── Draft auto-save ────────────────────────────────────────────────────────
    var draftId = @(draftId?.ToString() ?? "null");
    var preloaded = @Html.Raw(draftJson);
    var draftNote = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(draftNote));
    var saveTimer = null, restoring = false;

    function currentLinesForSave() {
        return Object.keys(lines).map(function (key) {
            var l = lines[key];
            return { id: l.id, variantId: (l.variantId != null ? l.variantId : null), name: l.name,
                barcode: l.barcode, category: l.category, expected: l.expected,
                counted: (l.counted === null || l.counted === undefined) ? '' : String(l.counted),
                reason: l.reason || null };
        });
    }
    function saveDraft(keepalive) {
        if (restoring) return Promise.resolve();
        return fetch(__invBase + '/Stocktake/SaveDraft', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            keepalive: !!keepalive,
            body: JSON.stringify({ draftId: draftId, storeId: storeId, staffId: staffId,
                note: el('st-note') ? el('st-note').value : null, lines: currentLinesForSave() })
        }).then(function (r) { return r.json(); })
          .then(function (d) { if (d && d.success && d.draftId) draftId = d.draftId; })
          .catch(function () {});
    }
    function scheduleSave() { if (restoring) return; clearTimeout(saveTimer); saveTimer = setTimeout(function () { saveDraft(false); }, 1200); }

    function reasonOptions(sel) {
        return '<option value="">Reason (required)</option>' + reasons.map(function (r) { return '<option value="' + esc(r) + '"' + (r === sel ? ' selected' : '') + '>' + esc(r) + '</option>'; }).join('');
    }

    // ── Count view row ─────────────────────────────────────────────────────────
    function rowHtml(key, l) {
        var counted = (l.counted === null || l.counted === undefined) ? '' : l.counted;
        var diff = isDiff(l);
        var step = decimalMode ? '0.01' : '1';
        return '<div class="border-b border-neutral-100" data-key="' + esc(key) + '">'
            + '<div class="st-grid px-4 py-3">'
            +   '<div><button type="button" data-rm class="w-6 h-6 rounded-full border border-neutral-300 text-neutral-400 hover:text-red-600 hover:border-red-300 flex items-center justify-center text-xs">✕</button></div>'
            +   '<div class="text-sm text-neutral-800 leading-tight">' + esc(l.name) + '</div>'
            +   '<div class="text-xs text-neutral-500 font-mono">' + esc(l.barcode || '') + '</div>'
            +   '<div class="text-xs text-neutral-500">' + esc(l.supplier || '') + '</div>'
            +   '<div class="text-xs text-neutral-600">' + esc(l.category || '') + '</div>'
            +   '<div class="text-xs text-neutral-500">' + esc(l.brand || '') + '</div>'
            +   '<div class="st-box exp"><span class="font-medium">' + l.expected + '</span><button type="button" data-transfer title="Copy expected to actual" class="st-arrow">➔</button></div>'
            +   '<div class="st-box"><input type="number" inputmode="' + (decimalMode ? 'decimal' : 'numeric') + '" min="0" step="' + step + '" value="' + counted + '" data-counted placeholder="0" /><span class="text-neutral-400 text-xs">✎</span></div>'
            + '</div>'
            + '<div class="st-grid px-4 pb-3 ' + (diff ? '' : 'hidden') + '" data-reasonline>'
            +   '<div style="grid-column:2 / 8" class="text-right text-xs text-neutral-500 pr-2">Please select a reason for the difference</div>'
            +   '<div style="grid-column:8"><select data-reason class="w-full text-xs border-0 border-b border-neutral-300 focus:outline-none focus:border-sky-500 py-1 bg-transparent">' + reasonOptions(l.reason) + '</select></div>'
            + '</div>'
            + '</div>';
    }
    function render() {
        var rows = el('st-rows'); var ids = Object.keys(lines);
        if (!ids.length) { rows.innerHTML = '<div id="st-empty" class="px-4 py-16 text-center text-neutral-400 text-sm">Search or scan a product to add it to the count.</div>'; updateCards(); return; }
        rows.innerHTML = ids.map(function (key) { return rowHtml(key, lines[key]); }).join('');
        updateCards();
    }
    function updateCards() {
        var ids = Object.keys(lines);
        var counted = ids.filter(function (id) { return isCounted(lines[id]); });
        var disc = counted.filter(function (id) { return isDiff(lines[id]); });
        if (el('c-all')) el('c-all').textContent = ids.length;
        if (el('c-disc')) el('c-disc').textContent = disc.length;
        if (el('c-correct')) el('c-correct').textContent = counted.length - disc.length;
        if (el('c-unc')) el('c-unc').textContent = ids.length - counted.length;
    }

    // scan=true → barcode scan: create at 1, or +1 each additional scan.
    function addLine(p, scan) {
        var key = keyOf(p.id, p.variantId);
        if (!lines[key]) {
            lines[key] = { id: p.id, variantId: (p.variantId != null ? p.variantId : null),
                name: p.name, barcode: p.barcode, supplier: p.supplier || '', category: p.category, brand: p.brand || '',
                expected: p.expected, counted: scan ? 1 : '', reason: '' };
        } else if (scan) {
            var cur = num(lines[key].counted); if (cur == null) cur = 0;
            lines[key].counted = cur + 1;
        }
        render();
        var tr = el('st-rows').querySelector('[data-key="' + key + '"]');
        if (tr) {
            tr.scrollIntoView({ block: 'center' });
            if (quickScan || scan) refocusScan();
            else { var i = tr.querySelector('[data-counted]'); if (i) { i.focus(); i.select(); } }
        }
        scheduleSave();
    }

    // ── Count-view row interactions ────────────────────────────────────────────
    el('st-rows').addEventListener('input', function (e) {
        if (!e.target.hasAttribute('data-counted')) return;
        var block = e.target.closest('[data-key]'); var key = block.dataset.key;
        lines[key].counted = e.target.value;
        block.querySelector('[data-reasonline]').classList.toggle('hidden', !isDiff(lines[key]));
        updateCards(); scheduleSave();
    });
    el('st-rows').addEventListener('change', function (e) {
        if (e.target.hasAttribute('data-reason')) { lines[e.target.closest('[data-key]').dataset.key].reason = e.target.value; scheduleSave(); }
    });
    el('st-rows').addEventListener('click', function (e) {
        var rm = e.target.closest('[data-rm]');
        if (rm) { delete lines[rm.closest('[data-key]').dataset.key]; render(); scheduleSave(); return; }
        var tr = e.target.closest('[data-transfer]');
        if (tr) { openOverwrite(tr, tr.closest('[data-key]').dataset.key); }
    });

    // ── Overwrite expected → actual prompt ─────────────────────────────────────
    var owPop = el('st-overwrite'), owKey = null;
    function openOverwrite(anchor, key) {
        owKey = key;
        var r = anchor.getBoundingClientRect();
        owPop.classList.remove('hidden');
        var top = r.bottom + 8, left = r.left + r.width / 2 - owPop.offsetWidth / 2;
        left = Math.max(8, Math.min(left, window.innerWidth - owPop.offsetWidth - 8));
        if (top + owPop.offsetHeight > window.innerHeight - 8) top = r.top - owPop.offsetHeight - 8;
        owPop.style.top = top + 'px'; owPop.style.left = left + 'px';
    }
    function closeOverwrite() { owPop.classList.add('hidden'); owKey = null; }
    el('st-ow-cancel').addEventListener('click', closeOverwrite);
    el('st-ow-ok').addEventListener('click', function () {
        if (owKey && lines[owKey]) { lines[owKey].counted = lines[owKey].expected; render(); scheduleSave(); }
        closeOverwrite();
    });
    document.addEventListener('click', function (e) {
        if (!owPop.classList.contains('hidden') && !owPop.contains(e.target) && !e.target.closest('[data-transfer]')) closeOverwrite();
    });
    window.addEventListener('resize', closeOverwrite);

    // ── Search / scan ──────────────────────────────────────────────────────────
    var sug = el('st-suggest'); var t;
    el('st-search').addEventListener('input', function () {
        var q = this.value.trim(); clearTimeout(t);
        if (quickScan || q.length < 2) { sug.classList.add('hidden'); return; }
        t = setTimeout(function () {
            fetch(__invBase + '/Stocktake/StSearch?storeId=' + storeId + '&q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); }).then(showSuggestions);
        }, 200);
    });
    function showSuggestions(list) {
        if (!list || !list.length) { sug.classList.add('hidden'); return; }
        sug.innerHTML = list.map(function (p) {
            return '<button type="button" data-p="' + esc(JSON.stringify(p)) + '" class="flex items-center justify-between gap-3 w-full text-left px-4 py-2.5 text-sm hover:bg-neutral-50 border-b border-neutral-50">'
                + '<span>' + esc(p.name) + '</span><span class="text-sky-600 text-xs">Add</span></button>';
        }).join('');
        sug.classList.remove('hidden');
    }
    sug.addEventListener('click', function (e) {
        var b = e.target.closest('[data-p]'); if (!b) return;
        var raw = b.getAttribute('data-p').replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
        addLine(JSON.parse(raw), false);
        el('st-search').value = ''; sug.classList.add('hidden');
    });
    function doScan() {
        var code = el('st-search').value.trim(); if (!code) return;
        fetch(__invBase + '/Stocktake/ScanLookup?storeId=' + storeId + '&code=' + encodeURIComponent(code))
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.found) { addLine(d, true); el('st-search').value = ''; sug.classList.add('hidden'); return; }
                if (d.needsVariant && d.variants && d.variants.length) { showSuggestions(d.variants); return; }
                alert(d.message || ('No product matches “' + code + '”.'));
                el('st-search').value = '';
            });
    }
    el('st-search').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doScan(); } });
    el('st-add').addEventListener('click', doScan);
    document.addEventListener('click', function (e) { if (!sug.contains(e.target) && e.target !== el('st-search')) sug.classList.add('hidden'); });

    // ── Quick scan focus + decimal toggle ──────────────────────────────────────
    (function () {
        var chk = el('st-quick');
        function applyMode() {
            quickScan = chk.checked;
            el('st-search').placeholder = quickScan ? 'Scan a barcode…' : 'Uncheck quick scan to search manually for products';
            if (quickScan) { sug.classList.add('hidden'); refocusScan(); }
        }
        chk.addEventListener('change', applyMode);
        el('st-search').addEventListener('blur', function () {
            if (!quickScan) return;
            setTimeout(function () { var a = document.activeElement; if (!a || a === document.body) refocusScan(); }, 0);
        });
        applyMode();
    })();
    el('st-decimal').addEventListener('change', function () { decimalMode = this.checked; render(); });

    el('st-notes-btn').addEventListener('click', function () { el('st-notes').classList.toggle('hidden'); });
    if (el('st-note')) el('st-note').addEventListener('input', scheduleSave);
    el('st-apply-all').addEventListener('click', function () {
        var r = el('st-reason-all').value; if (!r) { alert('Pick a reason first.'); return; }
        Object.keys(lines).forEach(function (k) { if (isDiff(lines[k])) lines[k].reason = r; });
        render(); scheduleSave();
    });
    el('st-clear').addEventListener('click', function () { if (confirm('Clear the count list?')) { lines = {}; render(); scheduleSave(); } });
    el('st-print').addEventListener('click', function () { window.print(); });
    el('st-review-print').addEventListener('click', function () { window.print(); });

    window.addEventListener('pagehide', function () { if (Object.keys(lines).length) saveDraft(true); });

    // ── Review view ────────────────────────────────────────────────────────────
    function showCount() {
        el('st-review-view').classList.add('hidden');
        el('st-count-view').classList.remove('hidden');
        el('st-review-btn').classList.remove('hidden');
        el('st-back-btn').classList.add('hidden');
        if (quickScan) refocusScan();
    }
    function showReview() {
        if (!Object.keys(lines).length) { alert('Search or scan at least one product first.'); return; }
        el('st-count-view').classList.add('hidden');
        el('st-review-view').classList.remove('hidden');
        el('st-review-btn').classList.add('hidden');
        el('st-back-btn').classList.remove('hidden');
        renderReview();
    }
    function renderReview() {
        updateCards();
        var body = el('st-review-rows');
        var keys = Object.keys(lines).filter(function (k) {
            var l = lines[k];
            if (reviewFilter === 'disc') return isDiff(l);
            if (reviewFilter === 'correct') return isCounted(l) && !isDiff(l);
            if (reviewFilter === 'unc') return !isCounted(l);
            return true;
        });
        if (!keys.length) { body.innerHTML = '<tr><td colspan="7" class="px-4 py-12 text-center text-neutral-400 text-sm">No items in this view.</td></tr>'; }
        else body.innerHTML = keys.map(function (k) {
            var l = lines[k];
            var counted = isCounted(l) ? num(l.counted) : null;
            var d = counted == null ? null : counted - l.expected;
            var dCls = d == null ? 'text-neutral-400' : (d === 0 ? 'text-emerald-600' : (d > 0 ? 'text-amber-600' : 'text-red-600'));
            var dTxt = d == null ? '—' : (d > 0 ? '+' + d : d);
            var reasonCell = isDiff(l)
                ? '<select data-rvreason data-key="' + esc(k) + '" class="text-xs border border-neutral-200 rounded px-2 py-1 ' + (l.reason ? '' : 'border-red-300') + '">' + reasonOptions(l.reason) + '</select>'
                : '<span class="text-xs text-neutral-300">—</span>';
            return '<tr class="hover:bg-neutral-50">'
                + '<td class="px-4 py-2.5 text-neutral-800">' + esc(l.name) + '</td>'
                + '<td class="px-4 py-2.5 text-neutral-500 font-mono text-xs">' + esc(l.barcode || '—') + '</td>'
                + '<td class="px-4 py-2.5 text-neutral-500 text-xs">' + esc(l.category || '—') + '</td>'
                + '<td class="px-4 py-2.5 text-center text-neutral-600">' + l.expected + '</td>'
                + '<td class="px-4 py-2.5 text-center text-neutral-900 font-medium">' + (counted == null ? '—' : counted) + '</td>'
                + '<td class="px-4 py-2.5 text-center font-medium ' + dCls + '">' + dTxt + '</td>'
                + '<td class="px-4 py-2.5">' + reasonCell + '</td>'
                + '</tr>';
        }).join('');
    }
    el('st-review-btn').addEventListener('click', showReview);
    el('st-back-btn').addEventListener('click', showCount);
    el('st-back-btn2').addEventListener('click', showCount);
    el('st-review-rows').addEventListener('change', function (e) {
        if (!e.target.hasAttribute('data-rvreason')) return;
        lines[e.target.dataset.key].reason = e.target.value;
        e.target.classList.toggle('border-red-300', !e.target.value);
        scheduleSave();
    });
    // Clickable summary cards filter the review list.
    Array.prototype.forEach.call(document.querySelectorAll('.st-card'), function (card) {
        card.addEventListener('click', function () {
            reviewFilter = card.dataset.filter;
            document.querySelectorAll('.st-card').forEach(function (c) { c.classList.toggle('ring-2', c === card); c.classList.toggle('ring-offset-1', c === card); c.classList.toggle('ring-sky-400', c === card); });
            renderReview();
        });
    });

    // ── Complete ───────────────────────────────────────────────────────────────
    el('st-complete').addEventListener('click', function () {
        var payload = []; var missingReason = false;
        Object.keys(lines).forEach(function (key) {
            var l = lines[key];
            if (!isCounted(l)) return;
            var c = num(l.counted); if (c == null) return;
            var ci = Math.round(c);
            if (ci !== l.expected && !l.reason) missingReason = true;
            payload.push({ productId: l.id, variantId: (l.variantId != null ? l.variantId : null), counted: ci, reason: l.reason || null });
        });
        if (!payload.length) { alert('Enter at least one count.'); return; }
        if (missingReason) { alert('Please select a reason for each difference.'); reviewFilter = 'disc'; renderReview(); return; }
        if (!confirm('Complete this stock take for ' + payload.length + ' item(s)? This adjusts stock.')) return;
        var btn = el('st-complete'); btn.disabled = true; btn.textContent = 'Completing…';
        fetch(__invBase + '/Stocktake/Complete', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ draftId: draftId, storeId: storeId, staffId: staffId, note: el('st-note').value, lines: payload })
        })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) { restoring = true; window.location.href = __invBase + '/Stocktake/Details/' + d.id; }
                else { alert(d.message || 'Could not complete.'); btn.disabled = false; btn.textContent = 'Complete Stocktake'; }
            })
            .catch(function () { alert('Could not complete.'); btn.disabled = false; btn.textContent = 'Complete Stocktake'; });
    });

    // ── Resume draft ───────────────────────────────────────────────────────────
    if (preloaded && preloaded.length) {
        restoring = true;
        preloaded.forEach(function (l) {
            if (l == null || l.id == null) return;
            var key = keyOf(l.id, l.variantId);
            lines[key] = { id: l.id, variantId: (l.variantId != null ? l.variantId : null),
                name: l.name, barcode: l.barcode, supplier: l.supplier || '', category: l.category, brand: l.brand || '',
                expected: l.expected, counted: (l.counted == null ? '' : l.counted), reason: l.reason || '' };
        });
        render();
        if (draftNote && el('st-note')) { el('st-note').value = draftNote; el('st-notes').classList.remove('hidden'); }
        restoring = false;
    }
})();
</script>
}
