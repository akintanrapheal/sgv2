@model List<string>
@{
    ViewData["Title"] = "Roles & permissions";
    var grants = ViewBag.Grants as Dictionary<string, HashSet<string>> ?? new();
    var locked = (ViewBag.LockedRoles as string[]) ?? System.Array.Empty<string>();
    var tabs = SterlingLams.Web.Areas.Inventory.InventorySections.All;
}

<div class="flex items-center justify-between mb-2">
    <h1 class="font-cormorant text-3xl font-light">Roles &amp; permissions</h1>
    <a asp-controller="Org" asp-action="Staff" class="text-sm text-neutral-500 hover:text-neutral-900">← Staff &amp; roles</a>
</div>
<p class="text-xs text-neutral-400 mb-6">Tick which <strong>Inventory System</strong> tabs each role can open (View) and change (Manage). Full <strong>Inventory System</strong> access is granted in the Website Admin (Roles &amp; Permissions → Inventory System); the owner account always has full access.</p>

@if (TempData["Success"] != null)
{ <div class="mb-4 rounded-sm bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-2.5">@TempData["Success"]</div> }
@if (TempData["Error"] != null)
{ <div class="mb-4 rounded-sm bg-rose-50 border border-rose-200 text-rose-700 text-sm px-4 py-2.5">@TempData["Error"]</div> }

<div class="space-y-4">
    @foreach (var role in Model)
    {
        var g = grants.TryGetValue(role, out var set) ? set : new HashSet<string>();
        var isFull = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(role, "Owner", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(role, "Developer", StringComparison.OrdinalIgnoreCase);
        var hasUmbrella = g.Contains("InventorySystem") || g.Contains("InventorySystem:manage");
        var grantedCount = tabs.Count(sec => g.Contains(sec.Key) || g.Contains(sec.Key + ":manage"));
        <details class="bg-white border border-neutral-200 rounded-sm" @(Model.Count == 1 ? "open" : "")>
            <summary class="cursor-pointer list-none flex items-center justify-between px-5 py-3.5 select-none">
                <span class="flex items-center gap-2">
                    <span class="font-medium text-neutral-800">@role</span>
                    @if (locked.Contains(role)) { <span class="text-[10px] uppercase tracking-wide text-neutral-400 border border-neutral-200 rounded px-1.5 py-0.5">Built-in</span> }
                    @if (isFull) { <span class="text-[10px] uppercase tracking-wide text-amber-600 border border-amber-200 rounded px-1.5 py-0.5">Full access by default</span> }
                    else if (hasUmbrella) { <span class="text-[10px] uppercase tracking-wide text-emerald-600 border border-emerald-200 rounded px-1.5 py-0.5">Full Inventory System</span> }
                </span>
                <span class="text-xs text-neutral-400">@(hasUmbrella || isFull ? "all tabs" : $"{grantedCount} of {tabs.Count} tabs")</span>
            </summary>
            <form asp-controller="Org" asp-action="SaveRolePermissions" method="post" class="border-t border-neutral-100 px-5 py-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleName" value="@role" />
                @if (hasUmbrella)
                {
                    <p class="mb-4 rounded-sm bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs px-3 py-2">
                        This role has <strong>full Inventory System access</strong>, granted in the Website Admin. The per-tab settings below only take effect once that umbrella grant is removed there.
                    </p>
                }
                <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2.5">
                    @foreach (var sec in tabs)
                    {
                        var viewOn = g.Contains(sec.Key) || g.Contains(sec.Key + ":manage");
                        var manageOn = g.Contains(sec.Key + ":manage");
                        <div class="flex items-center justify-between border-b border-neutral-50 pb-2">
                            <span class="min-w-0">
                                <span class="text-sm text-neutral-700 block truncate">@sec.Label</span>
                                <span class="text-[11px] text-neutral-400 block truncate">@sec.Blurb</span>
                            </span>
                            <span class="flex items-center gap-3 text-xs flex-shrink-0">
                                <label class="flex items-center gap-1 text-neutral-500">
                                    <input type="checkbox" name="sections" value="@sec.Key" data-key="@sec.Key"
                                           class="perm-view" @(viewOn ? "checked" : "") /> View
                                </label>
                                <label class="flex items-center gap-1 text-neutral-500">
                                    <input type="checkbox" name="sections" value="@(sec.Key):manage" data-key="@sec.Key"
                                           class="perm-manage" @(manageOn ? "checked" : "") /> Manage
                                </label>
                            </span>
                        </div>
                    }
                </div>
                <div class="mt-4 flex items-center gap-3">
                    <button type="submit" class="px-4 py-2 bg-neutral-900 text-white text-sm rounded-sm hover:bg-neutral-700 transition-colors">Save @role</button>
                    @if (isFull) { <span class="text-[11px] text-neutral-400">Note: Admin/Owner/Developer currently have full access system-wide regardless of these grants.</span> }
                </div>
            </form>
        </details>
    }
</div>

@section Scripts {
<script>
// Manage implies View; clearing View clears Manage (per row, keyed by data-key).
document.querySelectorAll('.perm-manage').forEach(function (cb) {
    cb.addEventListener('change', function () {
        if (cb.checked) {
            var v = document.querySelector('.perm-view[data-key="' + cb.dataset.key + '"]');
            if (v) v.checked = true;
        }
    });
});
document.querySelectorAll('.perm-view').forEach(function (cb) {
    cb.addEventListener('change', function () {
        if (!cb.checked) {
            var m = document.querySelector('.perm-manage[data-key="' + cb.dataset.key + '"]');
            if (m) m.checked = false;
        }
    });
});
</script>
}
