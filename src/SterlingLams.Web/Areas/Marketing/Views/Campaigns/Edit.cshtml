@model SterlingLams.Web.Models.Domain.Campaign
@using SterlingLams.Web.Models.Domain
@{
    // Full-screen chrome — the builder takes over the whole viewport like Retainful (no Marketing nav).
    Layout = "_BuilderLayout";
    ViewData["Title"] = Model.Id == 0 ? "New Campaign" : "Edit Campaign";
    // Seed the composer: an existing block layout round-trips; a legacy HTML body becomes one HTML block.
    var seed = System.Text.Json.JsonSerializer.Serialize(new { layout = Model.LayoutJson, body = Model.BodyHtml });
    var savedSegs = ViewBag.Segments as List<SterlingLams.Web.Models.Domain.Segment> ?? new();
}

<script id="seed" type="application/json">@Html.Raw(seed)</script>

<style>
    /* ───────── Retainful-style email builder (scoped) ───────── */
    #sl-editor { --sl-line:#e5e7eb; --sl-ink:#1f2937; --sl-mut:#6b7280; --sl-brand:#c90278; }
    /* Full-screen: the editor is the whole viewport; the top bar is fixed and the workspace scrolls inside. */
    #sl-editor { overflow:hidden; background:#fff; display:flex; flex-direction:column; height:100vh; height:100dvh; }
    #sl-editor * { box-sizing:border-box; }
    .sl-top { display:flex; align-items:center; gap:12px; padding:10px 14px; border-bottom:1px solid var(--sl-line); background:#fff; flex-wrap:wrap; flex:0 0 auto; }
    .sl-top .name-in { font-size:14px; font-weight:600; color:var(--sl-ink); border:1px solid transparent; border-radius:6px; padding:6px 8px; min-width:220px; flex:1 1 240px; }
    .sl-top .name-in:hover { border-color:var(--sl-line); }
    .sl-top .name-in:focus { outline:none; border-color:var(--sl-brand); background:#fff; }
    .sl-spacer { flex:1 1 auto; }
    .sl-seg { display:inline-flex; border:1px solid var(--sl-line); border-radius:7px; overflow:hidden; }
    .sl-seg button { border:0; background:#fff; padding:6px 12px; font-size:12px; color:var(--sl-mut); display:inline-flex; align-items:center; gap:5px; cursor:pointer; }
    .sl-seg button + button { border-left:1px solid var(--sl-line); }
    .sl-seg button.on { background:#111827; color:#fff; }
    .sl-chip { font-size:12px; color:var(--sl-mut); white-space:nowrap; }
    .sl-ico-btn { border:1px solid var(--sl-line); background:#fff; width:32px; height:32px; border-radius:7px; cursor:pointer; color:var(--sl-ink); display:inline-flex; align-items:center; justify-content:center; }
    .sl-ico-btn:disabled { opacity:.35; cursor:default; }
    .sl-ico-btn:not(:disabled):hover { background:#f9fafb; }
    .sl-btn { border:1px solid var(--sl-line); background:#fff; border-radius:7px; padding:7px 14px; font-size:13px; cursor:pointer; color:var(--sl-ink); }
    .sl-btn:hover { background:#f9fafb; }
    .sl-btn-primary { background:#111827; color:#fff; border-color:#111827; }
    .sl-btn-primary:hover { background:#000; }

    .sl-work { display:flex; align-items:stretch; flex:1 1 auto; min-height:0; }
    .sl-rail { width:312px; flex:0 0 312px; border-right:1px solid var(--sl-line); background:#fff; display:flex; flex-direction:column; overflow-y:auto; }
    .sl-stage { flex:1 1 auto; background:#f3f4f6; padding:26px 16px; overflow:auto; }
    .sl-tabs { display:flex; border-bottom:1px solid var(--sl-line); position:sticky; top:0; background:#fff; z-index:2; }
    .sl-tabs button { flex:1; border:0; background:#fff; padding:11px 0; font-size:13px; color:var(--sl-mut); cursor:pointer; border-bottom:2px solid transparent; }
    .sl-tabs button.on { color:var(--sl-ink); border-bottom-color:var(--sl-brand); font-weight:600; }
    .sl-rail-head { display:flex; align-items:center; gap:8px; padding:12px 14px; border-bottom:1px solid var(--sl-line); font-size:13px; font-weight:600; color:var(--sl-ink); }
    .sl-back { border:0; background:none; cursor:pointer; color:var(--sl-mut); font-size:13px; display:inline-flex; align-items:center; gap:4px; padding:0; }
    .sl-back:hover { color:var(--sl-ink); }

    .sl-pal-sec { padding:14px; }
    .sl-pal-sec h4 { font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--sl-mut); margin:0 0 10px; font-weight:600; }
    .sl-pal-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .sl-pal-item { border:1px solid var(--sl-line); border-radius:8px; background:#fff; padding:12px 6px; display:flex; flex-direction:column; align-items:center; gap:6px; font-size:11px; color:var(--sl-ink); cursor:grab; transition:.12s; }
    .sl-pal-item:hover { border-color:var(--sl-brand); color:var(--sl-brand); box-shadow:0 1px 4px rgba(0,0,0,.05); }
    .sl-pal-item svg { width:20px; height:20px; stroke:currentColor; fill:none; stroke-width:1.6; }
    .sl-tpl-list { display:flex; flex-direction:column; gap:8px; }
    .sl-tpl { display:flex; align-items:center; justify-content:space-between; border:1px solid var(--sl-line); border-radius:8px; background:#fff; padding:11px 12px; font-size:13px; color:var(--sl-ink); cursor:pointer; text-align:left; }
    .sl-tpl:hover { border-color:var(--sl-brand); background:#fdf2f8; }
    .sl-tpl-name { font-weight:500; }
    .sl-tpl-add { font-size:11px; color:var(--sl-brand); font-weight:600; }

    .sl-cfg { padding:14px; }
    .sl-cfg-sec { border-top:1px solid var(--sl-line); padding:14px 0; }
    .sl-cfg-sec:first-child { border-top:0; padding-top:4px; }
    .sl-cfg-sec > h5 { font-size:12px; font-weight:600; color:var(--sl-ink); margin:0 0 10px; }
    .sl-field { margin-bottom:10px; }
    .sl-field > label { display:block; font-size:11px; color:var(--sl-mut); margin-bottom:4px; }
    .sl-in, .sl-sel, .sl-ta { width:100%; border:1px solid var(--sl-line); border-radius:6px; padding:7px 9px; font-size:13px; color:var(--sl-ink); background:#fff; }
    .sl-in:focus, .sl-sel:focus, .sl-ta:focus { outline:none; border-color:var(--sl-brand); }
    .sl-ta { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; }
    .sl-row2 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .sl-row4 { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
    .sl-color { display:flex; align-items:center; gap:7px; }
    .sl-color input[type=color] { width:34px; height:30px; border:1px solid var(--sl-line); border-radius:6px; padding:1px; background:#fff; cursor:pointer; }
    .sl-alignseg { display:inline-flex; border:1px solid var(--sl-line); border-radius:6px; overflow:hidden; }
    .sl-alignseg button { border:0; background:#fff; padding:7px 12px; cursor:pointer; color:var(--sl-mut); }
    .sl-alignseg button + button { border-left:1px solid var(--sl-line); }
    .sl-alignseg button.on { background:#111827; color:#fff; }
    .sl-alignseg svg { width:15px; height:15px; stroke:currentColor; fill:none; stroke-width:1.7; display:block; }
    .sl-toggle-row { display:flex; gap:6px; }
    .sl-tgl { flex:1; border:1px solid var(--sl-line); background:#fff; border-radius:6px; padding:7px 0; font-size:13px; cursor:pointer; color:var(--sl-mut); }
    .sl-tgl.on { background:#111827; color:#fff; border-color:#111827; }
    .sl-vis label { display:flex; gap:10px; align-items:flex-start; border:1px solid var(--sl-line); border-radius:8px; padding:11px 12px; margin-bottom:8px; cursor:pointer; }
    .sl-vis label.on { border-color:var(--sl-brand); background:#fdf2f8; }
    .sl-vis .t { font-size:13px; color:var(--sl-ink); font-weight:500; }
    .sl-vis .d { font-size:11px; color:var(--sl-mut); }

    /* Canvas */
    .sl-canvas { background:#fff; margin:0 auto; max-width:600px; width:100%; min-height:420px; box-shadow:0 1px 8px rgba(0,0,0,.08); border-radius:4px; transition:max-width .18s; }
    .sl-canvas.mobile { max-width:360px; }
    .sl-canvas-pad { padding:24px 20px; }
    .sl-wrap { position:relative; outline:1px dashed transparent; border-radius:3px; }
    .sl-wrap:hover { outline-color:#d9b8cd; }
    .sl-wrap.sel { outline:2px solid var(--sl-brand); outline-offset:0; }
    .sl-wrap.drag-over { outline:2px dashed var(--sl-brand); }
    .sl-tb { position:absolute; top:-14px; right:6px; display:none; gap:2px; background:#111827; border-radius:6px; padding:2px; z-index:5; box-shadow:0 2px 6px rgba(0,0,0,.25); }
    .sl-wrap.sel .sl-tb { display:flex; }
    .sl-tb button { border:0; background:none; color:#fff; width:24px; height:22px; border-radius:4px; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; font-size:12px; }
    .sl-tb button:hover { background:rgba(255,255,255,.18); }
    .sl-tb .lbl { color:#fff; font-size:10px; padding:0 7px 0 5px; display:inline-flex; align-items:center; cursor:grab; }
    .sl-tb svg { width:13px; height:13px; stroke:currentColor; fill:none; stroke-width:1.8; }
    .sl-empty { text-align:center; color:#9ca3af; font-size:14px; padding:60px 10px; border:2px dashed #e5e7eb; border-radius:8px; }
    .sl-drawer-bk { position:fixed; inset:0; background:rgba(17,24,39,.4); z-index:60; display:none; }
    .sl-drawer-bk.on { display:block; }
    .sl-drawer { position:fixed; top:0; right:0; height:100%; width:380px; max-width:92vw; background:#fff; z-index:61; transform:translateX(100%); transition:transform .22s; box-shadow:-4px 0 24px rgba(0,0,0,.12); display:flex; flex-direction:column; }
    .sl-drawer.on { transform:none; }
    .sl-drawer-head { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid var(--sl-line); font-weight:600; color:var(--sl-ink); }
    .sl-drawer-body { padding:16px; overflow-y:auto; flex:1; }
    /* Image field: URL input with Upload / Library buttons underneath */
    .sl-imgfield .sl-img-btns { display:flex; gap:6px; margin-top:6px; }
    .sl-imgfield .sl-img-btns .sl-btn { flex:1; padding:6px 8px; font-size:12px; display:inline-flex; align-items:center; justify-content:center; gap:5px; }
    .sl-imgfield .sl-img-btns svg { width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:1.7; }
    .sl-imgfield .sl-img-prev { margin-top:8px; border:1px solid var(--sl-line); border-radius:6px; padding:6px; display:none; }
    .sl-imgfield .sl-img-prev.on { display:block; }
    .sl-imgfield .sl-img-prev img { max-width:100%; max-height:120px; display:block; margin:0 auto; border-radius:4px; }

    /* ───────── Asset Manager modal ───────── */
    .sl-am-bk { position:fixed; inset:0; background:rgba(17,24,39,.5); z-index:70; display:none; align-items:center; justify-content:center; padding:20px; }
    .sl-am-bk.on { display:flex; }
    .sl-am { background:#fff; border-radius:10px; width:760px; max-width:100%; max-height:88vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,.3); }
    .sl-am-head { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--sl-line); }
    .sl-am-head h3 { margin:0; font-size:15px; font-weight:600; color:var(--sl-ink); }
    .sl-am-x { border:0; background:none; font-size:20px; line-height:1; color:var(--sl-mut); cursor:pointer; }
    .sl-am-x:hover { color:var(--sl-ink); }
    .sl-am-body { padding:18px; overflow-y:auto; flex:1; }
    .sl-am-drop { border:2px dashed var(--sl-line); border-radius:10px; padding:26px; text-align:center; color:var(--sl-mut); cursor:pointer; transition:.12s; }
    .sl-am-drop:hover, .sl-am-drop.drag { border-color:var(--sl-brand); background:#fdf2f8; color:var(--sl-brand); }
    .sl-am-drop .plus { width:34px; height:34px; border-radius:50%; border:1px solid currentColor; display:inline-flex; align-items:center; justify-content:center; font-size:22px; margin-bottom:8px; }
    .sl-am-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(128px,1fr)); gap:12px; margin-top:16px; }
    .sl-am-tile { border:1px solid var(--sl-line); border-radius:8px; overflow:hidden; cursor:pointer; background:#fff; position:relative; transition:.12s; }
    .sl-am-tile:hover { border-color:var(--sl-brand); box-shadow:0 2px 8px rgba(0,0,0,.08); }
    .sl-am-tile.sel { border-color:var(--sl-brand); box-shadow:0 0 0 2px var(--sl-brand); }
    .sl-am-tile .ph { aspect-ratio:1/1; background:#f3f4f6 center/cover no-repeat; }
    .sl-am-tile .cap { font-size:10px; color:var(--sl-mut); padding:5px 6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; border-top:1px solid var(--sl-line); }
    .sl-am-tile .del { position:absolute; top:4px; right:4px; width:22px; height:22px; border-radius:6px; border:0; background:rgba(17,24,39,.6); color:#fff; font-size:13px; cursor:pointer; display:none; align-items:center; justify-content:center; }
    .sl-am-tile:hover .del { display:inline-flex; }
    .sl-am-empty { text-align:center; color:#9ca3af; font-size:13px; padding:30px 10px; }
    .sl-am-more { display:block; margin:16px auto 0; }
    .sl-am-foot { display:flex; align-items:center; justify-content:flex-end; gap:8px; padding:12px 18px; border-top:1px solid var(--sl-line); }
    .sl-am-note { margin-right:auto; font-size:11px; color:var(--sl-mut); }
    @@media (max-width:860px){ .sl-rail{ width:260px; flex-basis:260px; } }
</style>

<form asp-area="Marketing" asp-controller="Campaigns" asp-action="Save" method="post" id="campaign-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LayoutJson" id="LayoutJson" />

    <div id="sl-editor">
        <!-- ───── Top bar ───── -->
        <div class="sl-top">
            <a asp-area="Marketing" asp-controller="Campaigns" asp-action="Index" class="sl-back" title="All campaigns" style="text-decoration:none">← Back</a>
            <input asp-for="Name" required placeholder="Untitled campaign" class="name-in" title="Campaign name (internal)" />
            <div class="sl-spacer"></div>
            <div class="sl-seg" role="group" aria-label="Preview device">
                <button type="button" id="pv-desktop" class="on" title="Desktop">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="4" width="20" height="13" rx="1"/><path d="M8 20h8M12 17v3"/></svg> Desktop
                </button>
                <button type="button" id="pv-mobile" title="Mobile">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg> Mobile
                </button>
            </div>
            <span class="sl-chip" id="size-chip">Email size: 0 KB</span>
            <button type="button" class="sl-ico-btn" id="undo" title="Undo" disabled>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 7 4 12l5 5"/><path d="M4 12h11a5 5 0 0 1 0 10h-1"/></svg>
            </button>
            <button type="button" class="sl-ico-btn" id="redo" title="Redo" disabled>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 7 5 5-5 5"/><path d="M20 12H9a5 5 0 0 0 0 10h1"/></svg>
            </button>
            <button type="button" class="sl-btn" id="open-settings">Recipients &amp; coupon</button>
            <button type="submit" class="sl-btn sl-btn-primary">Save draft</button>
        </div>

        <!-- ───── Workspace ───── -->
        <div class="sl-work">
            <aside class="sl-rail" id="rail"><!-- JS renders palette / config here --></aside>
            <main class="sl-stage">
                <div class="sl-canvas" id="canvas"><div class="sl-canvas-pad" id="canvas-pad"></div></div>
                <p style="text-align:center;color:#9ca3af;font-size:11px;margin:14px 0 0">An unsubscribe footer is added automatically on send.</p>
            </main>
        </div>
    </div>

    <!-- ───── Settings drawer (recipients + coupon) ───── -->
    <div class="sl-drawer-bk" id="drawer-bk"></div>
    <aside class="sl-drawer" id="drawer" aria-label="Recipients and coupon">
        <div class="sl-drawer-head">Recipients &amp; coupon <button type="button" class="sl-back" id="close-settings" style="font-size:18px">✕</button></div>
        <div class="sl-drawer-body space-y-4">
            <div>
                <label asp-for="Subject" class="block text-xs text-neutral-500 mb-1">Email subject *</label>
                <input asp-for="Subject" required class="sl-in" placeholder="What your recipients see in their inbox" />
            </div>

            @if (savedSegs.Any())
            {
                <div>
                    <label asp-for="SegmentId" class="block text-xs text-neutral-500 mb-1">Saved segment</label>
                    <select asp-for="SegmentId" id="seg-select" class="sl-sel">
                        <option value="">— Custom (choose below) —</option>
                        @foreach (var sg in savedSegs) { <option value="@sg.Id">@sg.Name</option> }
                    </select>
                    <p class="text-[10px] text-neutral-400 mt-1">Pick a saved segment, or leave as Custom to define the audience below.</p>
                </div>
            }
            <div id="custom-aud" class="space-y-3">
                <div>
                    <label asp-for="Audience" class="block text-xs text-neutral-500 mb-1">Audience</label>
                    <select asp-for="Audience" id="aud-select" class="sl-sel">
                        @foreach (var a in Enum.GetValues<CampaignAudience>())
                        {
                            <option value="@a">@System.Text.RegularExpressions.Regex.Replace(a.ToString(), "([a-z])([A-Z])", "$1 $2")</option>
                        }
                    </select>
                </div>
                <div data-aud="RecentBuyers,LapsedCustomers">
                    <label asp-for="AudienceDays" class="block text-xs text-neutral-500 mb-1">Within / since (days)</label>
                    <input asp-for="AudienceDays" type="number" min="1" placeholder="e.g. 90" class="sl-in" />
                </div>
                <div data-aud="HighValue">
                    <label asp-for="AudienceMinSpend" class="block text-xs text-neutral-500 mb-1">Min lifetime spend (₦)</label>
                    <input asp-for="AudienceMinSpend" type="number" step="0.01" min="0" placeholder="e.g. 50000" class="sl-in" />
                </div>
                <div data-aud="ByState">
                    <label asp-for="AudienceState" class="block text-xs text-neutral-500 mb-1">State</label>
                    <input asp-for="AudienceState" placeholder="e.g. Lagos" class="sl-in" />
                </div>
            </div>
            <button type="button" id="count-btn" class="sl-btn" style="width:100%">Preview audience size</button>
            <p id="count-out" class="text-sm text-center text-neutral-600 hidden"></p>

            <div class="pt-2 border-t border-neutral-100">
                <partial name="_CouponFields" model='new SterlingLams.Web.Models.ViewModels.CouponFieldsVm(Model.CouponEnabled, Model.CouponType, Model.CouponValue, Model.CouponExpiryDays, Model.CouponMinOrder)' />
            </div>
        </div>
    </aside>
</form>

<!-- ───── Asset Manager (image library + upload) ───── -->
<div class="sl-am-bk" id="am-bk" aria-hidden="true">
    <div class="sl-am" role="dialog" aria-modal="true" aria-label="Asset Manager">
        <div class="sl-am-head">
            <h3>Asset Manager</h3>
            <button type="button" class="sl-am-x" id="am-close" aria-label="Close">&times;</button>
        </div>
        <div class="sl-am-body">
            <label class="sl-am-drop" id="am-drop">
                <span class="plus">+</span>
                <div id="am-drop-label">Click or drag an image here to upload <span style="opacity:.7">(JPG, PNG, WEBP, GIF · max 10&nbsp;MB)</span></div>
                <input type="file" id="am-file" accept="image/png,image/jpeg,image/webp,image/gif" hidden>
            </label>
            <div class="sl-am-grid" id="am-grid"></div>
            <div class="sl-am-empty" id="am-empty" style="display:none">No images yet — upload your first above.</div>
            <button type="button" class="sl-btn sl-am-more" id="am-more" style="display:none">Load more</button>
        </div>
        <div class="sl-am-foot">
            <span class="sl-am-note" id="am-note"></span>
            <button type="button" class="sl-btn" id="am-cancel">Cancel</button>
            <button type="button" class="sl-btn sl-btn-primary" id="am-use" disabled>Use image</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    "use strict";
    // ════════════════════ Retainful-style block editor ════════════════════
    var FONTS = [['arial','Arial'],['helvetica','Helvetica'],['georgia','Georgia'],['times','Times New Roman'],['tahoma','Tahoma'],['verdana','Verdana'],['trebuchet','Trebuchet MS'],['courier','Courier New']];
    var FONT_STACK = { arial:"Arial, Helvetica, sans-serif", helvetica:"Helvetica, Arial, sans-serif", georgia:"Georgia, 'Times New Roman', serif", times:"'Times New Roman', Times, serif", courier:"'Courier New', Courier, monospace", tahoma:"Tahoma, Geneva, sans-serif", verdana:"Verdana, Geneva, sans-serif", trebuchet:"'Trebuchet MS', Helvetica, sans-serif" };
    var LABELS = { heading:'Heading', text:'Text', image:'Image', button:'Button', divider:'Divider', spacer:'Spacer', social:'Social', columns:'Columns', html:'HTML' };

    var state = [], globals = {}, sel = -1, device = 'desktop', railTab = 'config';
    var railView = 'content', paletteTab = 'basic';   // content | globals ; basic | prebuilt
    var hist = [], hp = -1;   // undo/redo

    // ── seed (accepts the legacy bare array or the new {globals, blocks} object) ──
    try {
        var seed = JSON.parse(document.getElementById('seed').textContent || '{}');
        if (seed.layout) {
            try {
                var parsed = JSON.parse(seed.layout);
                if (Array.isArray(parsed)) { state = parsed; }
                else if (parsed && typeof parsed === 'object') { state = parsed.blocks || []; globals = parsed.globals || {}; }
            } catch (e) { state = []; }
        }
        if ((!state || !state.length) && seed.body && seed.body.trim()) state = [{ type:'html', html: seed.body }];
        if (!Array.isArray(state)) state = [];
        if (!globals || typeof globals !== 'object') globals = {};
    } catch (e) { state = []; globals = {}; }

    // Retainful-style starting Global Styles for a brand-new campaign (Arial · 14px · 400 · 1.7 · black on
    // white, 600px wide). Only seeded when nothing is set, so existing drafts keep their own styles.
    var DEFAULT_GLOBALS = { width:600, pageBg:'#ffffff', font:'arial', textSize:14, lineHeight:1.7, textColor:'#000000' };
    if (@(Model.Id == 0 ? "true" : "false") && !Object.keys(globals).length) globals = Object.assign({}, DEFAULT_GLOBALS);

    // Blocks created now deliberately omit colour/font/button styling so they INHERIT the Global Styles
    // (the renderer falls back global → built-in default). Structural sizes stay.
    function def(type) {
        switch (type) {
            case 'heading': return { type:'heading', text:'Your headline', align:'center', fontSize:24, weight:600 };
            case 'text': return { type:'text', text:'Write your message here…', align:'left' };
            case 'image': return { type:'image', src:'', href:'', alt:'', align:'center', width:0, radius:0 };
            case 'button': return { type:'button', text:'Shop now', href:'', align:'center', full:false };
            case 'divider': return { type:'divider', color:'#e5e7eb', thickness:1 };
            case 'spacer': return { type:'spacer', size:24 };
            case 'social': return { type:'social', instagram:'', facebook:'', tiktok:'' };
            case 'columns': return { type:'columns', cols:[ col(), col() ] };
            case 'html': return { type:'html', html:'' };
            default: return { type:type };
        }
    }
    function col() { return { src:'', title:'Product', caption:'', price:'', href:'', btnText:'Shop Now' }; }

    // ════════════════════ Preview renderer (mirrors CampaignLayoutRenderer.cs) ════════════════════
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); }
    function align(a) { return a === 'left' ? 'left' : a === 'right' ? 'right' : 'center'; }
    function hex(c, fb) { return (c && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(String(c).trim())) ? String(c).trim() : fb; }
    function fontStack(f) { return FONT_STACK[f] || FONT_STACK.arial; }
    function clamp(v, def, mn, mx) { v = parseInt(v, 10); if (isNaN(v)) v = def; return Math.min(mx, Math.max(mn, v)); }
    function safeUrl(u) { if (!u) return '#'; u = String(u).trim(); return (/^https?:\/\//i.test(u) || /^mailto:/i.test(u)) ? u : '#'; }
    function pad(b) {
        if (b.padT == null && b.padR == null && b.padB == null && b.padL == null) return '';
        return 'padding:' + clamp(b.padT,0,0,120) + 'px ' + clamp(b.padR,0,0,120) + 'px ' + clamp(b.padB,0,0,120) + 'px ' + clamp(b.padL,0,0,120) + 'px;';
    }
    function bgS(b) { return hex(b.bg,'') ? 'background:' + hex(b.bg,'') + ';' : ''; }
    function gnum(v) { return (v == null || v === '' || isNaN(+v)) ? null : +v; }
    function textStyle(b, ds, dw, dc) {
        var s = 'font-family:' + fontStack(b.font || globals.font) + ';font-size:' + clamp(b.fontSize,ds,9,72) + 'px;';
        var glh = (b.lineHeight || globals.lineHeight);
        var lh = (glh && glh >= .8 && glh <= 3) ? glh : (ds >= 20 ? 1.3 : 1.6);
        s += 'line-height:' + lh + ';font-weight:' + clamp(b.weight,dw,300,800) + ';';
        if (b.italic) s += 'font-style:italic;';
        if (b.underline) s += 'text-decoration:underline;';
        if (b.letter) s += 'letter-spacing:' + Math.min(12,Math.max(-2,b.letter)) + 'px;';
        s += 'color:' + hex(b.color, hex(globals.textColor, dc)) + ';';
        return s;
    }
    function renderBlock(b) {
        switch ((b.type || '').toLowerCase()) {
            case 'heading':
                return '<div style="' + textStyle(b,24,600,'#111111') + 'text-align:' + align(b.align) + ';' + pad(b) + bgS(b) + 'margin:0 0 14px">' + esc(b.text) + '</div>';
            case 'text':
                var tds = gnum(globals.textSize); if (!(tds >= 9 && tds <= 72)) tds = 15;
                return '<div style="' + textStyle(b,tds,400,'#333333') + 'text-align:' + align(b.align) + ';' + pad(b) + bgS(b) + 'margin:0 0 14px">' + esc(b.text).replace(/\r\n/g,'\n').replace(/\n/g,'<br />') + '</div>';
            case 'image':
                if (!b.src) return '<div style="text-align:center;color:#bbb;font-size:13px;padding:22px;border:1px dashed #ddd;margin:0 0 16px">🖼 Image — add a URL in the panel</div>';
                var w = (b.width && b.width >= 40 && b.width <= 600) ? 'width:' + b.width + 'px;max-width:100%;' : 'max-width:100%;';
                var rad = (b.radius > 0) ? 'border-radius:' + Math.min(60,b.radius) + 'px;' : '';
                var img = '<img src="' + esc(safeUrl(b.src)) + '" alt="' + esc(b.alt) + '" style="' + w + 'height:auto;display:inline-block;border:0;' + rad + '" />';
                if (b.href) img = '<a href="' + esc(safeUrl(b.href)) + '">' + img + '</a>';
                return '<div style="text-align:' + align(b.align) + ';' + pad(b) + bgS(b) + 'margin:0 0 16px">' + img + '</div>';
            case 'button':
                var bg = hex(b.bg, hex(globals.btnBg,'#c90278')), fg = hex(b.color, hex(globals.btnColor,'#ffffff'));
                var r = clamp(b.radius, gnum(globals.btnRadius) != null ? globals.btnRadius : 6, 0, 40);
                var fs = clamp(b.fontSize, gnum(globals.btnSize) != null ? globals.btnSize : 15, 10, 28);
                var wt = clamp(b.weight, gnum(globals.btnWeight) != null ? globals.btnWeight : 600, 400, 800), full = !!b.full;
                return '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:4px auto 18px' + (full?';width:100%':'') + '" align="' + align(b.align) + '"><tr><td style="background:' + bg + ';border-radius:' + r + 'px' + (full?';width:100%':'') + '"><a href="' + esc(safeUrl(b.href)) + '" style="' + (full?'display:block;text-align:center;':'display:inline-block;') + 'padding:12px 26px;font-family:' + fontStack(b.font || globals.font) + ';font-size:' + fs + 'px;font-weight:' + wt + ';color:' + fg + ';text-decoration:none;border-radius:' + r + 'px">' + esc(b.text || 'Shop now') + '</a></td></tr></table>';
            case 'divider':
                return '<hr style="border:none;border-top:' + clamp(b.thickness,1,1,10) + 'px solid ' + hex(b.color,'#e5e7eb') + ';margin:22px 0" />';
            case 'spacer':
                var h = Math.min(160, Math.max(4, parseInt(b.size, 10) || 24));
                return '<div style="height:' + h + 'px;line-height:' + h + 'px;font-size:0">&nbsp;</div>';
            case 'social':
                var col0 = hex(b.color, hex(globals.linkColor,'#c90278')), links = [];
                [['instagram','Instagram'],['facebook','Facebook'],['tiktok','TikTok']].forEach(function (p) {
                    if (b[p[0]]) links.push('<a href="' + esc(safeUrl(b[p[0]])) + '" style="color:' + col0 + ';text-decoration:none;font-weight:600;margin:0 8px">' + p[1] + '</a>');
                });
                return links.length ? '<div style="text-align:center;margin:8px 0 18px;font-size:14px">' + links.join('') + '</div>' : '<div style="text-align:center;color:#bbb;font-size:13px;padding:10px;border:1px dashed #ddd;margin:0 0 16px">Social — add profile links</div>';
            case 'columns':
                var cols = (b.cols || []).slice(0,3); if (!cols.length) return '';
                var cbg = hex(b.color, hex(globals.btnBg,'#c90278')), cw = Math.floor(100/cols.length), cells = '';
                cols.forEach(function (c) {
                    var inner = '';
                    if (c.src) inner += '<img src="' + esc(safeUrl(c.src)) + '" alt="' + esc(c.title) + '" style="width:100%;max-width:100%;height:auto;display:block;border:0;border-radius:4px" />';
                    else inner += '<div style="background:#f3f4f6;color:#bbb;font-size:12px;padding:28px 6px;border-radius:4px">Image</div>';
                    if (c.title) inner += '<div style="font-family:Arial,sans-serif;font-size:14px;font-weight:600;color:#111;margin:10px 0 2px">' + esc(c.title) + '</div>';
                    if (c.caption) inner += '<div style="font-family:Arial,sans-serif;font-size:13px;color:#555;margin:0 0 2px">' + esc(c.caption) + '</div>';
                    if (c.price) inner += '<div style="font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#111;margin:2px 0 8px">' + esc(c.price) + '</div>';
                    if (c.btnText) inner += '<a href="' + esc(safeUrl(c.href)) + '" style="display:inline-block;padding:8px 18px;background:' + cbg + ';color:#fff;font-family:Arial,sans-serif;font-size:13px;font-weight:600;text-decoration:none;border-radius:6px;margin-top:4px">' + esc(c.btnText) + '</a>';
                    cells += '<td valign="top" width="' + cw + '%" style="padding:6px;text-align:center;vertical-align:top">' + inner + '</td>';
                });
                return '<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 16px;' + pad(b) + bgS(b) + '"><tr>' + cells + '</tr></table>';
            case 'html':
                return b.html || '<div style="text-align:center;color:#bbb;font-size:13px;padding:14px;border:1px dashed #ddd;margin:0 0 16px">Custom HTML</div>';
            default: return '';
        }
    }

    // Global Styles wrapper (page background / default font+colour / content width), mirroring the server.
    function wrapStyle() {
        var s = '';
        if (hex(globals.pageBg,'')) s += 'background:' + hex(globals.pageBg,'') + ';padding:4px 2px;';
        if (globals.font) s += 'font-family:' + fontStack(globals.font) + ';';
        if (hex(globals.textColor,'')) s += 'color:' + hex(globals.textColor,'') + ';';
        var w = gnum(globals.width); if (w >= 320 && w <= 800) s += 'max-width:' + w + 'px;margin:0 auto;';
        return s;
    }
    // Body HTML used to measure email size (as the server would store it).
    function bodyHtml() {
        var inner = state.map(renderBlock).join('');
        var ws = wrapStyle();
        return ws ? '<div style="' + ws + '">' + inner + '</div>' : inner;
    }

    // ════════════════════ Canvas ════════════════════
    var canvas = document.getElementById('canvas'), pad0 = document.getElementById('canvas-pad');
    var TB = '<div class="sl-tb">' +
        '<span class="lbl" data-drag="1" title="Drag to reorder">⠿ </span>' +
        '<button type="button" data-act="up" title="Move up"><svg viewBox="0 0 24 24"><path d="m6 15 6-6 6 6"/></svg></button>' +
        '<button type="button" data-act="down" title="Move down"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg></button>' +
        '<button type="button" data-act="dup" title="Duplicate"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="11" height="11" rx="1"/><path d="M5 15V5a1 1 0 0 1 1-1h10"/></svg></button>' +
        '<button type="button" data-act="del" title="Delete"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V5h6v2M7 7l1 13h8l1-13"/></svg></button>' +
        '</div>';

    function paintCanvas() {
        // Reflect the page background / default font on the canvas content area (live Global Styles).
        pad0.style.cssText = wrapStyle();
        if (!state.length) { pad0.innerHTML = '<div class="sl-empty">Drag a block from the left to start building your email.</div>'; return; }
        pad0.innerHTML = state.map(function (b, i) {
            return '<div class="sl-wrap' + (i === sel ? ' sel' : '') + '" data-i="' + i + '" draggable="true">' + TB + renderBlock(b) + '</div>';
        }).join('');
    }

    // ════════════════════ Left rail ════════════════════
    var rail = document.getElementById('rail');
    var PAL_ICONS = {
        heading:'<path d="M6 4v16M18 4v16M6 12h12"/>', text:'<path d="M4 6h16M4 12h16M4 18h10"/>',
        image:'<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 16-5-5L5 20"/>',
        button:'<rect x="3" y="8" width="18" height="8" rx="4"/>', divider:'<path d="M3 12h18"/>',
        spacer:'<path d="M12 4v16M8 7l4-3 4 3M8 17l4 3 4-3"/>', social:'<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4"/>',
        columns:'<rect x="3" y="4" width="7" height="16" rx="1"/><rect x="14" y="4" width="7" height="16" rx="1"/>',
        html:'<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13 6l-2 12"/>'
    };
    // Pre-built block groups (click to drop a ready-made section in).
    function TEMPLATES() { return [
        { id:'hero', name:'Hero', make: function(){ return [
            Object.assign(def('heading'), { text:'Big, beautiful headline', align:'center', fontSize:28, weight:700 }),
            Object.assign(def('text'), { text:'One punchy line that sets up the offer and makes them want to read on.', align:'center' }),
            Object.assign(def('button'), { text:'Shop the collection', align:'center' }) ]; } },
        { id:'feature', name:'Product highlight', make: function(){ return [
            Object.assign(def('image'), { src:'', alt:'Featured product', align:'center' }),
            Object.assign(def('heading'), { text:'Featured product', align:'center', fontSize:20, weight:700 }),
            Object.assign(def('text'), { text:'A short description highlighting benefits and key details. Keep it clear and tempting.', align:'center' }),
            Object.assign(def('button'), { text:'Shop now', align:'center' }) ]; } },
        { id:'grid2', name:'Product grid (2)', make: function(){ var b=def('columns'); b.cols=[ gcol('Product one'), gcol('Product two') ]; return [b]; } },
        { id:'grid3', name:'Product grid (3)', make: function(){ var b=def('columns'); b.cols=[ gcol('One'), gcol('Two'), gcol('Three') ]; return [b]; } },
        { id:'promo', name:'Promo banner', make: function(){ return [
            Object.assign(def('heading'), { text:'Limited-time offer', align:'center', bg:'#fdf2f8', padT:20, padR:16, padB:6, padL:16 }),
            Object.assign(def('text'), { text:'Use code GLAM10 for 10% off this week only.', align:'center', bg:'#fdf2f8', padT:0, padR:16, padB:18, padL:16 }),
            Object.assign(def('button'), { text:'Grab the deal', align:'center' }) ]; } },
        { id:'footer', name:'Footer', make: function(){ return [
            def('divider'),
            Object.assign(def('social'), { instagram:'https://instagram.com/sterlinglams', facebook:'', tiktok:'' }),
            Object.assign(def('text'), { text:'Sterlin Glams — Where Stones Rock. You received this because you shopped with or subscribed to us.', align:'center', fontSize:12 }) ]; } }
    ]; }
    function gcol(title){ return { src:'', title:title, caption:'', price:'₦0', href:'', btnText:'Shop Now' }; }

    function basicBody() {
        var items = ['heading','text','image','button','columns','divider','spacer','social','html'].map(function (t) {
            return '<div class="sl-pal-item" draggable="true" data-add="' + t + '"><svg viewBox="0 0 24 24">' + PAL_ICONS[t] + '</svg>' + LABELS[t] + '</div>';
        }).join('');
        return '<div class="sl-pal-sec"><h4>Drag or click to add</h4><div class="sl-pal-grid">' + items + '</div></div>';
    }
    function prebuiltBody() {
        var cards = TEMPLATES().map(function (t) {
            return '<button type="button" class="sl-tpl" data-tpl="' + t.id + '"><span class="sl-tpl-name">' + t.name + '</span><span class="sl-tpl-add">+ Add</span></button>';
        }).join('');
        return '<div class="sl-pal-sec"><h4>Ready-made sections</h4><div class="sl-tpl-list">' + cards + '</div>' +
            '<p style="font-size:11px;color:var(--sl-mut);margin:8px 0 0">Adds a group of blocks you can then edit. They pick up your Global Styles automatically.</p></div>';
