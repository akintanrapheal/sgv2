    function topTabs() {
        return '<div class="sl-tabs"><button type="button" data-view="content" class="' + (railView==='content'?'on':'') + '">Content</button>' +
               '<button type="button" data-view="globals" class="' + (railView==='globals'?'on':'') + '">Global Styles</button></div>';
    }
    function contentRail() {
        if (railView === 'globals') { rail.innerHTML = topTabs() + globalsBody(); return; }
        var sub = '<div class="sl-tabs" style="border-bottom:1px solid var(--sl-line)">' +
            '<button type="button" data-ptab="basic" class="' + (paletteTab==='basic'?'on':'') + '">Basic</button>' +
            '<button type="button" data-ptab="prebuilt" class="' + (paletteTab==='prebuilt'?'on':'') + '">Pre-built</button></div>';
        rail.innerHTML = topTabs() + sub + (paletteTab==='prebuilt' ? prebuiltBody() : basicBody());
    }

    // ── Global Styles form ──
    function g_color(label, key) { var val = globals[key] || ''; var v = hex(val,'#000000'); return '<div class="sl-field"><label>' + label + '</label><div class="sl-color"><input type="color" data-g="' + key + '" value="' + v + '"><input class="sl-in" data-g="' + key + '" value="' + esc(val) + '" placeholder="default"></div></div>'; }
    function g_num(label, key, mn, mx) { return '<div class="sl-field"><label>' + label + '</label><input type="number" class="sl-in" data-g="' + key + '" value="' + (globals[key]==null?'':globals[key]) + '" min="' + mn + '" max="' + mx + '" placeholder="default"></div>'; }
    function g_font(key) { var val = globals[key] || ''; return '<div class="sl-field"><label>Default font</label><select class="sl-sel" data-g="' + key + '"><option value="">Theme default (Arial)</option>' + FONTS.map(function (f) { return '<option value="' + f[0] + '"' + (val===f[0]?' selected':'') + '>' + f[1] + '</option>'; }).join('') + '</select></div>'; }
    function globalsBody() {
        return '<div class="sl-cfg">' +
            '<div class="sl-cfg-sec"><h5>Page</h5>' + g_color('Email background','pageBg') + g_num('Content width (px)','width',320,800) + '</div>' +
            '<div class="sl-cfg-sec"><h5>Text</h5>' + g_font('font') + '<div class="sl-row2">' + g_num('Default size (px)','textSize',9,40) + g_num('Line height','lineHeight',1,3) + '</div>' + g_color('Default text colour','textColor') + '</div>' +
            '<div class="sl-cfg-sec"><h5>Buttons</h5>' + g_color('Background','btnBg') + g_color('Text colour','btnColor') + '<div class="sl-row2">' + g_num('Size (px)','btnSize',10,28) + g_num('Radius (px)','btnRadius',0,40) + '</div>' + g_num('Weight','btnWeight',400,800) + '</div>' +
            '<div class="sl-cfg-sec"><h5>Links</h5>' + g_color('Link &amp; social colour','linkColor') + '</div>' +
            '<div class="sl-cfg-sec"><button type="button" id="reset-globals" class="sl-btn" style="width:100%">Reset to defaults</button></div>' +
            '</div>';
    }

    // ── config field helpers ──
    function f_text(label, key, val, ph) { return '<div class="sl-field"><label>' + label + '</label><input class="sl-in" data-k="' + key + '" value="' + esc(val) + '" placeholder="' + (ph||'') + '"></div>'; }
    function f_area(label, key, val, ph) { return '<div class="sl-field"><label>' + label + '</label><textarea class="sl-ta" rows="4" data-k="' + key + '" placeholder="' + (ph||'') + '">' + esc(val) + '</textarea></div>'; }
    function f_num(label, key, val, mn, mx) { return '<div class="sl-field"><label>' + label + '</label><input type="number" class="sl-in" data-k="' + key + '" value="' + (val==null?'':val) + '" min="' + mn + '" max="' + mx + '"></div>'; }
    function f_color(label, key, val) { var v = hex(val,'#000000'); return '<div class="sl-field"><label>' + label + '</label><div class="sl-color"><input type="color" data-k="' + key + '" value="' + v + '"><input class="sl-in" data-k="' + key + '" value="' + esc(val||'') + '" placeholder="#rrggbb"></div></div>'; }
    function f_font(key, val) { return '<div class="sl-field"><label>Font</label><select class="sl-sel" data-k="' + key + '">' + FONTS.map(function (f) { return '<option value="' + f[0] + '"' + (val===f[0]?' selected':'') + '>' + f[1] + '</option>'; }).join('') + '</select></div>'; }
    function f_align(val) {
        function b(v, path) { return '<button type="button" data-align="' + v + '" class="' + (align(val)===v?'on':'') + '"><svg viewBox="0 0 24 24">' + path + '</svg></button>'; }
        return '<div class="sl-field"><label>Alignment</label><div class="sl-alignseg">' +
            b('left','<path d="M4 6h16M4 12h10M4 18h13"/>') + b('center','<path d="M4 6h16M7 12h10M5 18h14"/>') + b('right','<path d="M4 6h16M10 12h10M7 18h13"/>') + '</div></div>';
    }
