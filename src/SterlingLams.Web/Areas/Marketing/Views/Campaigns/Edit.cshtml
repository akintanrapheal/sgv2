            '<div class="sl-img-btns">' +
                '<button type="button" class="sl-btn" data-img-pick="' + key + '"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 16-5-5L5 20"/></svg>' + (val ? 'Replace image' : 'Choose / upload') + '</button>' +
            '</div>' +
            '<div class="sl-img-prev' + (val ? ' on' : '') + '" data-img-prev="' + key + '">' + (val ? '<img src="' + esc(val) + '" alt="">' : '') + '</div>' +
        '</div>';
