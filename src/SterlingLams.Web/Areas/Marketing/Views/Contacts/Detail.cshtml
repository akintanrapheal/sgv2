@using SterlingLams.Web.Models.Domain
@{
    var u = ViewBag.User as ApplicationUser;
    ViewData["Title"] = u?.FullName;
    int conversions = ViewBag.Conversions ?? 0;
    decimal revenue = ViewBag.Revenue ?? 0m;
    bool unsub = ViewBag.Unsubscribed ?? false;
    var addr = ViewBag.Address as Address;
    var orders = ViewBag.Orders as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var emails = ViewBag.CampaignEmails as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var timeline = ViewBag.Timeline as List<SterlingLams.Web.Areas.Marketing.Controllers.ContactsController.TimelineEvent>
                   ?? new();

    string IconDot(string icon) => icon switch
    {
        "paid" or "recovered" => "bg-emerald-500",
        "order" => "bg-neutral-800",
        "cart" => "bg-amber-500",
        "open" => "bg-blue-500",
        "click" => "bg-violet-500",
        "email" => "bg-neutral-400",
        "subscribe" => "bg-blue-500",
        _ => "bg-neutral-300"
    };
}

<div class="mb-6">
    <a asp-area="Marketing" asp-controller="Contacts" asp-action="Index" class="text-xs text-neutral-400 hover:text-neutral-700">← All contacts</a>
    <div class="flex items-start justify-between gap-4 flex-wrap mt-2">
        <div>
            <h1 class="text-2xl font-light text-neutral-900">@(string.IsNullOrWhiteSpace(u?.FullName) ? (u?.Email ?? "Contact") : u!.FullName)</h1>
            <div class="flex items-center gap-3 mt-1 text-sm text-neutral-500">
                <span>@u?.Email</span>
                @if (unsub)
                {
                    <span class="text-[10px] bg-neutral-100 text-neutral-500 px-2 py-0.5 rounded-full">Unsubscribed</span>
                }
                else
                {
                    <span class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full">Subscribed</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(u?.PhoneNumber))
            {
                <div class="text-sm text-neutral-500 mt-0.5">@u!.PhoneNumber</div>
            }
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left: profile -->
    <div class="space-y-4">
        <div class="bg-white border border-neutral-200 rounded-sm p-5">
            <div class="text-xs uppercase tracking-wide text-neutral-400 mb-3">Conversions</div>
            <div class="flex justify-between text-sm py-1"><span class="text-neutral-500">Total conversions</span><span class="text-neutral-900 font-medium">@conversions.ToString("N0")</span></div>
            <div class="flex justify-between text-sm py-1"><span class="text-neutral-500">Total revenue</span><span class="text-emerald-600 font-medium">₦@revenue.ToString("N0")</span></div>
        </div>

        <div class="bg-white border border-neutral-200 rounded-sm p-5">
            <div class="text-xs uppercase tracking-wide text-neutral-400 mb-3">Personal information</div>
            <div class="space-y-1.5 text-sm">
                <div class="flex justify-between gap-3"><span class="text-neutral-400">First name</span><span class="text-neutral-700 text-right">@(string.IsNullOrWhiteSpace(u?.FirstName) ? "—" : u!.FirstName)</span></div>
                <div class="flex justify-between gap-3"><span class="text-neutral-400">Last name</span><span class="text-neutral-700 text-right">@(string.IsNullOrWhiteSpace(u?.LastName) ? "—" : u!.LastName)</span></div>
                <div class="flex justify-between gap-3"><span class="text-neutral-400">Phone</span><span class="text-neutral-700 text-right">@(string.IsNullOrWhiteSpace(u?.PhoneNumber) ? "—" : u!.PhoneNumber)</span></div>
                <div class="flex justify-between gap-3"><span class="text-neutral-400">Source</span><span class="text-neutral-700 text-right">@(u?.IsGuest == true ? "Guest checkout" : "Website account")</span></div>
                <div class="flex justify-between gap-3"><span class="text-neutral-400">Created</span><span class="text-neutral-700 text-right">@(u?.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</span></div>
            </div>
        </div>

        <div class="bg-white border border-neutral-200 rounded-sm p-5">
            <div class="text-xs uppercase tracking-wide text-neutral-400 mb-3">Address</div>
            @if (addr != null)
            {
                <div class="text-sm text-neutral-700 leading-relaxed">
                    @addr.Line1@(string.IsNullOrWhiteSpace(addr.Line2) ? "" : ", " + addr.Line2)<br />
                    @addr.City@(string.IsNullOrWhiteSpace(addr.State) ? "" : ", " + addr.State)@(string.IsNullOrWhiteSpace(addr.PostalCode) ? "" : " " + addr.PostalCode)<br />
                    @addr.Country
                </div>
            }
            else
            {
                <div class="text-sm text-neutral-400">No address on record.</div>
            }
        </div>
    </div>

    <!-- Right: activity -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Email engagement -->
        <div class="bg-white border border-neutral-200 rounded-sm overflow-x-auto">
            <div class="px-5 py-3 border-b border-neutral-100">
                <h2 class="text-sm font-medium text-neutral-800">Email engagement</h2>
            </div>
            @if (!emails.Any())
            {
                <p class="px-5 py-8 text-center text-sm text-neutral-400">No marketing emails sent to this contact yet.</p>
            }
            else
            {
                <table class="w-full text-sm min-w-[480px]">
                    <thead class="bg-neutral-50 text-neutral-500 text-xs">
                        <tr>
                            <th class="text-left font-semibold px-5 py-2.5">Subject</th>
                            <th class="text-left font-semibold px-4 py-2.5">Sent</th>
                            <th class="text-right font-semibold px-5 py-2.5">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-neutral-100">
                        @foreach (var e in emails)
                        {
                            <tr>
                                <td class="px-5 py-2.5 text-neutral-700">@e.Subject</td>
                                <td class="px-4 py-2.5 text-neutral-400 text-xs">@(((DateTime)e.SentAt).ToLocalTime().ToString("dd MMM, HH:mm"))</td>
                                <td class="px-5 py-2.5 text-right">
                                    @if (e.ClickedAt != null)
                                    {
                                        <span class="text-[10px] bg-violet-50 text-violet-700 px-2 py-0.5 rounded-full">Clicked</span>
                                    }
                                    else if (e.OpenedAt != null)
                                    {
                                        <span class="text-[10px] bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">Opened</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full">Delivered</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Activity timeline -->
        <div class="bg-white border border-neutral-200 rounded-sm p-5">
            <h2 class="text-sm font-medium text-neutral-800 mb-4">Activity</h2>
            @if (!timeline.Any())
            {
                <p class="text-sm text-neutral-400">No activity recorded.</p>
            }
            else
            {
                <ol class="relative border-l border-neutral-200 ml-2">
                    @foreach (var ev in timeline)
                    {
                        <li class="ml-5 pb-5 last:pb-0">
                            <span class="absolute -left-[5px] mt-1.5 w-2.5 h-2.5 rounded-full @IconDot(ev.Icon)"></span>
                            <div class="flex items-baseline justify-between gap-3">
                                <span class="text-sm text-neutral-800">@ev.Title</span>
                                <span class="text-[11px] text-neutral-400 whitespace-nowrap">@ev.At.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ev.Detail))
                            {
                                <div class="text-xs text-neutral-500 mt-0.5">@ev.Detail</div>
                            }
                        </li>
                    }
                </ol>
            }
        </div>
    </div>
</div>
