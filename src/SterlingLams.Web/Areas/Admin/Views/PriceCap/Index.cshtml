@model SterlingLams.Web.Areas.Admin.Controllers.PriceCapController.CapVm
@{
    ViewData["Title"] = "Cap discounts at 15%";
    string Naira(decimal v) => "₦" + v.ToString("N0");
}

<div class="max-w-4xl">
    <h1 class="text-lg font-medium text-neutral-800 mb-1">Cap discounts at 15%</h1>
    <p class="text-xs text-neutral-400 mb-6">Owner-only. Any item discounted <strong>more than 15%</strong> (website sale price or in-store price, product or variant) is reduced to exactly <strong>15% off</strong>. Items already at 15% off or less — and items with no discount — are left untouched.</p>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 text-sm text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-lg px-4 py-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 text-sm text-red-700 bg-red-50 border border-red-100 rounded-lg px-4 py-3">@TempData["Error"]</div>
    }

    <div class="rounded-lg border border-blue-100 bg-blue-50/60 px-4 py-3 text-[13px] text-blue-800 mb-6">
        💡 For the Ibadan opening: cap the base discounts here first, then the cashier applies the single <strong>15% TOTAL discount</strong> at the till. A capped item (15% off) + the till's 15% lands at about <strong>30%</strong> — instead of stacking on top of a deep website discount.
    </div>

    @if (Model.LastAppliedAt != null)
    {
        <div class="rounded-xl border-2 border-amber-300 bg-amber-50/50 p-5 mb-8">
            <h2 class="text-sm font-semibold text-amber-900 mb-1">Restore original discounts</h2>
            <p class="text-[13px] text-amber-800/90 mb-4">
                You last capped <strong>@Model.LastBatchCount price(s)</strong> on
                <strong>@Model.LastAppliedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong>.
                Reverting restores every one of those prices to what it was before.
            </p>
            <form asp-action="Revert" method="post" onsubmit="return confirm('Restore all capped prices to their original (deeper) discounts?');">
                @Html.AntiForgeryToken()
                <div class="flex flex-wrap items-end gap-4">
                    <div class="flex-1 min-w-[220px]">
                        <label class="block text-xs font-medium text-neutral-700 mb-1">Type <span class="font-mono font-semibold">REVERT</span> to confirm</label>
                        <input type="text" name="confirm" autocomplete="off" placeholder="REVERT"
                               class="w-full border border-neutral-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-amber-400" />
                    </div>
                    <button type="submit" class="px-6 py-2.5 bg-amber-600 text-white text-sm font-medium rounded-lg hover:bg-amber-700 transition-colors">
                        Restore original discounts
                    </button>
                </div>
            </form>
        </div>
    }

    @if (Model.FieldsAffected == 0)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-6 text-sm text-emerald-800">
            ✅ Nothing to cap — every item is already discounted 15% or less.
        </div>
    }
    else
    {
        <div class="rounded-xl border border-neutral-200 bg-white p-5 mb-5">
            <p class="text-sm text-neutral-700 mb-1">
                <strong>@Model.FieldsAffected</strong> price(s) across <strong>@Model.ProductsAffected</strong> product(s) are discounted more than 15% and will be reduced to 15% off.
            </p>
            <p class="text-xs text-neutral-400">Review below, then type <span class="font-mono font-semibold">CAP</span> and apply. Nothing changes until you do.</p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-neutral-200 bg-white mb-6">
            <table class="min-w-full text-[13px]">
                <thead class="bg-neutral-50 text-neutral-500 text-[11px] uppercase tracking-wide">
                    <tr>
                        <th class="text-left font-medium px-4 py-2.5">Product</th>
                        <th class="text-left font-medium px-4 py-2.5">Type</th>
                        <th class="text-right font-medium px-4 py-2.5">Regular</th>
                        <th class="text-right font-medium px-4 py-2.5">Now</th>
                        <th class="text-right font-medium px-4 py-2.5">→ New (15% off)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-neutral-100">
                    @foreach (var c in Model.Changes)
                    {
                        <tr>
                            <td class="px-4 py-2.5 text-neutral-800">
                                @c.ProductName
                                @if (c.VariantName != null)
                                {
                                    <span class="text-neutral-400">· @c.VariantName</span>
                                }
                            </td>
                            <td class="px-4 py-2.5 text-neutral-500">@c.FieldLabel</td>
                            <td class="px-4 py-2.5 text-right text-neutral-500">@Naira(c.Regular)</td>
                            <td class="px-4 py-2.5 text-right">
                                <span class="text-neutral-800">@Naira(c.OldValue)</span>
                                <span class="text-red-500 text-[11px]">(@c.OldPct.ToString("0.#")% off)</span>
                            </td>
                            <td class="px-4 py-2.5 text-right">
                                <span class="text-emerald-700 font-medium">@Naira(c.NewValue)</span>
                                <span class="text-emerald-600 text-[11px]">(@c.NewPct.ToString("0.#")% off)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="rounded-xl border-2 border-brand-200 bg-brand-50/40 p-6">
            <form asp-action="Apply" method="post" onsubmit="return confirm('Reduce all discounts over 15% down to 15% off? Originals are saved so you can revert.');">
                @Html.AntiForgeryToken()
                <div class="flex flex-wrap items-end gap-4">
                    <div class="flex-1 min-w-[220px]">
                        <label class="block text-xs font-medium text-neutral-700 mb-1">Type <span class="font-mono font-semibold">CAP</span> to confirm</label>
                        <input type="text" name="confirm" autocomplete="off" placeholder="CAP"
                               class="w-full border border-neutral-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brand-500" />
                    </div>
                    <button type="submit" class="px-6 py-2.5 bg-brand-600 text-white text-sm font-medium rounded-lg hover:bg-brand-700 transition-colors">
                        Cap @Model.FieldsAffected discount(s) at 15%
                    </button>
                </div>
            </form>
        </div>
    }
</div>
