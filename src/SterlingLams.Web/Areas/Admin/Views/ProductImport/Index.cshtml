@{
    ViewData["Title"] = "Import Products";
}

@Html.AntiForgeryToken()

<div class="max-w-3xl">
    <h1 class="text-xl font-semibold text-neutral-900">Import Products</h1>
    <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
        Bring products over from the old WooCommerce site. Upload the migration
        <strong>products CSV</strong> (columns: SKU, Title, Categories, Regular/Sale/Price, Featured Image,
        Gallery Images…). Each row becomes a simple product — name, SKU, price, category (created if new)
        and images re-hosted on Cloudinary. Any product whose <strong>SKU already exists is skipped</strong>,
        so it's safe to re-run. Stock is <strong>not</strong> set — imported items start at 0 and you enter
        opening stock per branch. <strong>Preview first</strong> — nothing is written until you click Import.
    </p>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <label class="block text-xs text-neutral-500 mb-1">Products CSV</label>
        <input id="pi-file" type="file" accept=".csv,text/csv"
               class="block w-full text-sm text-neutral-700 file:mr-3 file:py-2 file:px-4 file:rounded-sm file:border-0 file:bg-neutral-900 file:text-white file:text-xs file:cursor-pointer border border-neutral-200 rounded-sm" />
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-preview" class="px-5 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500">Preview</button>
            <button type="button" id="pi-apply" class="px-6 py-2 bg-neutral-900 text-white text-sm font-medium rounded-md hover:bg-black disabled:opacity-40 disabled:cursor-not-allowed" disabled>Import</button>
            <span id="pi-status" class="text-sm text-neutral-500"></span>
        </div>
        <p class="text-[12px] text-neutral-400 mt-3">Importing hundreds of products (with image uploads) runs in
            small batches automatically — keep this tab open until it says <em>Done</em>.</p>
    </div>

    <div id="pi-results" class="hidden mt-6"></div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Re-host images to Cloudinary</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            If products were imported before Cloudinary was configured, their images point at the old
            website. Move them onto Cloudinary now (before the domain switches to this store) so they never
            break. Configure your keys in <a asp-controller="Integrations" asp-action="Index" class="text-brand-600 hover:underline">Admin → Integrations</a> first. Runs in batches — keep the tab open.
        </p>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-rehost" class="px-5 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500">Re-host external images</button>
            <span id="pi-rehost-status" class="text-sm text-neutral-500"></span>
        </div>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Copy images into ImageKit (Phase 2)</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            Copies every product / variant / category image from Cloudinary into <b>ImageKit's own storage</b>,
            at the same path — so your site no longer depends on Cloudinary and you can close that account.
            Safe to run anytime and to re-run (it overwrites in place). Requires ImageKit configured in
            <a asp-controller="Integrations" asp-action="Index" class="text-brand-600 hover:underline">Admin → Integrations</a>.
            Runs in batches — <b>keep this tab open</b> until it says done.
        </p>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-ikmigrate" class="px-5 py-2 bg-neutral-900 text-white text-sm rounded-md hover:bg-neutral-700">Copy images into ImageKit</button>
            <span id="pi-ikmigrate-status" class="text-sm text-neutral-500"></span>
        </div>
        <div id="pi-ikmigrate-bar-wrap" class="hidden mt-3 h-2 w-full max-w-md bg-neutral-100 rounded-full overflow-hidden">
            <div id="pi-ikmigrate-bar" class="h-full bg-emerald-500 transition-all" style="width:0%"></div>
        </div>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Migrate images to Cloudflare R2 (Phase 2)</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            Copies every product / variant / category image from Cloudinary into your <b>Cloudflare R2 bucket</b>
            and repoints the database to serve each one from <b>img.sterlinglams.com</b> — so the site no longer
            depends on Cloudinary. Safe to run anytime and to re-run (already-moved images are skipped). Requires
            R2 configured in <a asp-controller="Integrations" asp-action="Index" class="text-brand-600 hover:underline">Admin → Integrations</a>.
            Runs in batches — <b>keep this tab open</b> until it says done. The storefront keeps working throughout;
            turn on <b>"Resize images via Cloudflare"</b> only after this finishes.
        </p>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-r2migrate" class="px-5 py-2 bg-neutral-900 text-white text-sm rounded-md hover:bg-neutral-700">Migrate images to R2</button>
            <span id="pi-r2migrate-status" class="text-sm text-neutral-500"></span>
        </div>
        <div id="pi-r2migrate-bar-wrap" class="hidden mt-3 h-2 w-full max-w-md bg-neutral-100 rounded-full overflow-hidden">
            <div id="pi-r2migrate-bar" class="h-full bg-emerald-500 transition-all" style="width:0%"></div>
        </div>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Generate pre-sized images (free delivery, no transforms)</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            Creates small WebP versions of every R2 image at a few fixed sizes and stores them in R2, so the
            storefront serves a right-sized file directly — with <b>no Cloudflare transformations</b> (zero cost,
            no quota). Run this <b>after</b> the R2 migration above is done. When it finishes, go to
            <a asp-controller="Integrations" asp-action="Index" class="text-brand-600 hover:underline">Admin → Integrations</a>,
            turn on <b>"Serve pre-sized R2 images"</b> and turn <b>"Resize images via Cloudflare"</b> off.
            Safe to re-run (overwrites). Runs in batches — <b>keep this tab open</b> until it says done.
        </p>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-presize" class="px-5 py-2 bg-neutral-900 text-white text-sm rounded-md hover:bg-neutral-700">Generate pre-sized images</button>
            <span id="pi-presize-status" class="text-sm text-neutral-500"></span>
        </div>
        <div id="pi-presize-bar-wrap" class="hidden mt-3 h-2 w-full max-w-md bg-neutral-100 rounded-full overflow-hidden">
            <div id="pi-presize-bar" class="h-full bg-emerald-500 transition-all" style="width:0%"></div>
        </div>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Import barcodes (EposNow)</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            Upload an EposNow <strong>ProductList</strong> CSV (<span class="font-mono">Name;CategoryId;Barcode</span>).
            Each row's SKU (the leading code in Name) is matched to a product — a <strong>simple</strong> product gets
            the barcode on itself, a <strong>variable</strong> product gets it on the matching colour/size variant.
            SKUs not in the catalogue are skipped. <strong>Preview first</strong> — nothing is written until you Apply.
        </p>
        <label class="block text-xs text-neutral-500 mt-3 mb-1">Barcodes CSV</label>
        <input id="pi-bc-file" type="file" accept=".csv,text/csv"
               class="block w-full text-sm text-neutral-700 file:mr-3 file:py-2 file:px-4 file:rounded-sm file:border-0 file:bg-neutral-900 file:text-white file:text-xs file:cursor-pointer border border-neutral-200 rounded-sm" />
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-bc-preview" class="px-5 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500">Preview</button>
            <button type="button" id="pi-bc-apply" class="px-6 py-2 bg-neutral-900 text-white text-sm font-medium rounded-md hover:bg-black disabled:opacity-40 disabled:cursor-not-allowed" disabled>Apply</button>
            <span id="pi-bc-status" class="text-sm text-neutral-500"></span>
        </div>
        <div id="pi-bc-results" class="hidden mt-4"></div>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Import stock &amp; EPOS prices (EposNow)</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            Upload an EposNow stock export (<span class="font-mono">.xlsx</span> or <span class="font-mono">.csv</span>:
            <span class="font-mono">Name, Barcode, DatedStock, SalePrice…</span>) for <strong>one branch</strong>.
            Each row is matched to a product/variant by its <strong>barcode</strong>. Apply sets that branch's
            <strong>on-hand quantity</strong> to <span class="font-mono">DatedStock</span>, and (optionally) writes
            <span class="font-mono">SalePrice</span> as the product's <strong>EPOS price</strong> — the till price only;
            the website price and sale price are never touched. <strong>Preview first</strong> — nothing is written until you Apply.
        </p>
        <div class="grid sm:grid-cols-2 gap-3 mt-3">
            <div>
                <label class="block text-xs text-neutral-500 mb-1">Branch (store)</label>
                <select id="pi-st-store" class="block w-full text-sm border border-neutral-200 rounded-sm px-3 py-2 bg-white">
                    <option value="">— choose store —</option>
                    @foreach (var s in (ViewBag.Stores as IEnumerable<SterlingLams.Web.Models.Domain.Store> ?? Enumerable.Empty<SterlingLams.Web.Models.Domain.Store>()))
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs text-neutral-500 mb-1">Stock file (.xlsx / .csv)</label>
                <input id="pi-st-file" type="file" accept=".xlsx,.csv,text/csv"
                       class="block w-full text-sm text-neutral-700 file:mr-3 file:py-2 file:px-4 file:rounded-sm file:border-0 file:bg-neutral-900 file:text-white file:text-xs file:cursor-pointer border border-neutral-200 rounded-sm" />
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-4 mt-3">
            <label class="flex items-center gap-2 text-sm text-neutral-700"><input id="pi-st-stock" type="checkbox" checked /> Set on-hand stock</label>
            <label class="flex items-center gap-2 text-sm text-neutral-700"><input id="pi-st-pos" type="checkbox" checked /> Set EPOS price from SalePrice</label>
        </div>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-st-preview" class="px-5 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500">Preview</button>
            <button type="button" id="pi-st-apply" class="px-6 py-2 bg-neutral-900 text-white text-sm font-medium rounded-md hover:bg-black disabled:opacity-40 disabled:cursor-not-allowed" disabled>Apply to branch</button>
            <span id="pi-st-status" class="text-sm text-neutral-500"></span>
        </div>
        <div id="pi-st-results" class="hidden mt-4"></div>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <h2 class="text-sm font-semibold text-neutral-800">Remove hyphens from SKUs</h2>
        <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
            Cleans product SKUs to your store's hyphen-free format (e.g. <span class="font-mono">601-2134 → 6012134</span>).
            If a cleaned SKU already belongs to another product, that hyphenated one is a duplicate and is moved to
            <strong>Trash</strong> instead. Runs in batches — keep the tab open.
        </p>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="pi-sku" class="px-5 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500">Remove hyphens from SKUs</button>
            <span id="pi-sku-status" class="text-sm text-neutral-500"></span>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var fileEl = document.getElementById('pi-file');
    var previewBtn = document.getElementById('pi-preview');
    var applyBtn = document.getElementById('pi-apply');
    var statusEl = document.getElementById('pi-status');
    var results = document.getElementById('pi-results');
    var token = document.querySelector('input[name="__RequestVerificationToken"]');
    var base = (window.__adminBase || '') + '/ProductImport/';
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };

    fileEl.addEventListener('change', function () { applyBtn.disabled = true; results.classList.add('hidden'); statusEl.textContent = ''; });

    function stat(label, val, tone) {
        return '<div class="border border-neutral-200 rounded-md px-3 py-2">'
            + '<div class="text-xl font-semibold ' + (tone || 'text-neutral-900') + '">' + val + '</div>'
            + '<div class="text-[11px] uppercase tracking-wide text-neutral-400">' + label + '</div></div>';
    }

    function render(d, importedTotal) {
        var grid = '<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">'
            + stat(d.applied ? 'Imported' : 'Will import', d.applied ? importedTotal : d.candidates, 'text-emerald-600')
            + stat('Already in store', d.skippedExisting)
            + stat('New categories', d.newCategories)
            + stat('Images hosted', d.imagesHosted)
            + stat(d.applied ? 'Variants created' : 'Variants in file', d.applied ? d.variantsCreated : d.variantRows)
            + stat('No SKU', d.skippedNoSku)
            + stat('Rows in file', d.totalRows)
            + (d.applied ? stat('Remaining', d.remaining, d.remaining ? 'text-amber-600' : 'text-neutral-900') : '')
            + '</div>';
        var sample = '';
        if (d.samples && d.samples.length) {
            sample = '<h3 class="text-sm font-semibold text-neutral-700 mt-6 mb-2">Sample (' + (d.applied ? 'batch' : 'first that would import') + ')</h3>'
                + '<div class="overflow-x-auto"><table class="w-full text-sm border border-neutral-200 rounded-md">'
                + '<thead><tr class="bg-neutral-50 text-left text-xs uppercase tracking-wide text-neutral-500">'
                + '<th class="px-3 py-2">SKU</th><th class="px-3 py-2">Title</th><th class="px-3 py-2">Category</th><th class="px-3 py-2">Price</th></tr></thead><tbody>'
                + d.samples.map(function (s) {
                    return '<tr class="border-t border-neutral-100"><td class="px-3 py-2 font-mono text-xs">' + esc(s.sku) + '</td>'
                        + '<td class="px-3 py-2">' + esc(s.title) + '</td>'
                        + '<td class="px-3 py-2">' + esc(s.category) + '</td>'
                        + '<td class="px-3 py-2">₦' + esc(s.price) + '</td></tr>';
                }).join('') + '</tbody></table></div>';
        }
        results.innerHTML = grid + sample;
        results.classList.remove('hidden');
    }

    function post(url) {
        var fd = new FormData();
        fd.append('file', fileEl.files[0]);
        fd.append('__RequestVerificationToken', token ? token.value : '');
        return fetch(url, { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
            .then(function (r) { return r.json(); });
    }

    previewBtn.addEventListener('click', function () {
        if (!fileEl.files || !fileEl.files.length) { statusEl.textContent = 'Choose a CSV file first.'; return; }
        statusEl.textContent = 'Reading…'; previewBtn.disabled = true; applyBtn.disabled = true;
        post(base + 'Preview').then(function (d) {
            previewBtn.disabled = false;
            if (!d.ok) { statusEl.textContent = d.error || 'Failed.'; return; }
            render(d, 0);
            statusEl.textContent = d.candidates + ' new product(s) ready to import (' + d.skippedExisting + ' already in store).';
            applyBtn.disabled = d.candidates === 0;
        }).catch(function () { previewBtn.disabled = false; statusEl.textContent = 'Request failed.'; });
    });

    applyBtn.addEventListener('click', function () {
        if (!fileEl.files || !fileEl.files.length) { statusEl.textContent = 'Choose a CSV file first.'; return; }
        if (!confirm('Import these products into the store? Products with an existing SKU are skipped; images are uploaded to Cloudinary. This runs in batches — keep the tab open.')) return;
        previewBtn.disabled = true; applyBtn.disabled = true;
        var importedTotal = 0;
        function batch() {
            statusEl.textContent = 'Importing… ' + importedTotal + ' done so far (uploading images, please wait)…';
            post(base + 'Apply').then(function (d) {
                if (!d.ok) { statusEl.textContent = d.error || 'Failed.'; previewBtn.disabled = false; return; }
                importedTotal += d.created;
                render(d, importedTotal);
                if (d.remaining > 0 && d.created > 0) {
                    batch();   // keep going until nothing remains
                } else {
                    statusEl.textContent = 'Done — imported ' + importedTotal + ' product(s). '
                        + (d.remaining > 0 ? (d.remaining + ' could not be created (see logs).') : 'Now set opening stock per branch.');
                    previewBtn.disabled = false;
                }
            }).catch(function () { statusEl.textContent = 'A batch failed — click Import again to resume (already-imported items are skipped).'; previewBtn.disabled = false; applyBtn.disabled = false; });
        }
        batch();
    });

    // ── Re-host external images → Cloudinary (batched, repeats until done) ──
    var rehostBtn = document.getElementById('pi-rehost');
    var rehostStatus = document.getElementById('pi-rehost-status');
    rehostBtn.addEventListener('click', function () {
        if (!confirm('Move all product images that are still on external URLs onto Cloudinary? Safe to run repeatedly.')) return;
        rehostBtn.disabled = true;
        var total = 0;
        function step() {
            rehostStatus.textContent = 'Re-hosting… ' + total + ' moved so far…';
            var fd = new FormData(); fd.append('__RequestVerificationToken', token ? token.value : '');
            fetch(base + 'RehostImages', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.ok) { rehostStatus.textContent = d.error || 'Failed.'; rehostBtn.disabled = false; return; }
                    total += d.converted;
                    if (d.converted > 0 && d.remaining > 0) { step(); }
                    else {
                        rehostStatus.textContent = 'Done — moved ' + total + ' image(s) to Cloudinary.'
                            + (d.remaining > 0 ? ' ' + d.remaining + ' could not be fetched (left as-is).' : '');
                        rehostBtn.disabled = false;
                    }
                })
                .catch(function () { rehostStatus.textContent = 'A batch failed — click again to resume.'; rehostBtn.disabled = false; });
        }
        step();
    });

    // ── Copy images into ImageKit (Phase 2) — batched loop until done ──
    var ikBtn = document.getElementById('pi-ikmigrate');
    var ikStatus = document.getElementById('pi-ikmigrate-status');
    var ikBarWrap = document.getElementById('pi-ikmigrate-bar-wrap');
    var ikBar = document.getElementById('pi-ikmigrate-bar');
    if (ikBtn) {
        ikBtn.addEventListener('click', function () {
            ikBtn.disabled = true;
            var total = 0, copied = 0, failed = 0, cursor = 'pi:0';
            ikBarWrap.classList.remove('hidden');
            // Get the total first so we can show a progress bar.
            fetch(base + 'ImageKitMigrationStatus').then(function (r) { return r.json(); }).then(function (s) {
                if (!s.ok) { ikStatus.textContent = 'Could not read status.'; ikBtn.disabled = false; return; }
                if (!s.configured) { ikStatus.textContent = 'Add the ImageKit URL endpoint + private key in Admin → Integrations first.'; ikBtn.disabled = false; return; }
                total = s.total || 0;
                if (total === 0) { ikStatus.textContent = 'No Cloudinary images found to copy.'; ikBtn.disabled = false; return; }
                step();
            }).catch(function () { ikStatus.textContent = 'Request failed.'; ikBtn.disabled = false; });

            function step() {
                var fd = new FormData();
                fd.append('__RequestVerificationToken', token ? token.value : '');
                fd.append('cursor', cursor);
                fetch(base + 'MigrateToImageKit', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.ok) { ikStatus.textContent = d.error || 'Failed.'; ikBtn.disabled = false; return; }
                        copied += d.uploaded; failed += d.failed; cursor = d.cursor;
                        var pct = total ? Math.min(100, Math.round((total - d.remaining) / total * 100)) : 100;
                        ikBar.style.width = pct + '%';
                        ikStatus.textContent = 'Copying… ' + copied + ' of ' + total + ' done' + (failed ? (' · ' + failed + ' failed') : '') + ' (' + pct + '%)';
                        if (d.done) {
                            ikBar.style.width = '100%';
                            ikStatus.textContent = 'Done — copied ' + copied + ' image(s) into ImageKit' + (failed ? (' · ' + failed + ' failed (re-run to retry)') : '') + '. Verify the storefront, then you can remove the Cloudinary origin.';
                            ikBtn.disabled = false;
                        } else { step(); }
                    })
                    .catch(function () { ikStatus.textContent = 'A batch failed — click again to resume (already-copied images are overwritten safely).'; ikBtn.disabled = false; });
            }
        });
    }

    // ── Migrate images to Cloudflare R2 (Phase 2) — batched loop until done ──
    var r2Btn = document.getElementById('pi-r2migrate');
    var r2Status = document.getElementById('pi-r2migrate-status');
    var r2BarWrap = document.getElementById('pi-r2migrate-bar-wrap');
    var r2Bar = document.getElementById('pi-r2migrate-bar');
    if (r2Btn) {
        r2Btn.addEventListener('click', function () {
            r2Btn.disabled = true;
            var total = 0, copied = 0, failed = 0, cursor = 'pi:0';
            r2BarWrap.classList.remove('hidden');
            fetch(base + 'R2MigrationStatus').then(function (r) { return r.json(); }).then(function (s) {
                if (!s.ok) { r2Status.textContent = 'Could not read status.'; r2Btn.disabled = false; return; }
                if (!s.configured) { r2Status.textContent = "Fill in the R2 details and turn on 'Store new images in R2' in Admin → Integrations first."; r2Btn.disabled = false; return; }
                total = s.total || 0;
                if (total === 0) { r2Status.textContent = 'No Cloudinary images left to move — all done.'; r2Btn.disabled = false; return; }
                step();
            }).catch(function () { r2Status.textContent = 'Request failed.'; r2Btn.disabled = false; });

            function step() {
                var fd = new FormData();
                fd.append('__RequestVerificationToken', token ? token.value : '');
                fd.append('cursor', cursor);
                fetch(base + 'MigrateToR2', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.ok) { r2Status.textContent = d.error || 'Failed.'; r2Btn.disabled = false; return; }
                        copied += d.uploaded; failed += d.failed; cursor = d.cursor;
                        var pct = total ? Math.min(100, Math.round((total - d.remaining) / total * 100)) : 100;
                        r2Bar.style.width = pct + '%';
                        r2Status.textContent = 'Moving… ' + copied + ' of ' + total + ' done' + (failed ? (' · ' + failed + ' failed') : '') + ' (' + pct + '%)';
                        if (d.done) {
                            r2Bar.style.width = '100%';
                            r2Status.textContent = 'Done — moved ' + copied + ' image(s) into R2' + (failed ? (' · ' + failed + ' failed (re-run to retry)') : '') + '. Now turn on "Resize images via Cloudflare" in Integrations.';
                            r2Btn.disabled = false;
                        } else { step(); }
                    })
                    .catch(function () { r2Status.textContent = 'A batch failed — click again to resume (already-moved images are skipped).'; r2Btn.disabled = false; });
            }
        });
    }

    // ── Generate pre-sized images (free delivery) — batched loop until done ──
    var psBtn = document.getElementById('pi-presize');
    var psStatus = document.getElementById('pi-presize-status');
    var psBarWrap = document.getElementById('pi-presize-bar-wrap');
    var psBar = document.getElementById('pi-presize-bar');
    if (psBtn) {
        // Remember how far we got so a failed/interrupted run RESUMES instead of restarting — survives
        // even a page reload. Cleared when the whole job finishes (so a later click re-runs from scratch).
        var PS_KEY = 'sg-presize-cursor';
        psBtn.addEventListener('click', function () {
            psBtn.disabled = true;
            var total = 0, failed = 0;
            var saved = '';
            try { saved = localStorage.getItem(PS_KEY) || ''; } catch (e) {}
            // Resume from the saved position unless the previous run had already finished.
            var cursor = (saved && saved.indexOf('done') !== 0) ? saved : 'pi:0';
            psBarWrap.classList.remove('hidden');
            fetch(base + 'PresizeStatus').then(function (r) { return r.json(); }).then(function (s) {
                if (!s.ok) { psStatus.textContent = 'Could not read status.'; psBtn.disabled = false; return; }
                if (!s.configured) { psStatus.textContent = 'Configure R2 in Admin → Integrations first.'; psBtn.disabled = false; return; }
                total = s.total || 0;
                if (total === 0) { psStatus.textContent = 'No R2 images found — run the migration above first.'; psBtn.disabled = false; return; }
                step();
            }).catch(function () { psStatus.textContent = 'Request failed.'; psBtn.disabled = false; });

            function step() {
                var fd = new FormData();
                fd.append('__RequestVerificationToken', token ? token.value : '');
                fd.append('cursor', cursor);
                fetch(base + 'PresizeR2', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.ok) { psStatus.textContent = d.error || 'Failed.'; psBtn.disabled = false; return; }
                        failed += d.failed; cursor = d.cursor;
                        try { localStorage.setItem(PS_KEY, cursor); } catch (e) {}
                        // Progress is driven by the server's "remaining" so it stays accurate across resumes/reloads.
                        var processed = total ? Math.max(0, total - d.remaining) : 0;
                        var pct = total ? Math.min(100, Math.round(processed / total * 100)) : 100;
                        psBar.style.width = pct + '%';
                        psStatus.textContent = 'Generating… ' + processed + ' of ' + total + ' done' + (failed ? (' · ' + failed + ' failed') : '') + ' (' + pct + '%)';
                        if (d.done) {
                            try { localStorage.removeItem(PS_KEY); } catch (e) {}
                            psBar.style.width = '100%';
                            psStatus.textContent = 'Done — pre-sized all ' + total + ' image(s)' + (failed ? (' · ' + failed + ' failed (re-run to retry)') : '') + '. Now enable "Serve pre-sized R2 images" in Integrations and turn Cloudflare resizing off.';
                            psBtn.disabled = false;
                        } else { step(); }
                    })
                    .catch(function () { psStatus.textContent = 'A batch failed — click again to resume.'; psBtn.disabled = false; });
            }
        });
    }

    // ── Import barcodes (EposNow ProductList) — preview then apply ──
    var bcFile = document.getElementById('pi-bc-file');
    var bcPreview = document.getElementById('pi-bc-preview');
    var bcApply = document.getElementById('pi-bc-apply');
    var bcStatus = document.getElementById('pi-bc-status');
    var bcResults = document.getElementById('pi-bc-results');
    bcFile.addEventListener('change', function () { bcApply.disabled = true; bcResults.classList.add('hidden'); bcStatus.textContent = ''; });

    function bcPost(url) {
        var fd = new FormData(); fd.append('file', bcFile.files[0]);
        fd.append('__RequestVerificationToken', token ? token.value : '');
        return fetch(url, { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } }).then(function (r) { return r.json(); });
    }
    function bcRender(d) {
        var grid = '<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">'
            + stat(d.committed ? 'Written' : 'To write', d.committed ? d.written : d.toWrite, 'text-emerald-600')
            + stat('Products matched', d.productsMatched)
            + stat('SKUs not in store', d.skusNotFound)
            + stat('No variant match', d.noVariantMatch)
            + stat('Ambiguous', d.ambiguous)
            + stat('Duplicate barcodes', d.duplicateBarcodes)
            + stat('Rows read', d.rowsRead)
            + (d.writeFailed ? stat('Write failed', '!', 'text-red-600') : '')
            + '</div>';
        var sample = '';
        if (d.sample && d.sample.length) {
            sample = '<h3 class="text-sm font-semibold text-neutral-700 mt-5 mb-2">Sample matches</h3>'
                + '<div class="overflow-x-auto"><table class="w-full text-sm border border-neutral-200 rounded-md">'
                + '<thead><tr class="bg-neutral-50 text-left text-xs uppercase tracking-wide text-neutral-500">'
                + '<th class="px-3 py-2">SKU</th><th class="px-3 py-2">Barcode</th><th class="px-3 py-2">Goes to</th></tr></thead><tbody>'
                + d.sample.map(function (s) {
                    return '<tr class="border-t border-neutral-100"><td class="px-3 py-2 font-mono text-xs">' + esc(s.sku) + '</td>'
                        + '<td class="px-3 py-2 font-mono text-xs">' + esc(s.barcode) + '</td>'
                        + '<td class="px-3 py-2">' + esc(s.status === 'product-barcode' ? 'product (simple)' : (s.variant || '')) + '</td></tr>';
                }).join('') + '</tbody></table></div>';
        }
        bcResults.innerHTML = grid + sample; bcResults.classList.remove('hidden');
    }
    bcPreview.addEventListener('click', function () {
        if (!bcFile.files || !bcFile.files.length) { bcStatus.textContent = 'Choose a CSV first.'; return; }
        bcStatus.textContent = 'Reading…'; bcPreview.disabled = true; bcApply.disabled = true;
        bcPost(base + 'PreviewBarcodes').then(function (d) {
            bcPreview.disabled = false;
            if (!d.ok) { bcStatus.textContent = d.error || 'Failed.'; return; }
            bcRender(d);
            bcStatus.textContent = d.toWrite + ' barcode(s) ready to write (' + d.productsMatched + ' products matched).';
            bcApply.disabled = d.toWrite === 0;
        }).catch(function () { bcPreview.disabled = false; bcStatus.textContent = 'Request failed.'; });
    });
    bcApply.addEventListener('click', function () {
        if (!confirm('Write these barcodes to the matched products? Existing barcodes on those items are overwritten.')) return;
        bcPreview.disabled = true; bcApply.disabled = true; bcStatus.textContent = 'Writing…';
        bcPost(base + 'ApplyBarcodes').then(function (d) {
            bcPreview.disabled = false;
            if (!d.ok) { bcStatus.textContent = d.error || 'Failed.'; return; }
            bcRender(d);
            bcStatus.textContent = d.writeFailed ? 'Write failed — nothing saved. ' + (d.errors[0] || '') : ('Done — ' + d.written + ' barcode(s) written.');
        }).catch(function () { bcPreview.disabled = false; bcStatus.textContent = 'Request failed.'; });
    });

    // ── Import stock & EPOS prices (EposNow) — preview then apply, with an issues list ──
    var stStore = document.getElementById('pi-st-store');
    var stFile = document.getElementById('pi-st-file');
    var stStock = document.getElementById('pi-st-stock');
    var stPos = document.getElementById('pi-st-pos');
    var stPreview = document.getElementById('pi-st-preview');
    var stApply = document.getElementById('pi-st-apply');
    var stStatus = document.getElementById('pi-st-status');
    var stResults = document.getElementById('pi-st-results');
    [stFile, stStore, stStock, stPos].forEach(function (el) {
        el.addEventListener('change', function () { stApply.disabled = true; stResults.classList.add('hidden'); stStatus.textContent = ''; });
    });

    function stPost(url) {
        var fd = new FormData();
        fd.append('file', stFile.files[0]);
        fd.append('storeId', stStore.value || '0');
        fd.append('setStock', stStock.checked);
        fd.append('setPosPrice', stPos.checked);
        fd.append('__RequestVerificationToken', token ? token.value : '');
        return fetch(url, { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } }).then(function (r) { return r.json(); });
    }

    function stRender(d) {
        var grid = '<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">'
            + stat(d.committed ? 'Stock set' : 'Stock lines', d.stockLines, 'text-emerald-600')
            + stat('Total units', d.totalUnits)
            + stat(d.committed ? 'EPOS prices set' : 'EPOS prices', d.posPricesSet)
            + stat('Matched', d.matched)
            + stat('Issues', d.issuesTotal, d.issuesTotal ? 'text-amber-600' : 'text-neutral-900')
            + stat('Rows in file', d.rowsRead)
            + '</div>';
        var issues = '';
        if (d.issues && d.issues.length) {
            issues = '<div class="flex items-center justify-between mt-6 mb-2">'
                + '<h3 class="text-sm font-semibold text-neutral-700">Rows with issues'
                + (d.issuesTotal > d.issues.length ? ' (showing ' + d.issues.length + ' of ' + d.issuesTotal + ')' : '')
                + '</h3>'
                + '<button type="button" id="pi-st-dl" class="text-xs px-3 py-1.5 border border-neutral-300 rounded-md hover:border-neutral-500">Download all issues (CSV)</button></div>'
                + '<div class="overflow-x-auto max-h-96 overflow-y-auto border border-neutral-200 rounded-md"><table class="w-full text-sm">'
                + '<thead class="sticky top-0 bg-neutral-50"><tr class="text-left text-xs uppercase tracking-wide text-neutral-500">'
                + '<th class="px-3 py-2">SKU</th><th class="px-3 py-2">Name</th><th class="px-3 py-2">Barcode</th><th class="px-3 py-2">Qty</th><th class="px-3 py-2">Issue</th></tr></thead><tbody>'
                + d.issues.map(function (i) {
                    return '<tr class="border-t border-neutral-100"><td class="px-3 py-2 font-mono text-xs">' + esc(i.sku) + '</td>'
                        + '<td class="px-3 py-2">' + esc(i.name) + '</td>'
                        + '<td class="px-3 py-2 font-mono text-xs">' + esc(i.barcode) + '</td>'
                        + '<td class="px-3 py-2">' + esc(i.qty) + '</td>'
                        + '<td class="px-3 py-2 text-amber-700">' + esc(i.reason) + '</td></tr>';
                }).join('') + '</tbody></table></div>';
        }
        stResults.innerHTML = grid + issues;
        stResults.classList.remove('hidden');
        var dl = document.getElementById('pi-st-dl');
        if (dl) dl.addEventListener('click', stDownloadIssues);
    }

    function stDownloadIssues() {
        var fd = new FormData();
        fd.append('file', stFile.files[0]);
        fd.append('storeId', stStore.value || '0');
        fd.append('__RequestVerificationToken', token ? token.value : '');
        fetch(base + 'ExportStockIssues', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
            .then(function (r) { return r.blob(); })
            .then(function (b) {
                var url = URL.createObjectURL(b); var a = document.createElement('a');
                a.href = url; a.download = 'stock-import-issues.csv'; document.body.appendChild(a); a.click();
                a.remove(); URL.revokeObjectURL(url);
            });
    }

    function stValidate() {
        if (!stStore.value) { stStatus.textContent = 'Choose the branch first.'; return false; }
        if (!stFile.files || !stFile.files.length) { stStatus.textContent = 'Choose a stock file first.'; return false; }
        return true;
    }

    stPreview.addEventListener('click', function () {
        if (!stValidate()) return;
        stStatus.textContent = 'Reading…'; stPreview.disabled = true; stApply.disabled = true;
        stPost(base + 'PreviewStock').then(function (d) {
            stPreview.disabled = false;
            if (!d.ok) { stStatus.textContent = d.error || 'Failed.'; return; }
            stRender(d);
            stStatus.textContent = d.matched + ' matched · ' + d.stockLines + ' stock change(s) · ' + d.issuesTotal + ' issue(s).';
            stApply.disabled = (d.stockLines === 0 && d.posPricesSet === 0);
        }).catch(function () { stPreview.disabled = false; stStatus.textContent = 'Request failed.'; });
    });

    stApply.addEventListener('click', function () {
        if (!stValidate()) return;
        var label = stStore.options[stStore.selectedIndex].text;
        if (!confirm('Apply this stock to ' + label + '? On-hand quantities are SET to the sheet values'
            + (stPos.checked ? ', and EPOS prices updated from SalePrice' : '') + '. Website prices are not touched.')) return;
        stPreview.disabled = true; stApply.disabled = true; stStatus.textContent = 'Applying…';
        stPost(base + 'ApplyStock').then(function (d) {
            stPreview.disabled = false;
            if (!d.ok) { stStatus.textContent = d.error || 'Failed.'; return; }
            stRender(d);
            stStatus.textContent = 'Done — ' + d.stockLines + ' stock line(s), ' + d.totalUnits + ' units'
                + (stPos.checked ? ', ' + d.posPricesSet + ' EPOS price(s)' : '') + ' set for ' + label + '.'
                + (d.issuesTotal ? ' ' + d.issuesTotal + ' row(s) had issues — download the CSV to fix them.' : '');
        }).catch(function () { stPreview.disabled = false; stApply.disabled = false; stStatus.textContent = 'Request failed.'; });
    });

    // ── Remove hyphens from SKUs (batched, repeats until done) ──
    var skuBtn = document.getElementById('pi-sku');
    var skuStatus = document.getElementById('pi-sku-status');
    skuBtn.addEventListener('click', function () {
        if (!confirm('Remove hyphens from all product SKUs? Duplicates (where the clean SKU already exists) are moved to Trash. Safe to run repeatedly.')) return;
        skuBtn.disabled = true;
        var cleanedTotal = 0, trashedTotal = 0;
        function step() {
            skuStatus.textContent = 'Cleaning… ' + cleanedTotal + ' fixed, ' + trashedTotal + ' dupes trashed so far…';
            var fd = new FormData(); fd.append('__RequestVerificationToken', token ? token.value : '');
            fetch(base + 'NormalizeSkus', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.ok) { skuStatus.textContent = d.error || 'Failed.'; skuBtn.disabled = false; return; }
                    cleanedTotal += d.cleaned; trashedTotal += d.trashedDupes;
                    if ((d.cleaned + d.trashedDupes) > 0 && d.remaining > 0) { step(); }
                    else {
                        skuStatus.textContent = 'Done — ' + cleanedTotal + ' SKU(s) cleaned, ' + trashedTotal + ' duplicate(s) moved to Trash.'
                            + (d.remaining > 0 ? ' ' + d.remaining + ' left.' : '');
                        skuBtn.disabled = false;
                    }
                })
                .catch(function () { skuStatus.textContent = 'A batch failed — click again to resume.'; skuBtn.disabled = false; });
        }
        step();
    });
})();
</script>
}
