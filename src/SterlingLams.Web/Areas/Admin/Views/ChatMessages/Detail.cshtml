@model SterlingLams.Web.Areas.Admin.Controllers.ChatMessagesController.ChatThreadVm
@{
    ViewData["Title"] = "Chat";
    var conv = Model.Conversation;
    string Stamp(DateTime utc) => SterlingLams.Web.Services.ReportCalendar.ToLocal(utc).ToString("MMM d, HH:mm");
    var name = !string.IsNullOrWhiteSpace(conv.CustomerName) ? conv.CustomerName
               : !string.IsNullOrWhiteSpace(conv.ContactEmail) ? conv.ContactEmail
               : !string.IsNullOrWhiteSpace(conv.ContactPhone) ? conv.ContactPhone : "Guest";
    var waDigits = new string((conv.ContactPhone ?? "").Where(char.IsDigit).ToArray());
    var lastId = Model.Messages.Count > 0 ? Model.Messages[^1].Id : 0;
    var initial = name!.Substring(0, 1).ToUpper();
}
@Html.AntiForgeryToken()

@if (TempData["Error"] != null) { <div class="max-w-4xl mb-3 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-2.5 rounded-sm">@TempData["Error"]</div> }

<div class="max-w-4xl">
    <a asp-action="Index" class="text-sm text-neutral-500 hover:text-neutral-900 inline-flex items-center gap-1 mb-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg> Inbox
    </a>

    <!-- Customer header card -->
    <div class="bg-white border border-neutral-200 rounded-xl p-3 md:p-4 mb-3 flex items-start gap-3 md:gap-4 flex-wrap">
        <div class="w-12 h-12 rounded-full flex items-center justify-center text-lg font-semibold flex-shrink-0 text-white"
             style="background:@(Model.IsSignedIn ? "#ed028b" : "#9ca3af")">@initial</div>
        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-lg font-semibold text-neutral-900">@name</h1>
                @if (Model.IsSignedIn)
                {
                    <span class="text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Signed-in customer
                    </span>
                }
                else
                {
                    <span class="text-[11px] font-medium bg-neutral-100 text-neutral-500 border border-neutral-200 px-2 py-0.5 rounded-full">Guest</span>
                }
                @if (Model.PriorChats == 0)
                {
                    <span class="text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded-full">✦ First-time chat</span>
                }
                else
                {
                    <span class="text-[11px] font-medium bg-violet-50 text-violet-700 border border-violet-200 px-2 py-0.5 rounded-full">Returning · @Model.PriorChats prev. chat@(Model.PriorChats == 1 ? "" : "s")</span>
                }
                @if (Model.OrderCount > 0)
                {
                    <span class="text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200 px-2 py-0.5 rounded-full">@Model.OrderCount order@(Model.OrderCount == 1 ? "" : "s")</span>
                }
                @if (conv.Ended)
                {
                    <span class="text-[11px] bg-neutral-100 text-neutral-400 px-2 py-0.5 rounded-full">Ended</span>
                }
            </div>
            <div class="text-xs text-neutral-500 mt-1 flex flex-wrap gap-x-3 gap-y-0.5">
                @if (!string.IsNullOrWhiteSpace(conv.ContactEmail)) { <span>✉ @conv.ContactEmail</span> }
                @if (!string.IsNullOrWhiteSpace(conv.ContactPhone)) { <span>✆ @conv.ContactPhone</span> }
                <span>Started @Stamp(conv.CreatedAt)</span>
                @if (!string.IsNullOrWhiteSpace(conv.DeviceType)) { <span>· @conv.DeviceType</span> }
            </div>
        </div>
        <div class="flex items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(waDigits))
            {
                <a href="https://wa.me/@waDigits" target="_blank" rel="noopener" class="text-xs text-emerald-700 hover:bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-1.5">WhatsApp</a>
            }
            @if (!string.IsNullOrWhiteSpace(conv.ContactEmail))
            {
                <a href="mailto:@conv.ContactEmail" class="text-xs text-blue-700 hover:bg-blue-50 border border-blue-200 rounded-lg px-3 py-1.5">Email</a>
            }
            @if (!conv.Ended)
            {
                <form asp-action="End" method="post" class="inline" onsubmit="return confirm('End this chat?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@conv.Id" />
                    <button type="submit" class="text-xs text-neutral-500 hover:bg-neutral-100 border border-neutral-200 rounded-lg px-3 py-1.5">End chat</button>
                </form>
            }
        </div>
    </div>

    @if (conv.Rating != null)
    {
        <div class="mb-3 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm flex items-start gap-3">
            <span class="text-amber-500 text-lg leading-none mt-0.5">@(new string('★', conv.Rating.Value))@(new string('☆', 5 - conv.Rating.Value))</span>
            <div>
                <span class="text-neutral-700 font-medium">Rated @conv.Rating.Value/5</span>
                @if (conv.ReviewedAt != null) { <span class="text-neutral-400">· @Stamp(conv.ReviewedAt.Value)</span> }
                @if (!string.IsNullOrWhiteSpace(conv.ReviewComment)) { <div class="text-neutral-700 mt-1 italic">“@conv.ReviewComment”</div> }
            </div>
        </div>
    }

    <!-- Conversation -->
    <div class="bg-white border border-neutral-200 rounded-xl flex flex-col overflow-hidden" style="height:min(66vh,34rem)">
        <div id="thread" class="flex-1 overflow-y-auto px-4 py-4 space-y-3" style="background:linear-gradient(#fafafa,#f4f4f5)">
            @foreach (var m in Model.Messages)
            {
                if (m.IsAutomated)
                {
                    <div class="flex justify-center">
                        <div class="max-w-[85%] text-center text-[11px] text-neutral-500 bg-neutral-100 border border-neutral-200 rounded-lg px-3 py-1.5">
                            <span class="font-medium text-neutral-400">⚙ Auto-reply</span> · @m.Body
                        </div>
                    </div>
                    continue;
                }
                <div class="flex @(m.FromStaff ? "justify-end" : "justify-start") items-end gap-2">
                    @if (!m.FromStaff)
                    {
                        <div class="w-7 h-7 rounded-full bg-neutral-300 text-white flex items-center justify-center text-[11px] font-semibold flex-shrink-0">@initial</div>
                    }
                    <div class="max-w-[85%] md:max-w-[72%]">
                        <div class="@(m.FromStaff ? "bg-brand-500 text-white rounded-br-md" : "bg-white text-neutral-800 border border-neutral-200 rounded-bl-md") rounded-2xl px-4 py-2.5 text-sm shadow-sm" style="white-space:pre-wrap;overflow-wrap:anywhere">@if (!string.IsNullOrEmpty(m.ImageUrl)) { <a href="@m.ImageUrl" target="_blank" rel="noopener"><img src="@m.ImageUrl" alt="shared photo" loading="lazy" style="max-width:220px;max-height:240px;border-radius:10px;display:block" /></a> }@if (!string.IsNullOrEmpty(m.Body)) { <div class="@(string.IsNullOrEmpty(m.ImageUrl) ? "" : "mt-1.5")">@m.Body</div> }</div>
                        <div class="text-[10px] text-neutral-400 mt-1 @(m.FromStaff ? "text-right" : "")">
                            @(m.FromStaff ? (m.SenderName ?? "You") : name) · @Stamp(m.CreatedAt)
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (conv.Ended)
        {
            <div class="border-t border-neutral-100 px-4 py-2.5 text-center text-xs text-neutral-400 bg-neutral-50">
                This chat ended@(conv.EndedReason == "timeout" ? " (30 min inactivity)" : conv.EndedReason == "reviewed" ? " (shopper left a review)" : "")@(conv.EndedAt != null ? $" · {Stamp(conv.EndedAt.Value)}" : "") — a reply re-opens it.
            </div>
        }
        <form asp-action="Upload" method="post" enctype="multipart/form-data" id="img-form" class="hidden">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@conv.Id" />
            <input type="file" name="file" id="img-file" accept="image/jpeg,image/png,image/gif,image/webp" />
        </form>
        <form asp-action="Reply" method="post" class="border-t border-neutral-100 p-3 flex items-center gap-2 bg-white" id="reply-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@conv.Id" />
            <button type="button" id="img-attach" aria-label="Attach a photo" title="Attach a photo"
                    class="flex-shrink-0 w-9 h-9 rounded-full bg-neutral-100 text-neutral-500 hover:bg-neutral-200 flex items-center justify-center">
                <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="width:18px;height:18px"><path stroke-linecap="round" stroke-linejoin="round" d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
            </button>
            <input type="text" name="body" id="reply-input" autocomplete="off" placeholder="Type your reply…"
                   class="flex-1 border border-neutral-200 rounded-full px-4 py-2.5 text-sm focus:outline-none focus:border-brand-500" />
            <button type="submit" class="bg-brand-500 hover:bg-brand-600 text-white text-sm font-medium rounded-full px-6 py-2.5">Send</button>
        </form>
    </div>
    <p class="text-xs text-neutral-400 mt-2">Your reply appears in the shopper's chat window within a few seconds. New messages from them show here automatically.</p>
</div>

@section Scripts {
<script>
(function () {
    var base = window.__adminBase || '/Admin';
    var thread = document.getElementById('thread');
    var convId = @conv.Id;
    var lastId = @lastId;
    var customerName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(name));
    var initial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initial));

    thread.scrollTop = thread.scrollHeight;
    function esc(s){ var d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

    function append(m){
        var wrap = document.createElement('div');
        if (m.isAutomated){
            wrap.className = 'flex justify-center';
            wrap.innerHTML = '<div class="max-w-[85%] text-center text-[11px] text-neutral-500 bg-neutral-100 border border-neutral-200 rounded-lg px-3 py-1.5">' +
                '<span class="font-medium text-neutral-400">⚙ Auto-reply</span> · ' + esc(m.body) + '</div>';
            thread.appendChild(wrap); thread.scrollTop = thread.scrollHeight; return;
        }
        wrap.className = 'flex items-end gap-2 ' + (m.fromStaff ? 'justify-end' : 'justify-start');
        var bubbleCls = m.fromStaff ? 'bg-brand-500 text-white rounded-br-md' : 'bg-white text-neutral-800 border border-neutral-200 rounded-bl-md';
        var who = m.fromStaff ? 'You' : customerName;
        var ava = m.fromStaff ? '' : '<div class="w-7 h-7 rounded-full bg-neutral-300 text-white flex items-center justify-center text-[11px] font-semibold flex-shrink-0">' + esc(initial) + '</div>';
        var inner = '';
        if (m.imageUrl) inner += '<a href="' + encodeURI(m.imageUrl) + '" target="_blank" rel="noopener"><img src="' + encodeURI(m.imageUrl) + '" alt="shared photo" loading="lazy" style="max-width:220px;max-height:240px;border-radius:10px;display:block"></a>';
        if (m.body) inner += (m.imageUrl ? '<div class="mt-1.5">' : '') + esc(m.body) + (m.imageUrl ? '</div>' : '');
        if (!inner) inner = esc(m.body || '');
        wrap.innerHTML = ava + '<div class="max-w-[85%] md:max-w-[72%]">' +
            '<div class="' + bubbleCls + ' rounded-2xl px-4 py-2.5 text-sm shadow-sm" style="white-space:pre-wrap;overflow-wrap:anywhere">' + inner + '</div>' +
            '<div class="text-[10px] text-neutral-400 mt-1' + (m.fromStaff ? ' text-right' : '') + '">' + esc(who) + ' · ' + esc(m.at) + '</div></div>';
        thread.appendChild(wrap);
        thread.scrollTop = thread.scrollHeight;
    }

    async function poll(){
        try {
            var r = await fetch(base + '/ChatMessages/NewSince?id=' + convId + '&after=' + lastId, { headers: { 'Accept':'application/json' } });
            if (!r.ok) return;
            var d = await r.json();
            (d.messages || []).forEach(function(m){ if (m.id > lastId) { append(m); lastId = m.id; } });
        } catch (e) {}
    }
    setInterval(poll, 4000);

    // Attach a photo → auto-submit the (separate) upload form.
    var imgFile = document.getElementById('img-file');
    document.getElementById('img-attach').addEventListener('click', function(){ imgFile.click(); });
    imgFile.addEventListener('change', function(){ if (imgFile.files && imgFile.files[0]) document.getElementById('img-form').submit(); });
})();
</script>
}
