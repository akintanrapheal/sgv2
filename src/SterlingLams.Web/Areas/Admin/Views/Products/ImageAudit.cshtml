@model SterlingLams.Web.Services.ImageAuditResult?
@{
    ViewData["Title"] = "Image quality";
    var minWidth = (int)(ViewBag.MinWidth ?? 1000);
    var stock = (string)(ViewBag.Stock ?? "instock");
    var scopeLabel = stock == "outofstock" ? "Out-of-stock products" : stock == "all" ? "All products" : "In-stock products";
    string Badge(string sev) => sev == "Low"
        ? "bg-red-50 text-red-700 border-red-200"
        : "bg-amber-50 text-amber-700 border-amber-200";
}

<div class="max-w-5xl">
    <div class="flex items-start justify-between gap-4 mb-1">
        <div>
            <h1 class="text-xl font-semibold text-neutral-900">Image quality</h1>
            <p class="text-sm text-neutral-500 mt-1">
                Finds active product &amp; variant images whose original (uploaded) resolution is below the width you set, so
                they look soft/blurry on the storefront. The fix for each is to re-upload a larger original
                (the site never upscales). Scans every image, so it can take up to a minute or two.
            </p>
        </div>
    </div>

    <form method="get" class="flex flex-wrap items-end gap-3 bg-white border border-neutral-200 rounded-lg p-4 my-5">
        <div>
            <label class="block text-xs text-neutral-500 mb-1">Flag images narrower than (px)</label>
            <input type="number" name="minWidth" value="@minWidth" min="200" max="2000" step="100"
                   class="w-40 border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
            <p class="text-[11px] text-neutral-400 mt-1">1000 is a good default (crisp on phones &amp; laptops).</p>
        </div>
        <div>
            <label class="block text-xs text-neutral-500 mb-1">Products</label>
            <select name="stock" class="w-44 border border-neutral-200 rounded-sm px-3 py-2 text-sm bg-white focus:outline-none focus:border-neutral-400">
                <option value="instock" selected="@(stock == "instock")">In stock only</option>
                <option value="outofstock" selected="@(stock == "outofstock")">Out of stock only</option>
                <option value="all" selected="@(stock == "all")">All products</option>
            </select>
            <p class="text-[11px] text-neutral-400 mt-1">Fix what's live on the website first.</p>
        </div>
        <input type="hidden" name="run" value="true" />
        <button type="submit" class="px-5 py-2 bg-neutral-900 text-white text-sm rounded-sm hover:bg-black transition-colors">
            Run scan
        </button>
    </form>

    @if (Model != null)
    {
        <div class="text-sm text-neutral-600 mb-4 flex flex-wrap gap-x-6 gap-y-1">
            <span class="text-neutral-800 font-medium">@scopeLabel</span>
            <span>Checked <strong>@Model.Checked</strong> of @Model.Total images</span>
            <span><strong class="@(Model.Flagged.Count > 0 ? "text-amber-700" : "text-emerald-700")">@Model.Flagged.Count</strong> below @minWidth px</span>
            @if (Model.Unreadable > 0)
            {
                <span class="text-neutral-400">@Model.Unreadable couldn't be read</span>
            }
            <span class="text-neutral-400">@((Model.ElapsedMs / 1000.0).ToString("0.0"))s</span>
        </div>

        @if (Model.Partial)
        {
            <p class="mb-4 rounded-sm bg-amber-50 border border-amber-200 text-amber-800 text-xs px-3 py-2">
                The scan hit its time/size limit, so this is a partial result — run it again to continue, or scan
                during quiet hours. The images listed below are still accurate.
            </p>
        }

        @if (Model.Flagged.Count == 0)
        {
            <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-6 text-center">
                <p class="text-sm font-medium text-emerald-800">No blurry images below @minWidth px — @scopeLabel.ToLower().</p>
                <p class="text-xs text-emerald-700 mt-1">Every image in this set is high enough resolution.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto bg-white border border-neutral-200 rounded-lg">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wider text-neutral-400 border-b border-neutral-100">
                            <th class="px-4 py-2 font-medium">Preview</th>
                            <th class="px-4 py-2 font-medium">Product</th>
                            <th class="px-4 py-2 font-medium">Image</th>
                            <th class="px-4 py-2 font-medium">Source size</th>
                            <th class="px-4 py-2 font-medium">Severity</th>
                            <th class="px-4 py-2 font-medium">Stock</th>
                            <th class="px-4 py-2 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Flagged)
                        {
                            <tr class="border-b border-neutral-50 hover:bg-neutral-50/60">
                                <td class="px-4 py-2">
                                    <img src="@SterlingLams.Web.Infrastructure.Img.Cld(item.Url, 120, 120)" alt=""
                                         width="48" height="48" loading="lazy" class="w-12 h-12 object-cover rounded bg-neutral-100" />
                                </td>
                                <td class="px-4 py-2">
                                    <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@item.ProductId"
                                       class="text-neutral-800 hover:text-brand-600 font-medium">@item.ProductName</a>
                                </td>
                                <td class="px-4 py-2 text-neutral-600">@item.Label</td>
                                <td class="px-4 py-2 text-neutral-700 font-mono text-xs">@item.Width × @item.Height</td>
                                <td class="px-4 py-2">
                                    <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded-full border @Badge(item.Severity)">
                                        @(item.Severity == "Low" ? "Very low" : "Soft")
                                    </span>
                                </td>
                                <td class="px-4 py-2">
                                    @if (item.InStock)
                                    {
                                        <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">In stock</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-500 border border-neutral-200">Out</span>
                                    }
                                </td>
                                <td class="px-4 py-2 text-right">
                                    <a href="@item.Url" target="_blank" rel="noopener" class="text-xs text-neutral-400 hover:text-neutral-700">Open ↗</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-xs text-neutral-400 mt-3">
                <strong>Very low</strong> (&lt; 600px) is clearly blurry; <strong>Soft</strong> (600–@(minWidth)px) looks
                fuzzy on sharp/phone screens. Re-upload a photo at least ~1200px wide for each, then re-run the scan.
            </p>
        }
    }
    else
    {
        <p class="text-sm text-neutral-400">Set a threshold and hit <strong>Run scan</strong> to check your catalogue.</p>
    }
</div>
