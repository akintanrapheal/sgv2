@using System.Text.Json
@model SterlingLams.Web.Areas.Admin.Controllers.GoogleAnalyticsController.GaPageVm
@{
    ViewData["Title"] = "Google Analytics";
    string J(object o) => JsonSerializer.Serialize(o);
    var r = Model.Result;
    var s = r.Stats;
    string Dur(double secs)
    {
        var t = TimeSpan.FromSeconds(secs);
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m {t.Seconds}s";
    }
    var pills = new[] { (7, "7 days"), (28, "28 days"), (90, "90 days") };
}

<div class="flex items-center justify-between mb-1 gap-3 flex-wrap">
    <h1 class="text-lg font-medium text-neutral-800">Google Analytics</h1>
    <div class="flex items-center gap-1.5">
        @foreach (var (d, lbl) in pills)
        {
            <a asp-action="Index" asp-route-days="@d"
               class="px-3 py-1 text-xs rounded-full border transition-colors @(Model.Days == d ? "border-neutral-800 text-neutral-900" : "border-neutral-200 text-neutral-500 hover:border-neutral-400")">@lbl</a>
        }
    </div>
</div>
<p class="text-xs text-neutral-400 mb-6">
    Live GA4 data via the Google Analytics Data API@(string.IsNullOrEmpty(Model.MeasurementId) ? "" : $" · tag {Model.MeasurementId}").
    Full reports are in <a href="https://analytics.google.com" target="_blank" rel="noopener" class="text-brand-600 hover:underline">Google Analytics</a>.
</p>

@if (!r.Configured)
{
    <div class="bg-white border border-neutral-100 rounded-sm p-8 text-center">
        <div class="mx-auto w-11 h-11 rounded-full bg-amber-50 text-amber-600 grid place-items-center mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        </div>
        <h2 class="text-sm font-medium text-neutral-800">Google Analytics isn't set up yet</h2>
        <p class="text-xs text-neutral-400 mt-1 max-w-md mx-auto">
            @(string.IsNullOrEmpty(r.Error)
                ? "Turn on Google Analytics and add your Measurement ID, GA4 Property ID and a service-account key to see reports here."
                : r.Error)
        </p>
        @if (!string.IsNullOrEmpty(Model.MeasurementId))
        {
            <p class="text-[11px] text-emerald-600 mt-2">The tracking tag (@Model.MeasurementId) is live on the storefront — only the in-console reports need the Property ID + service-account key.</p>
        }
        <a asp-area="Admin" asp-controller="Integrations" asp-action="Index"
           class="inline-block mt-4 px-5 py-2 bg-neutral-900 text-white text-sm rounded-sm hover:bg-neutral-700 transition-colors">Configure in Integrations →</a>
    </div>
}
else if (!string.IsNullOrEmpty(r.Error))
{
    <div class="rounded-sm border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 mb-4">@r.Error</div>
    <div class="text-xs text-neutral-400">Once resolved in <a asp-controller="Integrations" asp-action="Index" class="text-brand-600 hover:underline">Integrations</a>, refresh this page.</div>
}
else if (s != null)
{
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
        <div class="bg-white border border-neutral-100 rounded-sm p-4">
            <p class="text-xs text-neutral-400">Users</p><p class="text-2xl font-light text-neutral-900 mt-1">@s.Users.ToString("N0")</p>
        </div>
        <div class="bg-white border border-neutral-100 rounded-sm p-4">
            <p class="text-xs text-neutral-400">Sessions</p><p class="text-2xl font-light text-neutral-900 mt-1">@s.Sessions.ToString("N0")</p>
        </div>
        <div class="bg-white border border-neutral-100 rounded-sm p-4">
            <p class="text-xs text-neutral-400">Page views</p><p class="text-2xl font-light text-neutral-900 mt-1">@s.PageViews.ToString("N0")</p>
        </div>
        <div class="bg-white border border-neutral-100 rounded-sm p-4">
            <p class="text-xs text-neutral-400">Bounce rate</p><p class="text-2xl font-light text-neutral-900 mt-1">@((s.BounceRate * 100).ToString("0.0"))%</p>
        </div>
        <div class="bg-white border border-neutral-100 rounded-sm p-4">
            <p class="text-xs text-neutral-400">Avg. session</p><p class="text-2xl font-light text-neutral-900 mt-1">@Dur(s.AvgSessionDuration)</p>
        </div>
    </div>

    <div class="mb-6">
        <partial name="_ChartCard" model='new ChartCard { Id = "gaChart", Title = "Users & page views", Subtitle = $"last {Model.Days} days", Height = 90, Empty = !s.DayLabels.Any(), EmptyText = "No data in this range." }' />
    </div>

    <div class="bg-white border border-neutral-100 rounded-sm overflow-hidden">
        <div class="px-4 py-2.5 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500">Top pages</div>
        <table class="w-full text-sm">
            <thead><tr class="text-xs text-neutral-400">
                <th class="px-4 py-2 text-left font-medium">Page</th>
                <th class="px-4 py-2 text-right font-medium">Views</th>
            </tr></thead>
            <tbody class="divide-y divide-neutral-100">
                @if (!s.TopPages.Any()) { <tr><td colspan="2" class="px-4 py-8 text-center text-neutral-400">No page data in this range.</td></tr> }
                @foreach (var pg in s.TopPages)
                {
                    <tr class="hover:bg-neutral-50">
                        <td class="px-4 py-2.5 text-neutral-700 truncate max-w-0 w-full" title="@pg.Path">@pg.Path</td>
                        <td class="px-4 py-2.5 text-right text-neutral-800 whitespace-nowrap">@pg.Views.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-[11px] text-neutral-400 mt-2">Bounce rate and average session duration are GA4's own metrics. Numbers can differ slightly from the first-party Traffic report (different definitions of a visit).</p>
}

@section Scripts {
    <partial name="_ChartScripts" />
    <script>
        @if (s != null && s.DayLabels.Any())
        {
            <text>
            SLCharts.area('gaChart', @Html.Raw(J(s.DayLabels)), [
                { label: 'Users',      data: @Html.Raw(J(s.DayUsers)) },
                { label: 'Page views', data: @Html.Raw(J(s.DayViews)) }
            ]);
            </text>
        }
    </script>
}
