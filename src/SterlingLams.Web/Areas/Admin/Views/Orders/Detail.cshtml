@model SterlingLams.Web.Areas.Admin.ViewModels.AdminOrderDetailViewModel
@{
    ViewData["Title"] = "Order " + Model.Order.OrderNumber;
}

<div class="flex items-center justify-between mb-6">
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
       class="text-xs text-neutral-400 hover:text-neutral-700 transition-colors">← Back to Orders</a>
    <div class="flex items-center gap-2">
        <a asp-area="Admin" asp-controller="Orders" asp-action="Invoice" asp-route-id="@Model.Order.Id" target="_blank"
           class="px-3 py-1.5 text-xs border border-neutral-200 rounded-sm hover:border-neutral-400 transition-colors">🖨 Invoice</a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="PackingSlip" asp-route-id="@Model.Order.Id" target="_blank"
           class="px-3 py-1.5 text-xs border border-neutral-200 rounded-sm hover:border-neutral-400 transition-colors">🖨 Packing slip</a>
        @if (Model.Order.Channel == SterlingLams.Web.Models.Domain.OrderChannel.Online && Model.Order.FulfillmentType == SterlingLams.Web.Models.Domain.FulfillmentType.Delivery)
        {
            <a asp-area="Admin" asp-controller="Orders" asp-action="ShippingLabel" asp-route-id="@Model.Order.Id" target="_blank"
               class="px-3 py-1.5 text-xs border border-neutral-200 rounded-sm hover:border-neutral-400 transition-colors">🏷 Shipping label (4×6)</a>
        }
        <span class="text-xs text-neutral-400 ml-2">@Model.Order.CreatedAt.ToLocalTime().ToString("dddd, dd MMMM yyyy HH:mm")</span>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Order items -->
    <div class="lg:col-span-2 space-y-4">
        <div class="bg-white rounded-sm border border-neutral-100">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-medium">Items</h2>
            </div>
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-neutral-50 border-b border-neutral-100">
                        <th class="text-left px-6 py-2 text-xs text-neutral-400 font-medium">Product</th>
                        <th class="text-left px-6 py-2 text-xs text-neutral-400 font-medium">Variant</th>
                        <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Qty</th>
                        <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Price</th>
                        <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-neutral-50">
                    @foreach (var item in Model.Order.Items)
                    {
                        var sku = !string.IsNullOrWhiteSpace(item.ProductSku) ? item.ProductSku
                            : (item.ProductVariant?.Sku ?? item.Product?.Sku);
                        var imgUrl = item.Product?.Images?
                            .OrderByDescending(i => i.IsPrimary).ThenBy(i => i.SortOrder)
                            .FirstOrDefault()?.Url;
                        var thumb = SterlingLams.Web.Infrastructure.Img.Cld(imgUrl, 80, 80);
                        <tr>
                            <td class="px-6 py-3">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(thumb))
                                    {
                                        <img src="@thumb" alt="@item.ProductName" width="40" height="40"
                                             class="w-10 h-10 rounded object-cover border border-neutral-100 flex-shrink-0" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded bg-neutral-100 flex items-center justify-center flex-shrink-0 text-neutral-300 text-base">◇</div>
                                    }
                                    <div class="min-w-0">
                                        <div class="text-xs font-medium text-neutral-800">@item.ProductName</div>
                                        @if (!string.IsNullOrWhiteSpace(sku))
                                        {
                                            <div class="text-[11px] text-neutral-400">SKU: @sku</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-3 text-xs text-neutral-500">@(item.VariantName ?? "—")</td>
                            <td class="px-6 py-3 text-xs text-right">@item.Quantity</td>
                            <td class="px-6 py-3 text-xs text-right">₦@item.UnitPrice.ToString("N0")</td>
                            <td class="px-6 py-3 text-xs text-right font-medium">₦@item.LineTotal.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="border-t border-neutral-100">
                    <tr><td colspan="4" class="px-6 py-2 text-xs text-right text-neutral-400">Subtotal</td><td class="px-6 py-2 text-xs text-right">₦@Model.Order.Subtotal.ToString("N0")</td></tr>
                    @if (Model.Order.DiscountAmount > 0)
                    {
                        <tr><td colspan="4" class="px-6 py-2 text-xs text-right text-emerald-600">Discount@(string.IsNullOrEmpty(Model.Order.DiscountCode) ? "" : $" ({Model.Order.DiscountCode})")</td><td class="px-6 py-2 text-xs text-right text-emerald-600">-₦@Model.Order.DiscountAmount.ToString("N0")</td></tr>
                    }
                    @if (Model.Order.LoyaltyDiscount > 0)
                    {
                        <tr><td colspan="4" class="px-6 py-2 text-xs text-right text-emerald-600">Loyalty (@Model.Order.LoyaltyPointsRedeemed pts)</td><td class="px-6 py-2 text-xs text-right text-emerald-600">-₦@Model.Order.LoyaltyDiscount.ToString("N0")</td></tr>
                    }
                    <tr><td colspan="4" class="px-6 py-2 text-xs text-right text-neutral-400">Delivery</td><td class="px-6 py-2 text-xs text-right">₦@Model.Order.DeliveryFee.ToString("N0")</td></tr>
                    <tr><td colspan="4" class="px-6 py-2 text-sm text-right font-medium">Total</td><td class="px-6 py-2 text-sm text-right font-medium">₦@Model.Order.Total.ToString("N0")</td></tr>
                </tfoot>
            </table>
        </div>

        <!-- Fulfillment info -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Fulfillment</h2>
            <p class="text-xs text-neutral-600 mb-1"><span class="text-neutral-400">Type:</span> @(Model.Order.Channel == SterlingLams.Web.Models.Domain.OrderChannel.Pos ? "In-store" : Model.Order.FulfillmentType == SterlingLams.Web.Models.Domain.FulfillmentType.StorePickup ? "Store pickup" : Model.Order.FulfillmentType.ToString())</p>
            @if (Model.Order.PickupStore != null)
            {
                <p class="text-xs text-neutral-600"><span class="text-neutral-400">Pickup at:</span> @Model.Order.PickupStore.Name — @Model.Order.PickupStore.Address</p>
            }
            @if (Model.Order.DeliveryAddress != null)
            {
                var a = Model.Order.DeliveryAddress;
                <p class="text-xs text-neutral-600"><span class="text-neutral-400">Deliver to:</span> @a.Line1, @a.City, @a.State</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Order.Notes))
            {
                <div class="mt-3 pt-3 border-t border-neutral-100">
                    <p class="text-[11px] uppercase tracking-wide text-neutral-400 mb-1">Customer note</p>
                    <p class="text-xs text-neutral-700 whitespace-pre-line">@Model.Order.Notes</p>
                </div>
            }
        </div>

        <!-- Refunds -->
        @if (Model.Refunds.Any())
        {
            <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-medium">Refunds</h2>
                    <span class="text-xs text-neutral-500">Total refunded: <span class="font-medium text-rose-600">₦@Model.RefundedTotal.ToString("N0")</span></span>
                </div>
                <div class="space-y-2">
                    @foreach (var r in Model.Refunds)
                    {
                        <div class="border border-neutral-100 rounded-sm px-3 py-2">
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-mono text-neutral-700">@r.RefundNumber</span>
                                <span class="font-medium text-rose-600">₦@r.Amount.ToString("N0")</span>
                            </div>
                            <div class="text-[11px] text-neutral-400 mt-0.5">
                                @r.CreatedAt.ToLocalTime().ToString("dd MMM yy HH:mm") · @r.RefundMethod · @r.Items.Sum(i => i.Quantity) item(s)
                                @if (!string.IsNullOrWhiteSpace(r.Reason)) { <text>· @r.Reason</text> }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Refund form -->
        @if (Model.CanRefund)
        {
            <div class="bg-white rounded-sm border border-neutral-100">
                <div class="px-6 py-4 border-b border-neutral-100">
                    <h2 class="text-sm font-medium">Issue a refund</h2>
                    <p class="text-[11px] text-neutral-400 mt-0.5">Records the refund, optionally returns stock, and attempts the gateway refund.</p>
                </div>
                <form asp-area="Admin" asp-controller="Orders" asp-action="RefundOrder"
                      asp-route-id="@Model.Order.Id" method="post">
                    @Html.AntiForgeryToken()
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-neutral-50 border-b border-neutral-100">
                                <th class="text-left px-6 py-2 text-xs text-neutral-400 font-medium">Item</th>
                                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Ordered</th>
                                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Refunded</th>
                                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Refund qty</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-50">
                            @foreach (var item in Model.Order.Items)
                            {
                                var done = Model.RefundedQty.TryGetValue((item.ProductId, item.ProductVariantId), out var dq) ? dq : 0;
                                var remaining = item.Quantity - done;
                                <tr>
                                    <td class="px-6 py-2 text-xs">
                                        <span class="font-medium text-neutral-800">@item.ProductName</span>
                                        @if (!string.IsNullOrEmpty(item.VariantName)) { <span class="text-neutral-400">— @item.VariantName</span> }
                                    </td>
                                    <td class="px-6 py-2 text-xs text-right">@item.Quantity</td>
                                    <td class="px-6 py-2 text-xs text-right text-neutral-400">@done</td>
                                    <td class="px-6 py-2 text-right">
                                        <input type="hidden" name="itemProductId" value="@item.ProductId" />
                                        <input type="hidden" name="itemVariantId" value="@(item.ProductVariantId ?? 0)" />
                                        <input type="number" name="refundQty" value="0" min="0" max="@remaining"
                                               readonly="@(remaining == 0)"
                                               class="w-16 border border-neutral-200 rounded-sm px-2 py-1 text-xs text-right focus:outline-none focus:border-neutral-400 @(remaining == 0 ? "bg-neutral-50 text-neutral-300" : "")" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="px-6 py-4 border-t border-neutral-100 space-y-3">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" name="restock" value="true" checked id="restock" class="rounded-sm border-neutral-300" />
                            <input type="hidden" name="restock" value="false" />
                            <label for="restock" class="text-xs text-neutral-600">Return refunded items to stock@(Model.RefundStoreId > 0 ? "" : " (no store on order — won't restock)")</label>
                        </div>
                        <div class="flex gap-2">
                            <select name="method" class="border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400">
                                <option value="Paystack">Gateway (Paystack)</option>
                                <option value="Transfer">Bank transfer</option>
                                <option value="Manual">Manual / other</option>
                            </select>
                            <input name="reason" type="text" placeholder="Reason (optional)"
                                   class="flex-1 border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400" />
                        </div>
                        <button type="submit"
                                onclick="return confirm('Process this refund? Stock will be returned if checked and a gateway refund attempted.');"
                                class="w-full py-2 bg-rose-600 text-white text-xs rounded-sm hover:bg-rose-500 transition-colors">
                            Process Refund
                        </button>
                    </div>
                </form>
            </div>
        }

        <!-- Replacements -->
        @if (Model.Replacements.Any())
        {
            <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
                <h2 class="text-sm font-medium mb-3">Replacements</h2>
                <div class="space-y-2">
                    @foreach (var rp in Model.Replacements)
                    {
                        var disp = rp.RestockDecision == SterlingLams.Web.Models.Domain.RestockDecision.Pending
                            ? "<span class=\"text-amber-600\">returned item pending Inventory review</span>"
                            : rp.RestockDecision == SterlingLams.Web.Models.Domain.RestockDecision.Restocked
                                ? $"<span class=\"text-emerald-600\">{rp.RestockedQuantity} restocked</span>"
                                : "<span class=\"text-rose-600\">written off (damaged)</span>";
                        <div class="border border-neutral-100 rounded-sm px-3 py-2 text-xs">
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-neutral-700">@rp.ReplacementNumber</span>
                                <span class="text-[11px] text-neutral-400">@rp.CreatedAt.ToLocalTime().ToString("dd MMM yy HH:mm")</span>
                            </div>
                            <div class="text-neutral-600 mt-0.5">
                                <span class="text-rose-600">@rp.OldProductName@(rp.OldVariantName != null ? $" ({rp.OldVariantName})" : "") ×@rp.OldQuantity</span>
                                <span class="text-neutral-400">→</span>
                                <span class="text-emerald-700">@rp.NewProductName@(rp.NewVariantName != null ? $" ({rp.NewVariantName})" : "") ×@rp.NewQuantity</span>
                            </div>
                            <div class="text-[11px] text-neutral-400 mt-0.5">
                                @Html.Raw(disp)
                                @if (!string.IsNullOrWhiteSpace(rp.Reason)) { <text>· @rp.Reason</text> }
                                @if (rp.BalancePaid > 0) { <text>· balance paid ₦@rp.BalancePaid.ToString("N0")</text> }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Replace an item -->
        @if (Model.CanReplace)
        {
            <div class="bg-white rounded-sm border border-neutral-100">
                <div class="px-6 py-4 border-b border-neutral-100">
                    <h2 class="text-sm font-medium">Replace an item</h2>
                    <p class="text-[11px] text-neutral-400 mt-0.5">Send a different item for one that can't be kept (tarnished / faulty). The replacement's stock is deducted now; the returned item goes to Inventory → Returns for a put-back / write-off decision. No money is refunded.</p>
                </div>
                <form asp-area="Admin" asp-controller="Orders" asp-action="ReplaceItem"
                      asp-route-id="@Model.Order.Id" method="post" id="replace-form"
                      onsubmit="return replaceSubmit();">
                    @Html.AntiForgeryToken()
                    <div class="px-6 py-4 space-y-3">
                        <div>
                            <label class="block text-[11px] text-neutral-500 mb-1">Item being replaced</label>
                            <select name="orderItemId" id="rep-olditem" class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400">
                                @foreach (var item in Model.Order.Items)
                                {
                                    <option value="@item.Id" data-max="@item.Quantity">@item.ProductName@(string.IsNullOrEmpty(item.VariantName) ? "" : $" — {item.VariantName}") (×@item.Quantity)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] text-neutral-500 mb-1">Replacement item (search by name, SKU or barcode)</label>
                            <input type="text" id="rep-search" autocomplete="off" placeholder="Start typing…"
                                   class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400" />
                            <div id="rep-results" class="hidden mt-1 border border-neutral-200 rounded-sm max-h-56 overflow-auto bg-white"></div>
                            <div id="rep-chosen" class="hidden mt-2 text-xs bg-emerald-50 border border-emerald-100 rounded-sm px-3 py-2"></div>
                            <input type="hidden" name="newProductId" id="rep-pid" value="0" />
                            <input type="hidden" name="newVariantId" id="rep-vid" value="0" />
                        </div>
                        <div class="flex gap-2">
                            <div class="w-24">
                                <label class="block text-[11px] text-neutral-500 mb-1">Qty</label>
                                <input type="number" name="newQty" id="rep-qty" value="1" min="1"
                                       class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs text-right focus:outline-none focus:border-neutral-400" />
                            </div>
                            <div class="flex-1">
                                <label class="block text-[11px] text-neutral-500 mb-1">Balance paid (if dearer)</label>
                                <input type="number" name="balancePaid" value="0" min="0" step="0.01"
                                       class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs text-right focus:outline-none focus:border-neutral-400" />
                            </div>
                        </div>
                        <input name="balanceNote" type="text" placeholder="Balance note — how it was collected (optional)"
                               class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400" />
                        <input name="reason" type="text" placeholder="Reason — why the item can't be kept (optional)"
                               class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400" />
                        <div class="pt-1">
                            <label class="block text-[11px] text-neutral-500 mb-1">Returned item — what to do with it</label>
                            <div class="flex flex-col gap-1.5 text-xs text-neutral-700">
                                <label class="inline-flex items-center gap-2"><input type="radio" name="returnDisposition" value="restock" checked /> Put it back in stock (restock now)</label>
                                <label class="inline-flex items-center gap-2"><input type="radio" name="returnDisposition" value="writeoff" /> Write off — damaged (don't restock)</label>
                                <label class="inline-flex items-center gap-2"><input type="radio" name="returnDisposition" value="later" /> Decide later (send to Inventory → Returns)</label>
                            </div>
                        </div>
                        <button type="submit"
                                class="w-full py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-black transition-colors">
                            Raise replacement
                        </button>
                    </div>
                </form>
            </div>
            <script>
                (function () {
                    var searchUrl = '@Url.Action("ReplacementSearch", "Orders", new { area = "Admin", id = Model.Order.Id })';
                    // id is a PATH segment in the admin route (…/Orders/ReplacementSearch/123), so the URL
                    // has no query string — append q with the right separator (? not &) or it binds into id.
                    var qSep = searchUrl.indexOf('?') === -1 ? '?' : '&';
                    var box = document.getElementById('rep-search');
                    var results = document.getElementById('rep-results');
                    var chosen = document.getElementById('rep-chosen');
                    var pidEl = document.getElementById('rep-pid');
                    var vidEl = document.getElementById('rep-vid');
                    var qtyEl = document.getElementById('rep-qty');
                    var chosenStock = 0;
                    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
                    function pick(pid, vid, label, stock) {
                        pidEl.value = pid; vidEl.value = vid || 0; chosenStock = stock;
                        chosen.innerHTML = '<div class="flex items-center justify-between"><span>' + esc(label) + '</span><span class="text-neutral-500">' + stock + ' in stock here</span></div>';
                        chosen.classList.remove('hidden');
                        results.classList.add('hidden'); results.innerHTML = '';
                        box.value = '';
                        qtyEl.max = Math.max(1, stock);
                        if (+qtyEl.value > stock) qtyEl.value = Math.max(1, stock);
                    }
                    var t = null;
                    box.addEventListener('input', function () {
                        clearTimeout(t);
                        var q = box.value.trim();
                        if (q.length < 2) { results.classList.add('hidden'); results.innerHTML = ''; return; }
                        t = setTimeout(function () {
                            fetch(searchUrl + qSep + 'q=' + encodeURIComponent(q)).then(function (r) { return r.json(); }).then(function (items) {
                                if (!items.length) { results.innerHTML = '<p class="px-3 py-2 text-xs text-neutral-400">No products found.</p>'; results.classList.remove('hidden'); return; }
                                var html = '';
                                items.forEach(function (p) {
                                    if (p.isVariable && p.variants && p.variants.length) {
                                        html += '<div class="px-3 pt-2 pb-1 text-[11px] text-neutral-500 font-medium">' + esc(p.name) + (p.sku ? ' · ' + esc(p.sku) : '') + '</div>';
                                        p.variants.forEach(function (v) {
                                            var out = v.stock <= 0;
                                            html += '<button type="button" data-pid="' + p.id + '" data-vid="' + v.id + '" data-label="' + esc(p.name + ' — ' + v.name) + '" data-stock="' + v.stock + '" ' + (out ? 'disabled' : '') + ' class="rep-opt w-full flex items-center justify-between px-5 py-1.5 text-left text-xs hover:bg-neutral-50 ' + (out ? 'opacity-40 cursor-not-allowed' : '') + '"><span>' + esc(v.name) + '</span><span class="' + (out ? 'text-rose-500' : 'text-neutral-400') + '">' + (out ? 'Out of stock' : v.stock + ' here') + '</span></button>';
                                        });
                                    } else {
                                        var out = p.stock <= 0;
                                        html += '<button type="button" data-pid="' + p.id + '" data-vid="0" data-label="' + esc(p.name) + '" data-stock="' + p.stock + '" ' + (out ? 'disabled' : '') + ' class="rep-opt w-full flex items-center justify-between px-3 py-1.5 text-left text-xs hover:bg-neutral-50 ' + (out ? 'opacity-40 cursor-not-allowed' : '') + '"><span>' + esc(p.name) + (p.sku ? ' · ' + esc(p.sku) : '') + '</span><span class="' + (out ? 'text-rose-500' : 'text-neutral-400') + '">' + (out ? 'Out of stock' : p.stock + ' here') + '</span></button>';
                                    }
                                });
                                results.innerHTML = html;
                                results.classList.remove('hidden');
                                results.querySelectorAll('.rep-opt').forEach(function (b) {
                                    b.addEventListener('click', function () { pick(+b.dataset.pid, +b.dataset.vid, b.dataset.label, +b.dataset.stock); });
                                });
                            }).catch(function () { results.innerHTML = '<p class="px-3 py-2 text-xs text-rose-500">Search failed.</p>'; results.classList.remove('hidden'); });
                        }, 250);
                    });
                    window.replaceSubmit = function () {
                        if (+pidEl.value <= 0) { alert('Pick a replacement item first.'); return false; }
                        if (+qtyEl.value <= 0) { alert('Enter a quantity.'); return false; }
                        if (chosenStock > 0 && +qtyEl.value > chosenStock) { alert('Only ' + chosenStock + ' in stock at this branch.'); return false; }
                        var disp = (document.querySelector('input[name="returnDisposition"]:checked') || {}).value || 'restock';
                        var fate = disp === 'writeoff' ? 'written off as damaged (not restocked)'
                                 : disp === 'later' ? 'sent to Inventory → Returns to decide later'
                                 : 'put back in stock (restocked now)';
                        return confirm('Raise this replacement?\n\nThe new item\'s stock is deducted now, and the returned item will be ' + fate + '.');
                    };
                })();
            </script>
        }
    </div>

    <!-- Sidebar -->
    <div class="space-y-4">

        <!-- Customer -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Customer</h2>
            <p class="text-xs font-medium text-neutral-800">@Model.CustomerName</p>
            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
            {
                <p class="text-xs text-neutral-500">@Model.CustomerEmail</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
            {
                <p class="text-xs text-neutral-500">@Model.CustomerPhone</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CashierName))
            {
                <p class="text-[11px] text-neutral-400 mt-2 pt-2 border-t border-neutral-100">Served by <span class="text-neutral-600">@Model.CashierName</span></p>
            }
        </div>

        <!-- Resend email -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Resend email</h2>
            <div class="flex flex-wrap gap-2">
                <form asp-area="Admin" asp-controller="Orders" asp-action="ResendEmail" asp-route-id="@Model.Order.Id" method="post">
                    <input type="hidden" name="type" value="summary" />
                    <button type="submit" class="px-3 py-1.5 text-xs border border-neutral-200 rounded-sm hover:border-neutral-400 transition-colors">Order summary</button>
                </form>
                @if (Model.Order.FulfillmentType == SterlingLams.Web.Models.Domain.FulfillmentType.StorePickup)
                {
                    <form asp-area="Admin" asp-controller="Orders" asp-action="ResendEmail" asp-route-id="@Model.Order.Id" method="post">
                        <input type="hidden" name="type" value="pickup" />
                        <button type="submit" class="px-3 py-1.5 text-xs border border-neutral-200 rounded-sm hover:border-neutral-400 transition-colors">Pickup pass (QR)</button>
                    </form>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
            {
                <p class="text-[11px] text-neutral-400 mt-2">Sends to @Model.CustomerEmail</p>
            }
        </div>

        <!-- Internal new-order alert -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Staff alert</h2>
            <form asp-area="Admin" asp-controller="Orders" asp-action="SendNewOrderAlert" asp-route-id="@Model.Order.Id" method="post">
                <button type="submit" class="px-3 py-1.5 text-xs border border-neutral-200 rounded-sm hover:border-neutral-400 transition-colors">Send new-order alert</button>
            </form>
            <p class="text-[11px] text-neutral-400 mt-2">Notifies the orders inbox (Settings → Notifications). Use for orders taken manually. Manually-confirmed orders fire this automatically.</p>
        </div>

        <!-- Customer history -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Customer history</h2>
            <div class="space-y-2">
                <div>
                    <p class="text-[11px] text-neutral-400">Total orders</p>
                    <p class="text-sm text-neutral-800">@Model.CustomerTotalOrders</p>
                </div>
                <div>
                    <p class="text-[11px] text-neutral-400">Total revenue <span class="text-neutral-300">(paid)</span></p>
                    <p class="text-sm text-neutral-800">₦@Model.CustomerTotalRevenue.ToString("N2")</p>
                </div>
                <div>
                    <p class="text-[11px] text-neutral-400">Average order value</p>
                    <p class="text-sm text-neutral-800">₦@Model.CustomerAvgOrderValue.ToString("N2")</p>
                </div>
            </div>
        </div>

        <!-- Order attribution -->
        @if (Model.Order.Channel == SterlingLams.Web.Models.Domain.OrderChannel.Online
             && (Model.Order.Origin != null || Model.Order.DeviceType != null || Model.Order.CustomerIp != null || Model.Order.SessionPageViews != null))
        {
            <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
                <h2 class="text-sm font-medium mb-3">Order attribution</h2>
                <div class="space-y-2">
                    <div>
                        <p class="text-[11px] text-neutral-400">Origin</p>
                        <p class="text-sm text-neutral-800">@(Model.Order.Origin ?? "—")</p>
                    </div>
                    <div>
                        <p class="text-[11px] text-neutral-400">Device type</p>
                        <p class="text-sm text-neutral-800">@(Model.Order.DeviceType ?? "—")</p>
                    </div>
                    <div>
                        <p class="text-[11px] text-neutral-400">Session page views</p>
                        <p class="text-sm text-neutral-800">@(Model.Order.SessionPageViews?.ToString() ?? "—")</p>
                    </div>
                    <div>
                        <p class="text-[11px] text-neutral-400">Customer IP</p>
                        <p class="text-sm text-neutral-800 font-mono text-xs">@(Model.Order.CustomerIp ?? "—")</p>
                    </div>
                </div>
            </div>
        }

        <!-- Payment -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Payment</h2>
            <div class="space-y-1">
                <p class="text-xs"><span class="text-neutral-400">Status:</span>
                    @if (Model.Order.IsPaid)
                    {
                        <span class="text-emerald-600 font-medium">Paid</span>
                    }
                    else
                    {
                        <span class="text-amber-600 font-medium">Unpaid</span>
                    }
                </p>
                @if (Model.Order.PaymentReference != null)
                {
                    <p class="text-xs"><span class="text-neutral-400">Ref:</span> <code class="font-mono text-[10px]">@Model.Order.PaymentReference</code></p>
                }
                @if (Model.Order.PaidAt.HasValue)
                {
                    <p class="text-xs"><span class="text-neutral-400">Paid at:</span> @Model.Order.PaidAt.Value.ToLocalTime().ToString("dd MMM yy HH:mm")</p>
                }
            </div>
        </div>

        <!-- Update Status -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-1">Update Status</h2>
            @{
                var isPosOrder = Model.Order.Channel == SterlingLams.Web.Models.Domain.OrderChannel.Pos;
                var statusText = (isPosOrder && (Model.Order.Status == SterlingLams.Web.Models.Domain.OrderStatus.Delivered || Model.Order.Status == SterlingLams.Web.Models.Domain.OrderStatus.Collected))
                    ? "Paid & collected" : Model.Order.Status.ToString();
            }
            <p class="text-xs text-neutral-500 mb-3">Current:
                <span class="font-medium @(Model.Order.Status == SterlingLams.Web.Models.Domain.OrderStatus.Refunded ? "text-rose-600" : "text-neutral-800")">@statusText</span>
            </p>
            <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus"
                  asp-route-id="@Model.Order.Id" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <select name="status" id="status-select"
                        class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400">
                    @foreach (var s in Model.AvailableStatuses)
                    {
                        <option value="@s" selected="@(Model.Order.Status.ToString() == s)">@s</option>
                    }
                </select>

                @* Confirming an UNPAID order records the money — capture how the customer paid and why,
                   so it's on record and distinct from a Paystack auto-confirm. *@
                @if (!Model.Order.IsPaid)
                {
                    <div id="manual-pay-block" class="hidden space-y-2 rounded-sm border border-amber-200 bg-amber-50 p-3">
                        <p class="text-[11px] text-amber-700 leading-snug">This order is <span class="font-medium">unpaid</span>. Confirming records the payment as received — choose how the customer paid and add a reason.</p>
                        <div>
                            <label class="block text-[11px] text-neutral-500 mb-1">Payment channel</label>
                            <select name="paymentMethod" id="manual-pay-method"
                                    class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs bg-white focus:outline-none focus:border-neutral-400">
                                <option value="">Select channel…</option>
                                <option value="Cash">Cash</option>
                                <option value="Transfer">Bank transfer</option>
                                <option value="Card">Card / EPOS terminal</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] text-neutral-500 mb-1">Reason</label>
                            <input type="text" name="confirmReason" id="manual-pay-reason"
                                   placeholder="e.g. Paid by transfer, ref 8842 / Paid cash on pickup"
                                   class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400" />
                        </div>
                    </div>
                }

                <button type="submit"
                        class="w-full py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-neutral-700 transition-colors">
                    Update Status
                </button>
            </form>
            @if (!Model.Order.IsPaid)
            {
                <script>
                    (function () {
                        var sel = document.getElementById('status-select');
                        var block = document.getElementById('manual-pay-block');
                        var method = document.getElementById('manual-pay-method');
                        var reason = document.getElementById('manual-pay-reason');
                        if (!sel || !block) return;
                        function sync() {
                            var show = sel.value === 'Confirmed';
                            block.classList.toggle('hidden', !show);
                            if (method) method.required = show;
                            if (reason) reason.required = show;
                        }
                        sel.addEventListener('change', sync);
                        sync();
                    })();
                </script>
            }
        </div>

        <!-- Order notes (timeline) -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Order notes</h2>

            <!-- Add note -->
            <form asp-area="Admin" asp-controller="Orders" asp-action="AddNote"
                  asp-route-id="@Model.Order.Id" method="post" class="space-y-2 mb-4">
                @Html.AntiForgeryToken()
                <textarea name="content" rows="3" required
                          placeholder="Add a note…"
                          class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400 resize-none"></textarea>
                <div class="flex gap-2">
                    <select name="noteType"
                            class="flex-1 border border-neutral-200 rounded-sm px-2 py-2 text-xs bg-white focus:outline-none focus:border-neutral-400">
                        <option value="private">Private note</option>
                        <option value="customer">Note to customer</option>
                    </select>
                    <button type="submit"
                            class="px-4 py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-neutral-700 transition-colors">
                        Add
                    </button>
                </div>
            </form>

            <!-- Notes list (newest first) -->
            <div class="space-y-2 max-h-96 overflow-auto">
                @if (!Model.Notes.Any())
                {
                    <p class="text-xs text-neutral-400">No notes yet.</p>
                }
                @foreach (var n in Model.Notes)
                {
                    var tone = n.IsCustomerNote ? "bg-blue-50 border-blue-100"
                             : n.IsSystem ? "bg-neutral-50 border-neutral-100"
                             : "bg-purple-50 border-purple-100";
                    var kind = n.IsSystem ? "" : n.IsCustomerNote ? "Note to customer" : "Private note";
                    <div class="border rounded-sm p-3 @tone">
                        <p class="text-xs text-neutral-700 whitespace-pre-line">@n.Content</p>
                        <div class="flex items-center justify-between mt-2 text-[11px] text-neutral-400">
                            <span>
                                @n.CreatedAt.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")
                                @if (!string.IsNullOrEmpty(kind)) { <text> · @kind</text> }
                                @if (!string.IsNullOrEmpty(n.AuthorName)) { <text> · @n.AuthorName</text> }
                            </span>
                            <form asp-area="Admin" asp-controller="Orders" asp-action="DeleteNote"
                                  asp-route-id="@Model.Order.Id" method="post"
                                  onsubmit="return confirm('Delete this note?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="noteId" value="@n.Id" />
                                <button type="submit" class="text-rose-400 hover:text-rose-600">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tracking Number -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Tracking</h2>
            @if (!string.IsNullOrEmpty(Model.Order.TrackingNumber))
            {
                <p class="text-xs font-mono text-emerald-700 mb-2">@Model.Order.TrackingNumber</p>
            }
            <form asp-area="Admin" asp-controller="Orders" asp-action="SaveTracking"
                  asp-route-id="@Model.Order.Id" method="post" class="flex gap-2">
                @Html.AntiForgeryToken()
                <input name="trackingNumber" type="text" value="@Model.Order.TrackingNumber"
                       placeholder="Enter tracking number…"
                       class="flex-1 border border-neutral-200 rounded-sm px-3 py-1.5 text-xs focus:outline-none focus:border-neutral-400" />
                <button type="submit"
                        class="px-3 py-1.5 bg-neutral-900 text-white text-xs rounded-sm hover:bg-neutral-700 transition-colors">
                    Save
                </button>
            </form>
        </div>

        <!-- Admin Notes -->
        <div class="bg-white rounded-sm border border-neutral-100 px-6 py-4">
            <h2 class="text-sm font-medium mb-3">Internal Notes</h2>
            <form asp-area="Admin" asp-controller="Orders" asp-action="SaveNote"
                  asp-route-id="@Model.Order.Id" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <textarea name="adminNotes" rows="4"
                          placeholder="Add internal notes (not visible to customer)…"
                          class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-xs focus:outline-none focus:border-neutral-400 resize-none">@Model.Order.AdminNotes</textarea>
                <button type="submit"
                        class="w-full py-2 bg-neutral-100 text-neutral-700 text-xs rounded-sm hover:bg-neutral-200 transition-colors">
                    Save Note
                </button>
            </form>
        </div>
    </div>
</div>
