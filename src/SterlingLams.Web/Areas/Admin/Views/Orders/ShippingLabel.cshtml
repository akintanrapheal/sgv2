@model SterlingLams.Web.Models.Domain.Order
@inject SterlingLams.Web.Services.ISettingsService Settings
@{
    Layout = null;
    // Logo: the receipt override → the site logo → the built-in logo (same chain as receipts).
    var logoUrl = await Settings.GetAsync("pos.receipt_logo_url", "");
    if (string.IsNullOrWhiteSpace(logoUrl)) logoUrl = await Settings.GetAsync("general.logo_url", "");
    if (string.IsNullOrWhiteSpace(logoUrl)) logoUrl = "/images/sg-logo.png";
    var siteName = await Settings.GetAsync("general.site_name", "Sterlin Glams");

    string E(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    var a = Model.DeliveryAddress;
    var buyer = Model.Channel == SterlingLams.Web.Models.Domain.OrderChannel.Pos ? Model.Customer : Model.User;
    var toName  = !string.IsNullOrWhiteSpace(Model.ContactName) ? Model.ContactName
                : (!string.IsNullOrWhiteSpace(a?.FullName) ? a!.FullName : buyer?.FullName ?? "Customer");
    var toPhone = !string.IsNullOrWhiteSpace(Model.ContactPhone) ? Model.ContactPhone
                : (!string.IsNullOrWhiteSpace(a?.Phone) ? a!.Phone : buyer?.PhoneNumber);

    var fromStore = Model.FulfillingStore;
    var fromName = fromStore != null ? fromStore.Name : siteName;
    var fromAddr = fromStore != null
        ? string.Join(", ", new[] { fromStore.Address, $"{fromStore.City}, {fromStore.State}".Trim(' ', ',') }.Where(x => !string.IsNullOrWhiteSpace(x)))
        : await Settings.GetAsync("pos.receipt_address", "");
    var fromPhone = fromStore?.Phone;
    if (string.IsNullOrWhiteSpace(fromPhone)) fromPhone = await Settings.GetAsync("pos.receipt_phone", "");

    var deliveryLabel = (Model.DeliveryType ?? "").ToLowerInvariant() switch
    {
        "sameday" => "Glams Same-Day Delivery",
        "express" => "Glams Priority Delivery",
        "standard" => "Glams Standard Delivery",
        _ => Model.FulfillmentType == SterlingLams.Web.Models.Domain.FulfillmentType.StorePickup ? "Store Pickup" : "Delivery"
    };
    var itemCount = Model.Items?.Sum(i => i.Quantity) ?? 0;
    var isPickup = Model.FulfillmentType == SterlingLams.Web.Models.Domain.FulfillmentType.StorePickup;

    string toAddrHtml;
    if (!isPickup && a != null)
        toAddrHtml = E(a.Line1) + (string.IsNullOrWhiteSpace(a.Line2) ? "" : ", " + E(a.Line2))
                   + "<br/>" + E($"{a.City}, {a.State}".Trim(' ', ',')) + (string.IsNullOrWhiteSpace(a.PostalCode) ? "" : " " + E(a.PostalCode))
                   + "<br/>" + E(a.Country);
    else if (isPickup && Model.PickupStore != null)
        toAddrHtml = "Store pickup — " + E(Model.PickupStore.Name) + "<br/>" + E(Model.PickupStore.Address);
    else
        toAddrHtml = "—";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Label @Model.OrderNumber</title>
    <style>
        @@page { size: 6in 4in; margin: 0; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        /* 4mm safe padding on all four sides so the printer's non-printable edge never clips the border. */
        body { width: 6in; height: 4in; padding: 4mm; font-family: Arial, Helvetica, sans-serif; color: #000; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .lbl { width: 100%; height: 100%; border: 2px solid #000; display: flex; flex-direction: column; overflow: hidden; }
        .r { display: flex; }
        /* Header: logo + brief return | FRAGILE */
        .hd { border-bottom: 2px solid #000; }
        .hd .brand { flex: 1; display: flex; gap: 8px; padding: 6px 8px; align-items: center; min-width: 0; }
        .hd .brand img { max-width: 36mm; max-height: 18mm; height: auto; width: auto; object-fit: contain; }
        .hd .ret { font-size: 8.5px; line-height: 1.25; color: #000; min-width: 0; }
        .hd .ret b { font-size: 9.5px; }
        .hd .frag { width: 2.5in; border-left: 2px solid #000; padding: 6px 8px; text-align: center; display: flex; flex-direction: column; justify-content: center; }
        .hd .frag .big { font-size: 22px; font-weight: 800; letter-spacing: 1px; line-height: 1; }
        .hd .frag .sm { font-size: 8.5px; letter-spacing: 2px; text-transform: uppercase; margin-top: 2px; }
        /* Service band */
        .band { border-bottom: 2px solid #000; align-items: center; }
        .band .svc { flex: 1; padding: 5px 8px; font-size: 17px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; line-height: 1; }
        .band .date { border-left: 1px solid #000; padding: 5px 8px; font-size: 10px; white-space: nowrap; }
        /* From / To */
        .body { flex: 1; min-height: 0; }
        .col { padding: 7px 9px; font-size: 11px; line-height: 1.35; }
        .col.from { width: 2.3in; border-right: 2px solid #000; }
        .col.to { flex: 1; min-width: 0; }
        .ttl { font-size: 11px; font-weight: 800; margin-bottom: 3px; }
        .fld { display: flex; gap: 4px; margin-bottom: 1px; }
        .fld .k { width: 48px; color: #000; flex: 0 0 auto; }
        .to .name { font-size: 17px; font-weight: 800; line-height: 1.1; margin: 1px 0 3px; }
        .to .addr { font-size: 12.5px; font-weight: 600; line-height: 1.3; }
        .to .ph { font-size: 12.5px; font-weight: 700; margin-top: 2px; }
        .add { margin-top: 5px; padding-top: 4px; border-top: 1px dashed #000; font-size: 10px; }
        .add .h { font-weight: 800; }
        .add .note { white-space: pre-line; word-break: break-word; }
        /* Footer: order no + sign | QR */
        .ft { border-top: 2px solid #000; align-items: stretch; }
        .ft .left { flex: 1; padding: 6px 9px; min-width: 0; }
        .ft .ord .k { font-size: 9px; letter-spacing: 1px; text-transform: uppercase; font-weight: 700; }
        .ft .ord .v { font-size: 16px; font-weight: 800; letter-spacing: 0.5px; }
        .ft .sign { display: flex; gap: 12px; margin-top: 6px; }
        .ft .sign .c { flex: 1; }
        .ft .sign .k { font-size: 8px; letter-spacing: 1px; text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 7px; }
        .ft .sign .v { border-top: 1px solid #000; padding-top: 1px; font-size: 11px; font-weight: 600; min-height: 12px; }
        .ft .qr { width: 1in; border-left: 2px solid #000; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3px; }
        .ft .qr img { width: 0.82in; height: 0.82in; display: block; }
        .ft .qr span { font-size: 7px; letter-spacing: 1px; margin-top: 1px; }
    </style>
</head>
<body onload="setTimeout(function(){ window.print(); }, 150)">
    <div class="lbl">
        <div class="r hd">
            <div class="brand">
                @* Logo only here — the full sender address lives in the "From:" block below (no duplication). *@
                <img src="@logoUrl" alt="@E(siteName)" onerror="this.style.display='none'" />
            </div>
            <div class="frag">
                <div class="big">FRAGILE</div>
                <div class="sm">Please handle with care</div>
            </div>
        </div>

        <div class="r band">
            <div class="svc">@deliveryLabel</div>
            <div class="date">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
        </div>

        <div class="r body">
            <div class="col from">
                <div class="ttl">From:</div>
                <div class="fld"><span class="k">Name</span><span>@E(fromName)</span></div>
                @if (!string.IsNullOrWhiteSpace(fromAddr)) { <div class="fld"><span class="k">Address</span><span>@E(fromAddr)</span></div> }
                @if (!string.IsNullOrWhiteSpace(fromPhone)) { <div class="fld"><span class="k">Phone</span><span>@E(fromPhone)</span></div> }
            </div>
            <div class="col to">
                <div class="ttl">To:</div>
                <div class="name">@E(toName)</div>
                <div class="addr">@Html.Raw(toAddrHtml)</div>
                @if (!string.IsNullOrWhiteSpace(toPhone)) { <div class="ph">☎ @E(toPhone)</div> }
                <div class="add">
                    <span class="h">Additional information:</span>
                    Items: @itemCount@(Model.Channel == SterlingLams.Web.Models.Domain.OrderChannel.Pos ? " · In-store" : " · Website order")
                    <div class="note">Note: @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : E(Model.Notes))</div>
                </div>
            </div>
        </div>

        <div class="r ft">
            <div class="left">
                <div class="ord"><span class="k">Order number</span><br /><span class="v">@Model.OrderNumber</span></div>
                <div class="sign">
                    <div class="c"><span class="k">Packed by</span><span class="v">@(string.IsNullOrWhiteSpace(Model.PackedByName) ? "" : E(Model.PackedByName))</span></div>
                    <div class="c"><span class="k">Signed off by</span><span class="v">&nbsp;</span></div>
                </div>
            </div>
            @if (ViewBag.QrDataUri != null)
            {
                <div class="qr"><img src="@ViewBag.QrDataUri" alt="@Model.OrderNumber" /><span>SCAN</span></div>
            }
        </div>
    </div>
</body>
</html>
