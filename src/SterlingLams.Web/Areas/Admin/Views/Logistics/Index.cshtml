@model SterlingLams.Web.Areas.Admin.Controllers.LogisticsController.PageVm
@{
    ViewData["Title"] = "Logistics";
    var tab = Model.Tab;
    (string key, string label, int count)[] tabs =
    {
        ("dispatch",  "To dispatch",     Model.DispatchCount),
        ("out",       "Out for delivery",Model.OutCount),
        ("delivered", "Delivered",       Model.DeliveredCount),
        ("pickup",    "Pickups",         Model.PickupCount),
    };
    string Local(DateTime? d) => d.HasValue ? d.Value.ToLocalTime().ToString("dd MMM, h:mm tt") : "—";
}

<div class="mb-5">
    <h1 class="text-xl font-semibold text-neutral-900">Logistics</h1>
    <p class="text-sm text-neutral-500 mt-1">Delivery &amp; pickup orders from the website. In-store POS sales are not shown here. Branches pack at the till; dispatch and delivery are managed from here.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-4 text-sm text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-lg px-4 py-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 text-sm text-red-700 bg-red-50 border border-red-100 rounded-lg px-4 py-3">@TempData["Error"]</div>
}

<div class="flex flex-wrap gap-2 mb-5">
    @foreach (var (key, label, count) in tabs)
    {
        var active = tab == key;
        <a asp-action="Index" asp-route-tab="@key"
           class="inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-medium transition @(active ? "border-neutral-900 bg-neutral-900 text-white" : "border-neutral-200 text-neutral-600 hover:border-neutral-400")">
            @label
            <span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full text-[11px] @(active ? "bg-white/20" : "bg-neutral-100 text-neutral-600")">@count</span>
        </a>
    }
</div>

<div class="bg-white border border-neutral-100 rounded-sm overflow-x-auto">
    <table class="w-full text-sm min-w-[760px]">
        <thead>
            <tr class="bg-neutral-50 border-b border-neutral-100 text-xs text-neutral-400">
                <th class="text-left px-4 py-3 font-medium">Order</th>
                <th class="text-left px-4 py-3 font-medium">Customer</th>
                <th class="text-left px-4 py-3 font-medium">Destination</th>
                <th class="text-left px-4 py-3 font-medium">Branch</th>
                <th class="text-left px-4 py-3 font-medium">Packed</th>
                <th class="text-left px-4 py-3 font-medium">Status</th>
                <th class="text-right px-4 py-3 font-medium">Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-neutral-50">
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="7" class="px-4 py-12 text-center text-sm text-neutral-400">Nothing here right now.</td></tr>
            }
            @foreach (var r in Model.Rows)
            {
                <tr class="hover:bg-neutral-50 align-top">
                    <td class="px-4 py-3">
                        <a asp-controller="Orders" asp-action="Detail" asp-route-id="@r.Id" class="text-emerald-700 hover:underline font-medium">@r.OrderNumber</a>
                        <div class="text-[11px] text-neutral-400">@r.CreatedAt.ToLocalTime().ToString("dd MMM") · @r.ItemCount item(s) · ₦@r.Total.ToString("N0")</div>
                    </td>
                    <td class="px-4 py-3">
                        <div class="text-neutral-800">@(string.IsNullOrWhiteSpace(r.Customer) ? "—" : r.Customer)</div>
                        @if (!string.IsNullOrWhiteSpace(r.Phone))
                        {
                            <a href="tel:@r.Phone" class="text-[11px] text-neutral-400 hover:text-neutral-700">@r.Phone</a>
                        }
                    </td>
                    <td class="px-4 py-3">
                        <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full @(r.IsDelivery ? "bg-blue-50 text-blue-700" : "bg-violet-50 text-violet-700")">@(r.IsDelivery ? "Delivery" : "Pickup")</span>
                        <div class="text-neutral-600 mt-1">@(string.IsNullOrWhiteSpace(r.Place) ? "—" : r.Place)</div>
                        @if (r.IsDelivery && !string.IsNullOrWhiteSpace(r.DeliveryType))
                        {
                            <div class="text-[11px] text-neutral-400">@r.DeliveryType</div>
                        }
                    </td>
                    <td class="px-4 py-3 text-neutral-600">@(string.IsNullOrWhiteSpace(r.Branch) ? "—" : r.Branch)</td>
                    <td class="px-4 py-3">
                        <div class="text-neutral-700">@Local(r.PackedAt)</div>
                        <div class="text-[11px] text-neutral-400">@(string.IsNullOrWhiteSpace(r.PackedBy) ? (r.PackedAt == null ? "not packed" : "") : "by " + r.PackedBy)</div>
                    </td>
                    <td class="px-4 py-3"><span class="text-xs text-neutral-600">@r.Status</span></td>
                    <td class="px-4 py-3 text-right">
                        @if (tab == "dispatch")
                        {
                            <form asp-action="Dispatch" asp-route-tab="dispatch" method="post" class="inline"
                                  onsubmit="return confirm('Mark @r.OrderNumber out for delivery? The customer will be emailed that it&#39;s on its way.');">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="px-3 py-1.5 text-xs rounded-sm bg-neutral-900 text-white hover:bg-black transition-colors">Out for delivery</button>
                            </form>
                        }
                        else if (tab == "out")
                        {
                            <form asp-action="MarkDelivered" asp-route-tab="out" method="post" class="inline"
                                  onsubmit="return confirm('Mark @r.OrderNumber delivered?');">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="px-3 py-1.5 text-xs rounded-sm border border-emerald-300 text-emerald-700 hover:bg-emerald-50 transition-colors">Mark delivered</button>
                            </form>
                        }
                        else if (tab == "pickup")
                        {
                            @if (!r.PickupNotified)
                            {
                                <form asp-action="NotifyPickup" asp-route-tab="pickup" method="post" class="inline"
                                      onsubmit="return confirm('Email @r.OrderNumber the pickup-ready pass?');">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="px-3 py-1.5 text-xs rounded-sm bg-neutral-900 text-white hover:bg-black transition-colors">Notify ready</button>
                                </form>
                            }
                            else if (r.Status != "Collected")
                            {
                                <form asp-action="MarkCollected" asp-route-tab="pickup" method="post" class="inline"
                                      onsubmit="return confirm('Mark @r.OrderNumber collected?');">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="px-3 py-1.5 text-xs rounded-sm border border-violet-300 text-violet-700 hover:bg-violet-50 transition-colors">Mark collected</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-[11px] text-neutral-400">Collected</span>
                            }
                        }
                        else
                        {
                            <a asp-controller="Orders" asp-action="Detail" asp-route-id="@r.Id" class="text-xs text-neutral-500 hover:text-neutral-900">View →</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
