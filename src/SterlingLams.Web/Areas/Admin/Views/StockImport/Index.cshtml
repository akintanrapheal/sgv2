@{
    ViewData["Title"] = "Import stock";
}

@Html.AntiForgeryToken()

<div class="max-w-3xl">
    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-xl font-semibold text-neutral-900">Import stock (EposNow)</h1>
            <p class="text-sm text-neutral-500 mt-1 max-w-2xl">
                Upload a CSV to <strong>overwrite</strong> on-hand quantities per store from your EposNow counts.
                Each row is matched by <strong>Barcode</strong> (preferred) or <strong>SKU</strong>, and each
                store column sets that branch's on-hand to the number you enter. Every change is recorded in
                stock history as an adjustment. <strong>Preview first</strong> — nothing changes until you click Apply.
            </p>
        </div>
        <a asp-area="Admin" asp-controller="StockImport" asp-action="Template"
           class="px-4 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500 whitespace-nowrap">↓ Download template</a>
    </div>

    <div class="bg-white border border-neutral-200 rounded-md p-5 mt-6">
        <label class="block text-xs text-neutral-500 mb-1">Stock CSV (columns: Sku, Barcode, then one per store)</label>
        <input id="si-file" type="file" accept=".csv,text/csv"
               class="block w-full text-sm text-neutral-700 file:mr-3 file:py-2 file:px-4 file:rounded-sm file:border-0 file:bg-neutral-900 file:text-white file:text-xs file:cursor-pointer border border-neutral-200 rounded-sm" />
        <div class="flex items-center gap-2 mt-4">
            <button type="button" id="si-preview" class="px-5 py-2 border border-neutral-300 text-neutral-700 text-sm rounded-md hover:border-neutral-500">Preview</button>
            <button type="button" id="si-apply" class="px-6 py-2 bg-neutral-900 text-white text-sm font-medium rounded-md hover:bg-black disabled:opacity-40 disabled:cursor-not-allowed" disabled>Apply — overwrite stock</button>
            <span id="si-status" class="text-sm text-neutral-500"></span>
        </div>
    </div>

    <div id="si-results" class="hidden mt-6"></div>
</div>

@section Scripts {
<script>
(function () {
    var fileEl = document.getElementById('si-file');
    var previewBtn = document.getElementById('si-preview');
    var applyBtn = document.getElementById('si-apply');
    var statusEl = document.getElementById('si-status');
    var results = document.getElementById('si-results');
    var token = document.querySelector('input[name="__RequestVerificationToken"]');
    var base = (window.__adminBase || '') + '/StockImport/';
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };

    fileEl.addEventListener('change', function () { applyBtn.disabled = true; results.classList.add('hidden'); statusEl.textContent = ''; });

    function stat(label, val, tone) {
        return '<div class="border border-neutral-200 rounded-md px-3 py-2">'
            + '<div class="text-xl font-semibold ' + (tone || 'text-neutral-900') + '">' + val + '</div>'
            + '<div class="text-[11px] uppercase tracking-wide text-neutral-400">' + label + '</div></div>';
    }

    function render(d) {
        var grid = '<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">'
            + stat('Rows in file', d.totalRows)
            + stat('Matched', d.matched, 'text-emerald-600')
            + stat('Unmatched', d.unmatched, d.unmatched ? 'text-amber-600' : 'text-neutral-900')
            + stat(d.applied ? 'Quantities changed' : 'Quantities provided', d.applied ? d.changesApplied : d.cellsWithQty)
            + '</div>';

        var cols = '<p class="text-xs text-neutral-500 mt-4">Store columns used: <strong>' + (d.storeColumns.join(', ') || '—') + '</strong>'
            + (d.ignoredColumns && d.ignoredColumns.length ? ' · Ignored columns: ' + esc(d.ignoredColumns.join(', ')) : '') + '</p>';

        var unmatched = '';
        if (d.unmatchedSamples && d.unmatchedSamples.length) {
            unmatched = '<div class="mt-4 text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-md p-3">'
                + '<strong>' + d.unmatched + ' row(s) matched no product</strong> (by barcode or SKU) and were skipped:<br>'
                + d.unmatchedSamples.map(esc).join('<br>') + (d.unmatched > d.unmatchedSamples.length ? '<br>…' : '') + '</div>';
        }

        var sample = '';
        if (d.samples && d.samples.length) {
            sample = '<h3 class="text-sm font-semibold text-neutral-700 mt-6 mb-2">Sample (' + (d.applied ? 'applied' : 'to apply') + ')</h3>'
                + '<div class="overflow-x-auto"><table class="w-full text-sm border border-neutral-200 rounded-md">'
                + '<thead><tr class="bg-neutral-50 text-left text-xs uppercase tracking-wide text-neutral-500">'
                + '<th class="px-3 py-2">Product</th><th class="px-3 py-2">SKU / Barcode</th><th class="px-3 py-2">Quantities</th></tr></thead><tbody>'
                + d.samples.map(function (s) {
                    var q = (s.stores || []).map(function (x) { return esc(x.store) + ': ' + x.qty; }).join(' · ');
                    return '<tr class="border-t border-neutral-100"><td class="px-3 py-2">' + esc(s.name) + '</td>'
                        + '<td class="px-3 py-2 text-neutral-500">' + esc(s.sku || '—') + ' / ' + esc(s.barcode || '—') + '</td>'
                        + '<td class="px-3 py-2">' + q + '</td></tr>';
                }).join('') + '</tbody></table></div>';
        }
        results.innerHTML = grid + cols + unmatched + sample;
        results.classList.remove('hidden');
    }

    function run(url, applying) {
        if (!fileEl.files || !fileEl.files.length) { statusEl.textContent = 'Choose a CSV file first.'; return; }
        var fd = new FormData();
        fd.append('file', fileEl.files[0]);
        fd.append('__RequestVerificationToken', token ? token.value : '');
        statusEl.textContent = applying ? 'Applying… (this can take a minute)' : 'Reading…';
        previewBtn.disabled = true; applyBtn.disabled = true;
        fetch(url, { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token ? token.value : '' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                previewBtn.disabled = false;
                if (!d.ok) { statusEl.textContent = d.error || 'Failed.'; return; }
                render(d);
                if (applying) {
                    statusEl.textContent = 'Done — ' + d.changesApplied + ' quantity change(s) applied.';
                    applyBtn.disabled = true;
                } else {
                    statusEl.textContent = d.matched + ' product(s) matched · ' + d.cellsWithQty + ' quantity value(s) ready.';
                    applyBtn.disabled = d.matched === 0;
                }
            })
            .catch(function () { previewBtn.disabled = false; statusEl.textContent = 'Request failed.'; });
    }

    previewBtn.addEventListener('click', function () { run(base + 'Preview', false); });
    applyBtn.addEventListener('click', function () {
        if (!confirm('Overwrite on-hand stock for the matched products with the numbers in this file? This is recorded in stock history but changes live quantities.')) return;
        run(base + 'Apply', true);
    });
})();
</script>
}
