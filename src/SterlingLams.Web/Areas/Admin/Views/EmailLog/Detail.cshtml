@model SterlingLams.Web.Models.Domain.EmailLog
@{
    ViewData["Title"] = "Email";
    var preview = ViewBag.PreviewHtml as string;
}

<div class="flex items-center gap-2 mb-1">
    <a asp-action="Index" class="text-xs text-neutral-400 hover:text-neutral-700">← Email log</a>
</div>
<h1 class="text-lg font-medium text-neutral-800 mb-1">@Model.Subject</h1>
<p class="text-xs text-neutral-400 mb-5">Sent @Model.CreatedAt.ToLocalTime().ToString("dddd, dd MMM yyyy 'at' HH:mm") · via @Model.Channel</p>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-[10px] text-neutral-400 uppercase tracking-widest mb-1">Status</p>
        @if (Model.Sent)
        {
            <p class="text-lg font-light text-emerald-600">✓ Sent</p>
        }
        else
        {
            <p class="text-lg font-light text-red-600">✗ Failed</p>
        }
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-[10px] text-neutral-400 uppercase tracking-widest mb-1">Opened</p>
        @if (Model.OpenedAt.HasValue)
        {
            <p class="text-lg font-light text-blue-600">● Yes</p>
            <p class="text-[11px] text-neutral-400 mt-0.5">@Model.OpenedAt.Value.ToLocalTime().ToString("dd MMM HH:mm")@(Model.OpenCount > 1 ? $" · {Model.OpenCount}×" : "")</p>
        }
        else if (Model.Sent && Model.Channel == "smtp")
        {
            <p class="text-lg font-light text-neutral-400">—</p>
            <p class="text-[11px] text-neutral-400 mt-0.5">not registered</p>
        }
        else
        {
            <p class="text-lg font-light text-neutral-300">n/a</p>
        }
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4 md:col-span-2">
        <p class="text-[10px] text-neutral-400 uppercase tracking-widest mb-1">Recipient</p>
        <p class="text-sm text-neutral-800 break-all">@Model.ToEmail</p>
        @if (!string.IsNullOrWhiteSpace(Model.ToName)) { <p class="text-[11px] text-neutral-400 mt-0.5">@Model.ToName</p> }
    </div>
</div>

@if (!Model.Sent && !string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="mb-6 rounded-sm border border-red-200 bg-red-50 px-4 py-3">
        <p class="text-xs font-medium text-red-800 mb-1">Why it failed</p>
        <p class="text-sm text-red-700 break-words">@Model.Error</p>
    </div>
}

<div class="bg-white border border-neutral-100 rounded-sm overflow-hidden">
    <div class="px-4 py-2.5 bg-neutral-50 text-xs uppercase tracking-wide text-neutral-500 flex items-center justify-between">
        <span>What was sent</span>
        @if (!string.IsNullOrEmpty(preview))
        {
            <span class="text-[10px] normal-case tracking-normal text-neutral-400">Preview — images and the tracking pixel are not loaded here.</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(preview))
    {
        <iframe title="Email preview" sandbox="" style="width:100%;height:640px;border:0;background:#fff;" srcdoc="@preview"></iframe>
    }
    else
    {
        <div class="px-4 py-10 text-center text-sm text-neutral-400">
            The message body wasn't captured for this email (it was logged before body capture was added, or the send was skipped).
        </div>
    }
</div>
