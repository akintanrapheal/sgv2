@model SterlingLams.Web.Areas.Admin.Controllers.FinanceController.EndOfDayVm
@{
    ViewData["Title"] = "Finance — End of Day";
    string Money(decimal v) => "₦" + v.ToString("N0");
    var d = Model.Date.ToString("yyyy-MM-dd");
    var prev = Model.Date.AddDays(-1).ToString("yyyy-MM-dd");
    var next = Model.Date.AddDays(1).ToString("yyyy-MM-dd");
    var isToday = Model.Date.Date == SterlingLams.Web.Services.ReportCalendar.Today;
}

<partial name="_FinanceTabs" model="@("EndOfDay")" />

<div class="flex items-center justify-between mb-5">
    <p class="text-xs text-neutral-400">One day's close for each branch: sales, the split by payment method, refunds, expenses and net.</p>
    <button type="button" onclick="window.print()" class="no-print text-xs px-3 py-1.5 border border-neutral-300 rounded-sm text-neutral-600 hover:bg-neutral-50 transition-colors">🖨 Print</button>
</div>

<form method="get" class="no-print flex flex-wrap items-end gap-3 mb-6">
    <div>
        <label class="block text-xs text-neutral-500 mb-1">Day</label>
        <div class="flex items-center gap-1">
            <a asp-action="EndOfDay" asp-route-date="@prev" asp-route-storeId="@Model.StoreId" class="px-2 py-1.5 border border-neutral-200 rounded-sm text-sm text-neutral-600 hover:bg-neutral-50" title="Previous day">‹</a>
            <input type="date" name="date" value="@d" class="border border-neutral-200 rounded-sm px-3 py-1.5 text-sm" />
            <a asp-action="EndOfDay" asp-route-date="@next" asp-route-storeId="@Model.StoreId" class="px-2 py-1.5 border border-neutral-200 rounded-sm text-sm text-neutral-600 hover:bg-neutral-50" title="Next day">›</a>
        </div>
    </div>
    <div>
        <label class="block text-xs text-neutral-500 mb-1">Branch</label>
        <select name="storeId" class="border border-neutral-200 rounded-sm px-3 py-1.5 text-sm">
            <option value="">All branches</option>
            @foreach (var s in Model.Stores)
            {
                <option value="@s.Id" selected="@(Model.StoreId == s.Id)">@s.Name</option>
            }
        </select>
    </div>
    <button class="px-4 py-1.5 bg-neutral-900 text-white text-sm rounded-sm hover:bg-neutral-700 transition-colors">Apply</button>
</form>

<div class="mb-6">
    <h2 class="text-base font-medium text-neutral-800">End of Day — @Model.Date.ToString("dddd, dd MMMM yyyy")@(isToday ? " (today)" : "")</h2>
    <p class="text-xs text-neutral-400 mt-0.5">@(Model.StoreId.HasValue ? Model.Stores.FirstOrDefault(s => s.Id == Model.StoreId)?.Name ?? "Selected branch" : "All branches")</p>
</div>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-xs text-neutral-400">Orders</p><p class="text-xl font-light text-neutral-900 mt-1">@Model.Orders</p>
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-xs text-neutral-400">Gross sales</p><p class="text-xl font-light text-neutral-900 mt-1">@Money(Model.Gross)</p>
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-xs text-neutral-400">Refunds</p><p class="text-xl font-light text-red-600 mt-1">@Money(Model.Refunds)</p>
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-xs text-neutral-400">Expenses</p><p class="text-xl font-light text-neutral-900 mt-1">@Money(Model.Expenses)</p>
    </div>
    <div class="bg-white border border-neutral-100 rounded-sm p-4">
        <p class="text-xs text-neutral-400">Net</p><p class="text-xl font-light text-emerald-700 mt-1">@Money(Model.Net)</p>
    </div>
</div>

@if (!Model.Rows.Any())
{
    <div class="bg-white border border-neutral-100 rounded-sm p-10 text-center text-neutral-400 text-sm">
        No sales, refunds or expenses recorded for this day@(Model.StoreId.HasValue ? " at this branch" : "").
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    @foreach (var r in Model.Rows)
    {
        <div class="bg-white border border-neutral-100 rounded-sm overflow-hidden">
            <div class="px-4 py-3 bg-neutral-50 border-b border-neutral-100 flex items-baseline justify-between">
                <h3 class="text-sm font-semibold text-neutral-800">@r.Store</h3>
                <span class="text-xs text-neutral-400">@r.Orders order@(r.Orders == 1 ? "" : "s")</span>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
                    <div class="flex justify-between"><span class="text-neutral-500">Product sales</span><span class="text-neutral-800">@Money(r.Merchandise)</span></div>
                    <div class="flex justify-between"><span class="text-neutral-500">Delivery fees</span><span class="text-neutral-800">@Money(r.Delivery)</span></div>
                    <div class="flex justify-between"><span class="text-neutral-500">Discounts</span><span class="text-neutral-600">@Money(r.Discounts)</span></div>
                    <div class="flex justify-between"><span class="text-neutral-500">Loyalty</span><span class="text-neutral-600">@Money(r.Loyalty)</span></div>
                    <div class="flex justify-between"><span class="text-neutral-500">Gift cards</span><span class="text-neutral-600">@Money(r.GiftCards)</span></div>
                    <div class="flex justify-between"><span class="text-neutral-500">Expenses</span><span class="text-neutral-600">@Money(r.Expenses)</span></div>
                    <div class="flex justify-between"><span class="text-neutral-500">Refunds</span><span class="text-red-600">@(r.RefundCount > 0 ? "−" : "")@Money(r.Refunds)@(r.RefundCount > 0 ? $" ({r.RefundCount})" : "")</span></div>
                </div>

                <div class="mt-4 pt-3 border-t border-neutral-100 flex items-baseline justify-between">
                    <span class="text-xs uppercase tracking-wide text-neutral-400">Gross</span>
                    <span class="text-lg font-light text-neutral-900">@Money(r.Gross)</span>
                </div>
                <div class="flex items-baseline justify-between">
                    <span class="text-xs uppercase tracking-wide text-neutral-400">Net (after refunds)</span>
                    <span class="text-lg font-light text-emerald-700">@Money(r.Net)</span>
                </div>

                <div class="mt-4">
                    <p class="text-xs uppercase tracking-wide text-neutral-400 mb-1.5">Payment methods</p>
                    @if (!r.Methods.Any())
                    {
                        <p class="text-xs text-neutral-400">No tender recorded.</p>
                    }
                    else
                    {
                        <table class="w-full text-sm">
                            <tbody class="divide-y divide-neutral-100">
                                @foreach (var m in r.Methods)
                                {
                                    <tr>
                                        <td class="py-1.5 text-neutral-700">@m.Method</td>
                                        <td class="py-1.5 text-right text-neutral-400 text-xs">@m.Count</td>
                                        <td class="py-1.5 text-right text-neutral-800">@Money(m.Amount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                @if (r.Tills.Any())
                {
                    <div class="mt-4">
                        <p class="text-xs uppercase tracking-wide text-neutral-400 mb-1.5">By till</p>
                        <table class="w-full text-sm">
                            <tbody class="divide-y divide-neutral-100">
                                @foreach (var till in r.Tills)
                                {
                                    <tr>
                                        <td class="py-1.5 text-neutral-700">@till.Till</td>
                                        <td class="py-1.5 text-right text-neutral-400 text-xs">@till.Orders order@(till.Orders == 1 ? "" : "s")</td>
                                        <td class="py-1.5 text-right text-neutral-800">@Money(till.Gross)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @{ var ops = r.Ops; }
                <div class="mt-4 pt-3 border-t border-neutral-100">
                    <p class="text-xs uppercase tracking-wide text-neutral-400 mb-1.5">Operations</p>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
                        <div class="flex justify-between"><span class="text-neutral-500">POS sales</span><span class="text-neutral-800">@ops.PosSales</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Cash payments</span><span class="text-neutral-800">@ops.CashPayments</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Transfer payments</span><span class="text-neutral-800">@ops.TransferPayments</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Items sold (qty)</span><span class="text-neutral-800">@ops.ItemsSoldQty</span></div>
                        <div class="flex justify-between col-span-2"><span class="text-neutral-500">Items sold (amount)</span><span class="text-neutral-800">@Money(ops.ItemsSoldAmount)</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Website orders</span><span class="text-neutral-800">@ops.WebsiteOrders</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Website amount</span><span class="text-neutral-800">@Money(ops.WebsiteAmount)</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Packed website orders</span><span class="text-neutral-800">@ops.PackedWebsiteOrders</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Packed website amount</span><span class="text-neutral-800">@Money(ops.PackedWebsiteAmount)</span></div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-neutral-100">
                    <p class="text-xs uppercase tracking-wide text-neutral-400 mb-1.5">Cash drawer</p>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
                        <div class="flex justify-between"><span class="text-neutral-500">Opening cash balance</span><span class="text-neutral-800">@Money(ops.OpeningCash)</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Physical cash collected</span><span class="text-neutral-800">@Money(ops.PhysicalCashCollected)</span></div>
                        <div class="flex justify-between"><span class="text-neutral-500">Cash transfer (out)</span><span class="text-neutral-800">@Money(ops.CashTransfer)</span></div>
                        <div class="flex justify-between"><span class="text-neutral-700 font-medium">Closing cash balance</span><span class="text-neutral-900 font-medium">@Money(ops.ClosingCash)</span></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    @@media print {
        .no-print { display: none !important; }
        aside, nav, header { display: none !important; }
    }
</style>
