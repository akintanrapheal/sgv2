@model SterlingLams.Web.Areas.Admin.Controllers.FinanceController.RefundDetailVm
@using SterlingLams.Web.Models.Domain
@{
    ViewData["Title"] = $"Refund {Model.Refund.RefundNumber}";
    string Money(decimal v) => "₦" + v.ToString("N0");
    var r = Model.Refund;
    var o = Model.Order;
    (string cls, string label) badge = r.Status switch
    {
        RefundStatus.Approved => ("bg-emerald-50 text-emerald-700 border-emerald-200", "Approved"),
        RefundStatus.Rejected => ("bg-rose-50 text-rose-700 border-rose-200", "Rejected"),
        _ => ("bg-amber-50 text-amber-700 border-amber-200", "Pending approval")
    };
}

<div class="mb-4">
    <a asp-action="Refunds" class="text-xs text-neutral-400 hover:text-neutral-700">← Back to Refunds</a>
</div>

@if (TempData["Success"] != null)
{ <div class="mb-4 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-2.5">@TempData["Success"]</div> }
@if (TempData["Error"] != null)
{ <div class="mb-4 rounded-md bg-rose-50 border border-rose-200 text-rose-700 text-sm px-4 py-2.5">@TempData["Error"]</div> }

<div class="flex items-start justify-between gap-4 flex-wrap mb-6">
    <div>
        <div class="flex items-center gap-3 flex-wrap">
            <h1 class="text-xl font-semibold text-neutral-900">Refund @r.RefundNumber</h1>
            <span class="text-xs px-2 py-0.5 rounded-full border @badge.cls">@badge.label</span>
        </div>
        <p class="text-sm text-neutral-500 mt-1">
            Requested @r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") by <span class="text-neutral-700 font-medium">@Model.RequesterName</span>
            · against order <span class="text-neutral-700 font-medium">@o.OrderNumber</span>
        </p>
    </div>
    <div class="text-right">
        <div class="text-[11px] text-neutral-400 uppercase tracking-wide">Refund amount</div>
        <div class="text-2xl font-semibold text-rose-600">@Money(r.Amount)</div>
        <div class="text-xs text-neutral-500">@r.RefundMethod@(r.WasFullRefund ? " · full refund" : "")</div>
    </div>
</div>

<div class="grid lg:grid-cols-3 gap-4">
    <!-- Items + order (left, wide) -->
    <div class="lg:col-span-2 space-y-4">
        <div class="bg-white border border-neutral-200 rounded-md overflow-hidden">
            <div class="px-4 py-3 border-b border-neutral-100 text-sm font-semibold text-neutral-700">Items being refunded</div>
            <div class="divide-y divide-neutral-100">
                @foreach (var it in r.Items)
                {
                    var img = Model.Images.GetValueOrDefault(it.ProductId);
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="w-14 h-14 rounded border border-neutral-200 bg-neutral-50 overflow-hidden flex-shrink-0">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@Img.Cld(img, 112, 112)" alt="" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-neutral-300 text-[10px]">no image</div>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-neutral-800">@it.ProductName@(it.VariantName != null ? $" – {it.VariantName}" : "")</p>
                            <p class="text-xs text-neutral-500">@it.Quantity × @Money(it.UnitPrice)</p>
                        </div>
                        <div class="text-sm font-semibold text-neutral-800">@Money(it.LineTotal)</div>
                    </div>
                }
            </div>
            <div class="flex items-center justify-between px-4 py-3 border-t border-neutral-100 bg-neutral-50">
                <span class="text-sm text-neutral-500">Refund total</span>
                <span class="text-sm font-semibold text-rose-600">@Money(r.Amount)</span>
            </div>
        </div>

        <div class="bg-white border border-neutral-200 rounded-md p-4">
            <div class="text-sm font-semibold text-neutral-700 mb-3">Original order</div>
            <dl class="grid grid-cols-2 gap-y-2 text-sm">
                <dt class="text-neutral-500">Order number</dt>
                <dd class="text-right"><a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@o.Id" class="text-blue-600 hover:underline">@o.OrderNumber</a></dd>
                <dt class="text-neutral-500">Channel</dt><dd class="text-right text-neutral-800">@Model.Channel</dd>
                <dt class="text-neutral-500">Branch</dt><dd class="text-right text-neutral-800">@Model.StoreName.Replace("Sterlin Glams ", "")</dd>
                <dt class="text-neutral-500">Order total</dt><dd class="text-right text-neutral-800">@Money(o.Total)</dd>
                <dt class="text-neutral-500">Order date</dt><dd class="text-right text-neutral-800">@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </dl>
        </div>
    </div>

    <!-- Customer + decision + actions (right) -->
    <div class="space-y-4">
        <div class="bg-white border border-neutral-200 rounded-md p-4">
            <div class="text-sm font-semibold text-neutral-700 mb-3">Customer</div>
            <p class="text-sm text-neutral-800">@Model.CustomerName</p>
            @if (!string.IsNullOrEmpty(Model.CustomerPhone)) { <p class="text-xs text-neutral-500 mt-0.5">@Model.CustomerPhone</p> }
            @if (!string.IsNullOrEmpty(Model.CustomerEmail)) { <p class="text-xs text-neutral-500">@Model.CustomerEmail</p> }
            @if (Model.DeliveryAddress != null)
            {
                <div class="text-xs text-neutral-500 mt-2 leading-relaxed">
                    @Model.DeliveryAddress.Line1@(string.IsNullOrEmpty(Model.DeliveryAddress.Line2) ? "" : ", " + Model.DeliveryAddress.Line2)<br />
                    @Model.DeliveryAddress.City, @Model.DeliveryAddress.State
                </div>
            }
        </div>

        <div class="bg-white border border-neutral-200 rounded-md p-4">
            <div class="text-sm font-semibold text-neutral-700 mb-3">Request</div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-sm">
                <dt class="text-neutral-500">Raised by</dt><dd class="text-neutral-800">@Model.RequesterName</dd>
                <dt class="text-neutral-500">Reason</dt><dd class="text-neutral-800">@(string.IsNullOrWhiteSpace(r.Reason) ? "—" : r.Reason)</dd>
                <dt class="text-neutral-500">Restock</dt><dd class="text-neutral-800">@(r.RestockRequested ? "Requested" : "No")</dd>
            </dl>
        </div>

        @if (r.Status != RefundStatus.PendingApproval)
        {
            <div class="bg-white border border-neutral-200 rounded-md p-4">
                <div class="text-sm font-semibold text-neutral-700 mb-3">Decision</div>
                <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-sm">
                    <dt class="text-neutral-500">Outcome</dt><dd><span class="text-xs px-2 py-0.5 rounded-full border @badge.cls">@badge.label</span></dd>
                    <dt class="text-neutral-500">By</dt><dd class="text-neutral-800">@(Model.ApproverName ?? "—")</dd>
                    <dt class="text-neutral-500">When</dt><dd class="text-neutral-800">@(r.DecisionAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "—")</dd>
                    @if (!string.IsNullOrWhiteSpace(r.DecisionNote))
                    { <dt class="text-neutral-500">Note</dt><dd class="text-neutral-800">@r.DecisionNote</dd> }
                </dl>
            </div>
        }

        @if (Model.CanManage && r.Status == RefundStatus.PendingApproval)
        {
            <div class="bg-white border border-neutral-200 rounded-md p-4 space-y-4">
                <div class="text-sm font-semibold text-neutral-700">Decision</div>
                <form asp-action="DetailApproveRefund" method="post" onsubmit="return confirm('Approve this refund and pay it out?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <label class="block text-[11px] text-neutral-500 mb-1">Note (optional)</label>
                    <input type="text" name="note" class="w-full border border-neutral-300 rounded px-2.5 py-1.5 text-sm mb-2" placeholder="Optional note" />
                    <button type="submit" class="w-full bg-emerald-600 text-white text-sm rounded py-2 hover:bg-emerald-700 transition-colors">Approve &amp; pay out</button>
                </form>
                <form asp-action="DetailRejectRefund" method="post" onsubmit="return confirm('Reject this refund? Nothing will be paid out.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <label class="block text-[11px] text-neutral-500 mb-1">Reason for rejecting <span class="text-rose-500">*</span></label>
                    <textarea name="reason" required rows="2" class="w-full border border-neutral-300 rounded px-2.5 py-1.5 text-sm mb-2" placeholder="Why is this refund being rejected?"></textarea>
                    <button type="submit" class="w-full border border-neutral-300 text-neutral-700 text-sm rounded py-2 hover:bg-neutral-50 transition-colors">Reject refund</button>
                </form>
            </div>
        }
    </div>
</div>
