@model SterlingLams.Web.Areas.Admin.Controllers.FinanceController.TxnVm
@{
    ViewData["Title"] = "Finance — Transactions";
    string Money(decimal v) => (v < 0 ? "-₦" : "₦") + Math.Abs(v).ToString("N0");
    string F = Model.From.ToString("yyyy-MM-dd");
    string T = Model.To.ToString("yyyy-MM-dd");
    // Keep every current filter when building a link, overriding whatever is passed in.
    Func<object, Dictionary<string, string>> rp = ov =>
    {
        var d = new Dictionary<string, string>
        {
            ["from"] = F, ["to"] = T, ["storeId"] = Model.StoreId?.ToString() ?? "",
            ["channel"] = Model.Channel ?? "", ["type"] = Model.Type ?? "", ["q"] = Model.Q ?? "",
            ["sort"] = Model.Sort ?? "", ["dir"] = Model.Dir ?? "", ["page"] = Model.Page.ToString()
        };
        foreach (var p in ov.GetType().GetProperties()) d[p.Name] = p.GetValue(ov)?.ToString() ?? "";
        return d;
    };
    // A sortable column header toggles asc/desc and resets to page 1, keeping the other filters.
    Func<string, Dictionary<string, string>> sortData = key =>
    {
        var nd = (Model.Sort == key && Model.Dir == "asc") ? "desc" : "asc";
        return rp(new { sort = key, dir = nd, page = 1 });
    };
    string caret(string key) => Model.Sort != key ? "<span class=\"text-neutral-300\">↕</span>"
        : (Model.Dir == "asc" ? "<span class=\"text-neutral-700\">↑</span>" : "<span class=\"text-neutral-700\">↓</span>");
    string typeBadge(string tp) => tp switch
    {
        "Sale" => "bg-emerald-50 text-emerald-700",
        "Refund" => "bg-rose-50 text-rose-700",
        "Expense" => "bg-amber-50 text-amber-700",
        "Cash" => "bg-sky-50 text-sky-700",
        _ => "bg-neutral-100 text-neutral-600"
    };
}

<partial name="_FinanceTabs" model="@("Transactions")" />

@if (TempData["Success"] != null)
{ <div class="mb-4 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm px-4 py-2.5">@TempData["Success"]</div> }
@if (TempData["Error"] != null)
{ <div class="mb-4 rounded-md bg-rose-50 border border-rose-200 text-rose-700 text-sm px-4 py-2.5">@TempData["Error"]</div> }

<!-- Filter bar -->
<form method="get" asp-action="Transactions" class="bg-white border border-neutral-200 rounded-md p-4 mb-4">
    <div class="flex flex-wrap items-end gap-3">
        <div>
            <label class="block text-[11px] text-neutral-500 mb-1">From</label>
            <input type="date" name="from" value="@F" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm" />
        </div>
        <div>
            <label class="block text-[11px] text-neutral-500 mb-1">To</label>
            <input type="date" name="to" value="@T" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm" />
        </div>
        <div>
            <label class="block text-[11px] text-neutral-500 mb-1">Store</label>
            <select name="storeId" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm bg-white">
                <option value="">All stores</option>
                @foreach (var s in Model.Stores)
                { <option value="@s.Id" selected="@(Model.StoreId == s.Id)">@s.Name.Replace("Sterlin Glams ", "")</option> }
            </select>
        </div>
        <div>
            <label class="block text-[11px] text-neutral-500 mb-1">Channel</label>
            <select name="channel" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm bg-white">
                <option value="">All</option>
                <option value="Pos" selected="@(Model.Channel == "Pos")">In-store (POS)</option>
                <option value="Online" selected="@(Model.Channel == "Online")">Online</option>
            </select>
        </div>
        <div>
            <label class="block text-[11px] text-neutral-500 mb-1">Type</label>
            <select name="type" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm bg-white">
                <option value="">All types</option>
                @foreach (var tp in new[] { "Sale", "Refund", "Expense", "Cash" })
                { <option value="@tp" selected="@(Model.Type == tp)">@tp</option> }
            </select>
        </div>
        <div class="flex-1 min-w-[180px]">
            <label class="block text-[11px] text-neutral-500 mb-1">Search (ref, customer, staff, note)</label>
            <input type="text" name="q" value="@Model.Q" placeholder="e.g. SG-1042, John, salary…" class="w-full border border-neutral-300 rounded px-2.5 py-1.5 text-sm" />
        </div>
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="dir" value="@Model.Dir" />
        <button type="submit" class="px-4 py-2 bg-neutral-900 text-white text-sm rounded hover:bg-neutral-700 transition-colors">Apply</button>
        <a class="px-4 py-2 border border-neutral-300 text-neutral-700 text-sm rounded hover:bg-neutral-50 transition-colors"
           asp-action="Transactions" asp-all-route-data='rp(new { format = "csv" })'>Export CSV</a>
    </div>
    <div class="flex flex-wrap gap-2 mt-3">
        @foreach (var p in Model.Presets)
        {
            <a class="text-[11px] px-2.5 py-1 rounded-full border @(F == p.From && T == p.To ? "border-neutral-800 text-neutral-800" : "border-neutral-200 text-neutral-500 hover:border-neutral-400")"
               asp-action="Transactions" asp-all-route-data="rp(new { from = p.From, to = p.To, page = 1 })">@p.Label</a>
        }
    </div>
</form>

<!-- Summary chips -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
    <div class="bg-white border border-neutral-200 rounded-md p-3">
        <div class="text-[11px] text-neutral-500">Money in</div>
        <div class="text-lg font-semibold text-emerald-600">@Money(Model.SumIn)</div>
    </div>
    <div class="bg-white border border-neutral-200 rounded-md p-3">
        <div class="text-[11px] text-neutral-500">Money out</div>
        <div class="text-lg font-semibold text-rose-600">@Money(Model.SumOut)</div>
    </div>
    <div class="bg-white border border-neutral-200 rounded-md p-3">
        <div class="text-[11px] text-neutral-500">Net</div>
        <div class="text-lg font-semibold @(Model.Net < 0 ? "text-rose-600" : "text-neutral-900")">@Money(Model.Net)</div>
    </div>
    <div class="bg-white border border-neutral-200 rounded-md p-3">
        <div class="text-[11px] text-neutral-500">Transactions</div>
        <div class="text-lg font-semibold text-neutral-900">@Model.Total.ToString("N0")</div>
        @if (Model.PendingRefunds > 0)
        { <div class="text-[11px] text-amber-600 mt-0.5">@Model.PendingRefunds pending refund@(Model.PendingRefunds == 1 ? "" : "s")</div> }
    </div>
</div>

@if (Model.CanManage)
{
    <details class="bg-white border border-neutral-200 rounded-md mb-4">
        <summary class="cursor-pointer select-none px-4 py-2.5 text-sm text-neutral-700 hover:bg-neutral-50">+ Record an expense</summary>
        <form method="post" asp-action="TxnAddExpense" class="p-4 border-t border-neutral-100 flex flex-wrap items-end gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="from" value="@F" /><input type="hidden" name="to" value="@T" />
            <input type="hidden" name="storeId" value="@Model.StoreId" /><input type="hidden" name="channel" value="@Model.Channel" />
            <input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="q" value="@Model.Q" />
            <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" />
            <div>
                <label class="block text-[11px] text-neutral-500 mb-1">Category</label>
                <select name="category" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm bg-white">
                    @foreach (var c in Model.ExpenseCategories) { <option value="@c">@c</option> }
                </select>
            </div>
            <div>
                <label class="block text-[11px] text-neutral-500 mb-1">Amount (₦)</label>
                <input type="number" name="amount" step="0.01" min="0" required class="w-32 border border-neutral-300 rounded px-2.5 py-1.5 text-sm" />
            </div>
            <div>
                <label class="block text-[11px] text-neutral-500 mb-1">Date</label>
                <input type="date" name="occurredOn" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm" />
            </div>
            <div>
                <label class="block text-[11px] text-neutral-500 mb-1">Store (optional)</label>
                <select name="expenseStoreId" class="border border-neutral-300 rounded px-2.5 py-1.5 text-sm bg-white">
                    <option value="">— None —</option>
                    @foreach (var s in Model.Stores) { <option value="@s.Id">@s.Name.Replace("Sterlin Glams ", "")</option> }
                </select>
            </div>
            <div class="flex-1 min-w-[160px]">
                <label class="block text-[11px] text-neutral-500 mb-1">Note</label>
                <input type="text" name="note" class="w-full border border-neutral-300 rounded px-2.5 py-1.5 text-sm" />
            </div>
            <button type="submit" class="px-4 py-2 bg-emerald-600 text-white text-sm rounded hover:bg-emerald-700 transition-colors">Save expense</button>
        </form>
    </details>
}

<!-- Ledger -->
<div class="bg-white border border-neutral-200 rounded-md overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[900px]">
            <thead class="bg-neutral-50 text-neutral-500 text-xs">
                <tr>
                    <th class="text-left font-semibold px-4 py-3"><a asp-action="Transactions" asp-all-route-data='sortData("date")' class="hover:text-neutral-800">Date @Html.Raw(caret("date"))</a></th>
                    <th class="text-left font-semibold px-4 py-3"><a asp-action="Transactions" asp-all-route-data='sortData("type")' class="hover:text-neutral-800">Type @Html.Raw(caret("type"))</a></th>
                    <th class="text-left font-semibold px-4 py-3"><a asp-action="Transactions" asp-all-route-data='sortData("store")' class="hover:text-neutral-800">Store @Html.Raw(caret("store"))</a></th>
                    <th class="text-left font-semibold px-4 py-3">Reference</th>
                    <th class="text-left font-semibold px-4 py-3">Party</th>
                    <th class="text-left font-semibold px-4 py-3">Method</th>
                    <th class="text-right font-semibold px-4 py-3"><a asp-action="Transactions" asp-all-route-data='sortData("amount")' class="hover:text-neutral-800">Amount @Html.Raw(caret("amount"))</a></th>
                    <th class="px-4 py-3 w-24"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8" class="px-4 py-16 text-center text-neutral-400">No transactions match these filters.</td></tr>
                }
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.Status == "Pending" ? "bg-amber-50/40" : "")">
                        <td class="px-4 py-2.5 whitespace-nowrap text-neutral-600 text-xs">@r.When.ToLocalTime().ToString("dd MMM yy, HH:mm")</td>
                        <td class="px-4 py-2.5 whitespace-nowrap">
                            <span class="text-[11px] px-1.5 py-0.5 rounded @typeBadge(r.Type)">@r.Type</span>
                            @if (r.Status == "Pending") { <span class="text-[11px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 ml-1">pending</span> }
                        </td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-neutral-700 text-xs">@r.Store.Replace("Sterlin Glams ", "")@(string.IsNullOrEmpty(r.Channel) ? "" : $" · {r.Channel}")</td>
                        <td class="px-4 py-2.5 whitespace-nowrap font-mono text-xs text-neutral-500">@r.Reference</td>
                        <td class="px-4 py-2.5 text-neutral-700 text-xs">@r.Party@if (!string.IsNullOrEmpty(r.Detail)) { <span class="text-neutral-400"> · @r.Detail</span> }</td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-neutral-500 text-xs">@r.Method</td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-right font-semibold @(r.Amount < 0 ? "text-rose-600" : "text-emerald-600")">@Money(r.Amount)</td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-right">
                            @if (r.ActionKind == "order" && r.ActionId != null)
                            {
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@r.ActionId" class="text-xs text-blue-600 hover:underline">Open</a>
                            }
                            else if (r.ActionKind == "refund-pending" && Model.CanManage)
                            {
                                <div class="flex items-center justify-end gap-1.5">
                                    <form method="post" asp-action="TxnApproveRefund" class="inline" onsubmit="return confirm('Approve this refund and pay it out?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.ActionId" />
                                        <input type="hidden" name="from" value="@F" /><input type="hidden" name="to" value="@T" />
                                        <input type="hidden" name="storeId" value="@Model.StoreId" /><input type="hidden" name="channel" value="@Model.Channel" />
                                        <input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="q" value="@Model.Q" />
                                        <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="page" value="@Model.Page" />
                                        <button type="submit" class="text-xs px-2 py-1 rounded bg-emerald-600 text-white hover:bg-emerald-700">Approve</button>
                                    </form>
                                    <form method="post" asp-action="TxnRejectRefund" class="inline" onsubmit="return confirm('Reject this refund? Nothing will be paid out.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.ActionId" />
                                        <input type="hidden" name="from" value="@F" /><input type="hidden" name="to" value="@T" />
                                        <input type="hidden" name="storeId" value="@Model.StoreId" /><input type="hidden" name="channel" value="@Model.Channel" />
                                        <input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="q" value="@Model.Q" />
                                        <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="page" value="@Model.Page" />
                                        <button type="submit" class="text-xs px-2 py-1 rounded border border-neutral-300 text-neutral-600 hover:bg-neutral-50">Reject</button>
                                    </form>
                                </div>
                            }
                            else if (r.ActionKind == "expense" && Model.CanManage)
                            {
                                <form method="post" asp-action="TxnDeleteExpense" class="inline" onsubmit="return confirm('Delete this expense?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.ActionId" />
                                    <input type="hidden" name="from" value="@F" /><input type="hidden" name="to" value="@T" />
                                    <input type="hidden" name="storeId" value="@Model.StoreId" /><input type="hidden" name="channel" value="@Model.Channel" />
                                    <input type="hidden" name="type" value="@Model.Type" /><input type="hidden" name="q" value="@Model.Q" />
                                    <input type="hidden" name="sort" value="@Model.Sort" /><input type="hidden" name="dir" value="@Model.Dir" /><input type="hidden" name="page" value="@Model.Page" />
                                    <button type="submit" class="text-xs text-rose-500 hover:text-rose-700">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between px-4 py-3 border-t border-neutral-100 text-xs text-neutral-500">
            <span>Page @Model.Page of @Model.TotalPages · @Model.Total.ToString("N0") transaction(s)</span>
            <div class="flex gap-2">
                @if (Model.Page > 1)
                { <a class="px-3 py-1.5 border border-neutral-200 rounded hover:border-neutral-400" asp-action="Transactions" asp-all-route-data="rp(new { page = Model.Page - 1 })">← Prev</a> }
                @if (Model.Page < Model.TotalPages)
                { <a class="px-3 py-1.5 border border-neutral-200 rounded hover:border-neutral-400" asp-action="Transactions" asp-all-route-data="rp(new { page = Model.Page + 1 })">Next →</a> }
            </div>
        </div>
    }
</div>
