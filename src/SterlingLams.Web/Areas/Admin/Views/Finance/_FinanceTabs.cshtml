@model string
@{
    // Finance navigation now lives in the left sidebar (a standalone "Finance" section that expands to
    // all its tabs) — so this partial just renders the page heading for the current view.
    var labels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Overview"] = "Overview", ["Transactions"] = "Transactions", ["Cash"] = "Cash-up",
        ["Refunds"] = "Refunds", ["Leakage"] = "Leakage", ["Liabilities"] = "Customer Points",
        ["Receivables"] = "Receivables", ["Settlement"] = "Settlement", ["Customers"] = "Customers",
        ["Profit"] = "Profit", ["Logistics"] = "Logistics P&L",
    };
    var current = labels.TryGetValue(Model ?? "", out var l) ? l : "Overview";
}
<div class="flex items-baseline gap-2 mb-6 border-b border-neutral-200 pb-4">
    <h1 class="text-lg font-medium text-neutral-800">Finance</h1>
    <span class="text-neutral-300">/</span>
    <span class="text-lg font-light text-neutral-500">@current</span>
</div>
