{
  "name": "sterlinglams-web",
  "version": "1.0.0",
  "description": "Sterlin Glams luxury jewellery e-commerce",
  "author": "Dev Rapheal",
  "scripts": {
    "build:css": "tailwindcss -i ./src/SterlingLams.Web/wwwroot/css/input.css -o ./src/SterlingLams.Web/wwwroot/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/SterlingLams.Web/wwwroot/css/input.css -o ./src/SterlingLams.Web/wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38"
  },
  "comment:overrides": "Force patched transitive build-tool deps (dev-only, CSS build). postcss-selector-parser<6.1.3 = AST-recursion DoS; browserslist<4.28.7 = poisoned browserslist-stats.json prototype write/crash.",
  "overrides": {
    "postcss-selector-parser": "^6.1.3",
    "browserslist": "^4.28.7"
  }
}
